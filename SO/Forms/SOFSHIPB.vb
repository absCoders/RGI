#Region "ABS Standard Routines" ' These Routines should be found in all Forms which Launch from the Menu.

    Private Sub Form_Load(ByVal sender As Object, ByVal e As System.EventArgs) Handles Me.Load

        Check_InquiryMode()

        clsTACENCRY = New TAC.ASCENCRY
        Dim rowASTPARMP As DataRow = ASCDATA1.GetDataRow("Select * from ASTPARMP WHERE AS_PARM_KEY = 'Z'")
        If rowASTPARMP Is Nothing OrElse Not rowASTPARMP.Table.Columns.Contains("AS_PARM_USE_ENCRYPTION") OrElse rowASTPARMP.Item("AS_PARM_USE_ENCRYPTION") & String.Empty <> "1" Then
            clsTACENCRY.UseEncryption = False
        Else
            clsTACENCRY.UseEncryption = True
        End If

        SOTSHIP0 = ASCMAIN1.Temp_Table("Select SHIP_BOL_NO from SOTSHIP1 where ROWNUM < 1")
        ASCDATA1.ExecuteSQL("Alter Table " & SOTSHIP0 & " Add Primary Key (SHIP_BOL_NO)")

        SOTPICKL = ASCMAIN1.Temp_Table("Select PICK_NO from SOTPICK1 where ROWNUM < 1")
        ASCDATA1.ExecuteSQL("Alter Table " & SOTPICKL & " Add Primary Key (PICK_NO)")

        If MaintenanceMode Then
            ASCMAIN1.sql = "Select SHIP_BOL_NO, '1' SEL, '1' EDI856, '1' SHIP_CART_REQD from SOTSHIP1 where ROWNUM < 1"
            SOTSHIPX = ASCMAIN1.Temp_Table
            ASCDATA1.ExecuteSQL("Alter Table " & SOTSHIPX & " Add Primary Key (SHIP_BOL_NO)")
            ASCDATA1.ExecuteSQL("Alter Table " & SOTSHIPX & " Add SHIP_CHGREQ_NO VARCHAR2(10)")
            ASCDATA1.ExecuteSQL("Alter Table " & SOTSHIPX & " Add CUST_CODE VARCHAR2(10)")
        End If

        Get_PARM("SOTPARM1")
        Get_PARM("GLTPARM1")
        Get_PARM("ASTPARM1")
        Get_PARM("ICTPARM1")
        Get_PARM("WHTPARM1")
        Get_PARM("ECTPARM1")

        tblTATSTATE = ASCDATA1.GetDataTable("SELECT * FROM TATSTATE", "TATSTATE") ' WHERE region_code is not null

        If ROWs("WHTPARM1").Table.Columns.Contains("WH_PARM_DEFAULT_PKG_CODE") Then
            If ROWs("WHTPARM1").Item("WH_PARM_DEFAULT_PKG_CODE") & String.Empty <> String.Empty Then
                defaultPKG_CODE = ROWs("WHTPARM1").Item("WH_PARM_DEFAULT_PKG_CODE") & String.Empty
            End If
        End If

        ImageDirectory = ROWs("ICTPARM1").Item("IC_PARM_STYLE_IMG_DIR") & String.Empty
        If ImageDirectory.Length > 0 Then
            If Not My.Computer.FileSystem.DirectoryExists(ImageDirectory) Then
                ImageDirectory = String.Empty
            ElseIf Not ImageDirectory.EndsWith("\") Then
                ImageDirectory &= "\"
            End If
        End If

        Dim SO_PARM_WEB_INVOICES As String = (ROWs("SOTPARM1").Item("SO_PARM_WEB_INVOICES") & String.Empty).ToString.Trim
        If SO_PARM_WEB_INVOICES.Length > 0 AndAlso Not My.Computer.FileSystem.DirectoryExists(SO_PARM_WEB_INVOICES) Then
            SO_PARM_WEB_INVOICES = String.Empty
        End If
        If SO_PARM_WEB_INVOICES.Length > 0 AndAlso Not SO_PARM_WEB_INVOICES.EndsWith("\") Then
            SO_PARM_WEB_INVOICES &= "\"
        End If

        With dst
            ASCMAIN1.sql = "Select * from " & SOTPICKL
            Create_TDA(.Tables.Add, SOTPICKL, "**", 0, True, "", 1)

            If ASCMAIN1.CLIENT = "NYA" Then
                sqlSOTSHIPX = "Select SOTSHIP1.*" _
                     & ",SOTORDR0.CUST_CODE,SOTORDR0.ORDR_SHIP_DATE,SOTORDR0.ORDR_CANCEL_DATE,SOTORDR0.ORDR_CUST_PO, ARTCUST1.CUST_NAME, 0 SHIP_VALUE, 0 TOT_CUST_PT, 0 VALUE_CUST_PT" _
                     & " from SOTSHIP1,SOTORDR0,ICTWHSE1,ARTCUST1" _
                     & " where SOTORDR0.ORDR_GROUP_NO = SOTSHIP1.ORDR_GROUP_NO" _
                     & " and SOTSHIP1.WHSE_CODE = ICTWHSE1.WHSE_CODE" _
                     & " and SOTORDR0.CUST_CODE = ARTCUST1.CUST_CODE" _
                     & IIf(ASCMAIN1.USER_CODES = "CA", " and SOTSHIP1.WHSE_CODE IN (" & TAC.TACMAIN1.NyaCanadaWhseQueryString & ")", IIf(InquiryMode, " and SOTSHIP1.WHSE_CODE IN ('02', " & TAC.TACMAIN1.NyaCanadaWhseQueryString & ")", " and SOTSHIP1.WHSE_CODE = '02'"))
                ' 02/27/2018 lifted restriction
                ' & " and SOTSHIP1.WHSE_CODE = '02'"
            ElseIf ConsolidatedPOProcessing Then
                sqlSOTSHIPX = "Select SOTSHIP1.*" _
                     & ",SOTORDR0.CUST_CODE,SOTORDR0.ORDR_SHIP_DATE,SOTORDR0.ORDR_CANCEL_DATE,SOTORDR0.ORDR_CUST_PO, ARTCUST1.CUST_NAME, 0 SHIP_VALUE, 0 TOT_CUST_PT, 0 VALUE_CUST_PT" _
                     & " from SOTSHIP1,SOTORDR0,ICTWHSE1,ARTCUST1,EDT850T1" _
                     & " where SOTORDR0.ORDR_GROUP_NO = SOTSHIP1.ORDR_GROUP_NO" _
                     & " and SOTSHIP1.WHSE_CODE = ICTWHSE1.WHSE_CODE" _
                     & " and SOTORDR0.CUST_CODE = ARTCUST1.CUST_CODE" _
                     & " and SOTORDR0.EDI_DOC_SEQ_NO = EDT850T1.EDI_DOC_SEQ_NO" _
                     & sqlEDI_CONS_NO
            ElseIf ASCMAIN1.CLIENT = "VAN" Then
                sqlSOTSHIPX = "Select SOTSHIP1.*" _
                     & ",SOTORDR0.CUST_CODE,SOTORDR0.ORDR_SHIP_DATE,SOTORDR0.ORDR_CANCEL_DATE,SOTORDR0.ORDR_CUST_PO, ARTCUST1.CUST_NAME, 0 SHIP_VALUE, 0 TOT_CUST_PT, 0 VALUE_CUST_PT" _
                     & " from SOTSHIP1,SOTORDR0,ICTWHSE1,ARTCUST1" _
                     & " where SOTORDR0.ORDR_GROUP_NO = SOTSHIP1.ORDR_GROUP_NO" _
                     & " and SOTSHIP1.WHSE_CODE = ICTWHSE1.WHSE_CODE" _
                     & " and SOTORDR0.CUST_CODE = ARTCUST1.CUST_CODE"
            ElseIf ASCMAIN1.CLIENT = "RGI" Then
                ' Note RGI is using SOTORDR1 needs to change back to SOTORDR0 later, needed for change request from Leo
                sqlSOTSHIPX = "Select DISTINCT SOTSHIP1.*" _
                     & ",SOTORDR0.CUST_CODE, SOTORDR0.ORDR_SHIP_DATE, SOTORDR0.ORDR_CANCEL_DATE, SOTORDR0.ORDR_CUST_PO, ARTCUST1.CUST_NAME" _
                     & ", DECODE(SOTORDR0.EDI_DOC_SEQ_NO, NULL, nvl(SOTSHIPB.SHIP_TO_NAME,SOTORDR5.CUST_NAME),    DECODE(SOTORDR1.ECOM_CODE, NULL, NULL, nvl(SOTSHIPB.SHIP_TO_NAME,SOTORDR5.CUST_NAME))) SHIP_TO_NAME" _
                     & ", DECODE(SOTORDR0.EDI_DOC_SEQ_NO, NULL, nvl(SOTSHIPB.SHIP_TO_ADDR1,SOTORDR5.CUST_ADDR1),  DECODE(SOTORDR1.ECOM_CODE, NULL, NULL, nvl(SOTSHIPB.SHIP_TO_ADDR1,SOTORDR5.CUST_ADDR1))) SHIP_TO_ADDR1" _
                     & ", DECODE(SOTORDR0.EDI_DOC_SEQ_NO, NULL, nvl(SOTSHIPB.SHIP_TO_CITY,SOTORDR5.CUST_CITY),    DECODE(SOTORDR1.ECOM_CODE, NULL, NULL, nvl(SOTSHIPB.SHIP_TO_CITY,SOTORDR5.CUST_CITY))) SHIP_TO_CITY" _
                     & ", DECODE(SOTORDR0.EDI_DOC_SEQ_NO, NULL, nvl(SOTSHIPB.SHIP_TO_STATE,SOTORDR5.CUST_STATE),  DECODE(SOTORDR1.ECOM_CODE, NULL, NULL, nvl(SOTSHIPB.SHIP_TO_STATE,SOTORDR5.CUST_STATE))) SHIP_TO_STATE" _
                     & ", DECODE(SOTORDR0.EDI_DOC_SEQ_NO, NULL, nvl(SOTSHIPB.SHIP_TO_ZIP_CODE,SOTORDR5.CUST_ZIP_CODE), DECODE(SOTORDR1.ECOM_CODE, NULL, NULL, nvl(SOTSHIPB.SHIP_TO_ZIP_CODE,SOTORDR5.CUST_ZIP_CODE))) SHIP_TO_ZIP_CODE" _
                     & ", NVL(SOTSHIPB.SHIP_FREIGHT, 0) SHIP_FREIGHT" _
                     & ", NVL(SOTSHIPB.SHIP_FREIGHT_EST, 0) SHIP_FREIGHT_EST_B, 0 SHIP_VALUE, 0 TOT_CUST_PT, 0 VALUE_CUST_PT, SOTORDR0.ORDR_TYPE_CODE, EDT945T1.EDI_DOC_SEQ_NO" _
                     & " from SOTSHIP1, SOTORDR0, SOTORDR1, ICTWHSE1, ARTCUST1, SOTSHIPB, SOTORDR5, EDT945T1" _
                     & " where SOTORDR0.ORDR_GROUP_NO = SOTSHIP1.ORDR_GROUP_NO" _
                     & " And SOTORDR0.ORDR_GROUP_NO = SOTORDR1.ORDR_GROUP_NO" _
                     & " And SOTSHIP1.WHSE_CODE = ICTWHSE1.WHSE_CODE" _
                     & " And SOTORDR0.CUST_CODE = ARTCUST1.CUST_CODE" _
                     & " And SOTORDR5.ORDR_NO = SOTORDR1.ORDR_NO" _
                     & " And SOTORDR5.CUST_ADDR_TYPE = 'ST'" _
                     & " And SOTSHIPB.BOL_NO (+) = SOTSHIP1.BILL_OF_LADING_NO
                        AND SOTSHIP1.SHIP_BOL_NO = EDT945T1.EDI_SHIPMENT_ID (+)"

                If Not InquiryMode AndAlso ASCMAIN1.CLIENT = "RGI" Then
                    sqlSOTSHIPX &= " AND ICTWHSE1.LP_CODE IS NULL"
                End If

                If Not InquiryMode Then
                    If isEcommProcessing Then
                        sqlSOTSHIPX &= " and SOTORDR1.ECOM_CODE IS NOT NULL"
                        sqlSOTSHIPX &= ecommSql
                    Else
                        sqlSOTSHIPX &= " and SOTORDR1.ECOM_CODE IS NULL"
                    End If
                End If
            Else
                sqlSOTSHIPX = "Select SOTSHIP1.*" _
                     & ",SOTORDR0.CUST_CODE,SOTORDR0.ORDR_SHIP_DATE,SOTORDR0.ORDR_CANCEL_DATE,SOTORDR0.ORDR_CUST_PO, ARTCUST1.CUST_NAME, 0 SHIP_VALUE, 0 TOT_CUST_PT, 0 VALUE_CUST_PT" _
                     & " from SOTSHIP1,SOTORDR0,ICTWHSE1,ARTCUST1" _
                     & " where SOTORDR0.ORDR_GROUP_NO = SOTSHIP1.ORDR_GROUP_NO" _
                     & " And SOTSHIP1.WHSE_CODE = ICTWHSE1.WHSE_CODE" _
                     & " And SOTORDR0.CUST_CODE = ARTCUST1.CUST_CODE"
            End If

            If Not InquiryMode Then
                sqlSOTSHIPX &= "" _
                    & " and SOTSHIP1.SHIP_STATUS = 'P'"

                If Not isEcommProcessing Then
                    sqlSOTSHIPX &= " and SOTSHIP1.SHIP_PICK_PRINTED is Not Null"
                End If

                If ASCMAIN1.CLIENT = "RGI" Then
                    sqlSOTSHIPX &= " and ICTWHSE1.WHSE_CODE <> 'CG'"
                End If
            Else
                ' Requested by Rita 5/22/2017
                If ASCMAIN1.CLIENT = "RGI" Then
                    sqlSOTSHIPX &= " and ICTWHSE1.WHSE_CODE in ('ZZ', 'MS', 'NY','NC')"
                End If

            End If

            ' 01/28/2020. Need to merge ordes when they have separate BOL
            ' Left PARM3 to avoid breaking code.
            Select Case ASCMAIN1.CLIENT
                Case "RGI"
                    sqlSOTSHIPX_BOL = sqlSOTSHIPX _
                        & " and SOTSHIP1.SHIP_STATUS = 'P'" & vbCrLf _
                        & " and SOTSHIP1.WHSE_CODE = :PARM1" _
                        & " and SOTORDR1.CUST_CODE = :PARM2"
                    Create_TDA(.Tables.Add, "SOTSHIPX_BOL", sqlSOTSHIPX_BOL, 0, False, "VV", 1)

                Case "VAN"
                    sqlSOTSHIPX_BOL = sqlSOTSHIPX _
                        & " and SOTSHIP1.SHIP_STATUS = 'P'" & vbCrLf _
                        & " and SOTSHIP1.WHSE_CODE = :PARM1" _
                        & " and SOTORDR0.CUST_CODE = :PARM2"
                    Create_TDA(.Tables.Add, "SOTSHIPX_BOL", sqlSOTSHIPX_BOL, 0, False, "VV", 1)

                Case Else
                    sqlSOTSHIPX_BOL = sqlSOTSHIPX _
                       & " and SOTSHIP1.SHIP_STATUS = 'P'" & vbCrLf _
                       & " and SOTSHIP1.WHSE_CODE = :PARM1" _
                       & " and SOTORDR0.CUST_CODE = :PARM2" _
                       & " and NVL(SOTSHIP1.BILL_OF_LADING_NO, :PARM3) = :PARM3"
                    Create_TDA(.Tables.Add, "SOTSHIPX_BOL", sqlSOTSHIPX_BOL, 0, False, "VVV", 1)

            End Select
            dst.Tables("SOTSHIPX_BOL").Columns.Add("Selected", GetType(System.String))

            Create_TDA(.Tables.Add, "SOTSHIPX", sqlSOTSHIPX, 0, False, "", 1)
            Create_TDA(.Tables.Add("SOTINVHX"), "SOTINVH1", "*", , False)

            Create_Relation("SOTSHIPX", "SOTINVHX", "SHIP_BOL_NO", "SHIP_BOL_NO")
            dst.Tables("SOTSHIPX").Columns.Add("INV_FREIGHT", GetType(System.Decimal), "SUM(CHILD(SOTSHIPX_SOTINVHX).INV_FREIGHT)")
            dst.Tables("SOTSHIPX").Columns.Add("INV_SALES", GetType(System.Decimal), "SUM(CHILD(SOTSHIPX_SOTINVHX).INV_SALES)")

            Create_TDA(.Tables.Add("SOTPICK1_X"), "SOTPICK1", "*", -1, False)
            Create_Relation("SOTSHIPX", "SOTPICK1_X", "SHIP_BOL_NO", "SHIP_BOL_NO")
            dst.Tables("SOTSHIPX").Columns.Add("PICK_PICKER", GetType(System.String), "MAX(CHILD(SOTSHIPX_SOTPICK1_X).PICK_PICKER)")
            dst.Tables("SOTSHIPX").Columns.Add("PICK_PACKED", GetType(System.String), "MAX(CHILD(SOTSHIPX_SOTPICK1_X).PICK_PACKED)")

            Create_TDA(.Tables.Add, "SOTORDR1", "*")
            .Tables("SOTORDR1").Columns.Add("LOGO_HEADER_LOCATION", GetType(System.String))
            .Tables("SOTORDR1").Columns.Add("LOGO_FOOTER_LOCATION", GetType(System.String))
            .Tables("SOTORDR1").Columns.Add("MESSAGE_FOOTER", GetType(System.String))

            Create_TDA(.Tables.Add, "SOTORDR2", "*")
            .Tables("SOTORDR2").Columns.Add("UPC_CODE", GetType(System.String))
            .Tables("SOTORDR2").Columns.Add("ORDR_UNIT_PRICE_ORIG", GetType(System.Decimal))

            sqlDuty = "SELECT ICTSTYL1.DUTY_RATE_CODE, SOTORDR2.STYLE_CODE, ICTSTYL1.STYLE_DESC,
                            SUM(SOTPICK2.PICK_QTY_CONF) PICK_QTY_CONF, 
                            MIN(NVL(ICTSTYLD.WEIGHT, 0)) WEIGHT_LBS,
                            SUM(NVL(SOTORDR2.ORDR_UNIT_PRICE, 0) * NVL(SOTPICK2.PICK_QTY_CONF, 0)) VALUE_PER_HTS_CODE
                            FROM SOTORDR2, SOTPICK2, ICTSTYL1, 
                            (SELECT STYLE_CODE, WEIGHT FROM ICTSTYLD WHERE PACK_CODE = 'ITM') ICTSTYLD
                            WHERE SOTPICK2.ORDR_NO = SOTORDR2.ORDR_NO 
                            AND SOTPICK2.ORDR_LNO = SOTORDR2.ORDR_LNO
                            AND SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE (+)
                            AND SOTORDR2.STYLE_CODE = ICTSTYLD.STYLE_CODE (+)
                            AND SOTPICK2.PICK_NO IN ('**')
                            GROUP BY ICTSTYL1.DUTY_RATE_CODE, SOTORDR2.STYLE_CODE, ICTSTYL1.STYLE_DESC"
            Create_TDA(.Tables.Add, "SOTORDR2_DUTY", sqlDuty, 0, False, "", 0)
            With .Tables("SOTORDR2_DUTY")
                .Columns.Add("EXTENDED_WEIGHT", GetType(System.Decimal), "PICK_QTY_CONF * WEIGHT_LBS")
            End With

            ASCMAIN1.sql = "SELECT ICTSTYL1.DUTY_RATE_CODE,
                            SOTPICK2.PICK_QTY_CONF, 
                            NVL(ICTSTYLD.WEIGHT, 0) WEIGHT_LBS,
                            NVL(ICTSTYLD.WEIGHT, 0) WEIGHT_KGS,
                            0 VALUE_PER_HTS_CODE
                            FROM SOTORDR2, SOTPICK2, ICTSTYL1, 
                            (SELECT STYLE_CODE, WEIGHT FROM ICTSTYLD WHERE PACK_CODE = 'ITM') ICTSTYLD
                            WHERE SOTPICK2.ORDR_NO = SOTORDR2.ORDR_NO 
                            AND SOTPICK2.ORDR_LNO = SOTORDR2.ORDR_LNO
                            AND SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE (+)
                            AND SOTORDR2.STYLE_CODE = ICTSTYLD.STYLE_CODE (+)
                            AND SOTPICK2.PICK_NO IN ('**')"
            Create_TDA(.Tables.Add, "SOTORDR2_DUTY_HTS", ASCMAIN1.sql, 0, False, "", 0)

            Create_TDA(.Tables.Add, "EDT850T1", "*")
            dst.Tables("EDT850T1").Columns.Add("HEADER_MESSAGE", GetType(System.String))
            dst.Tables("EDT850T1").Columns.Add("SID_SKU", GetType(System.String))
            dst.Tables("EDT850T1").Columns.Add("RETURN_LABEL_FEE", GetType(System.Decimal))
            dst.Tables("EDT850T1").Columns.Add("LABEL_TRACKING_NO", GetType(System.String))
            dst.Tables("EDT850T1").Columns.Add("LABEL_CONF_NO", GetType(System.String))
