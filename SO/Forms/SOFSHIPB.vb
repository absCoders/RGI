#Region "gdWHTSHPCA"
    Private Sub grdWHTSHPCA_AfterRowUpdate(sender As Object, e As UltraWinGrid.RowEventArgs) Handles grdWHTSHPCA.AfterRowUpdate

        Dim SERVICE_INDEX As Int16 = -1
        For Each dRow As DataRow In dst.Tables("WHTSHPC4").Select("SELECTED = '1'", "", DataViewRowState.CurrentRows)
            SERVICE_INDEX = dRow.Item("SERVICE_INDEX")
            Exit For
        Next

        If SERVICE_INDEX = -1 Then
            Exit Sub
        End If

        Dim prohibited As String = String.Empty
        For Each dRow As DataRow In dst.Tables("WHTSHPCA").Select("SELECTED = '1' and SERVICE_INDEX = " & SERVICE_INDEX, "", DataViewRowState.CurrentRows)
            prohibited &= "," & dRow.Item("PROHIBITED") & ","
        Next

        Dim rowFilter As String = String.Empty
        For Each prob As String In Split(prohibited, ",")
            prob = prob.Trim
            If prob.Length = 0 Then Continue For
            rowFilter &= " and ADDON_TYPE <> '" & prob & "' "
        Next
        If rowFilter.Length > 0 Then
            rowFilter = rowFilter.Substring(4).Trim
            rowFilter = " and (" & rowFilter & ")"
        End If

        Dim view As New DataView(dst.Tables("WHTSHPCA"))
        view.RowFilter = "SERVICE_INDEX = " & SERVICE_INDEX & rowFilter
        grdWHTSHPCA.DataSource = view

    End Sub

#End Region

