    Private Function AddCarton() As String
        Return AddCarton("", 0, 0, 0, 0, defaultPKG_CODE)
    End Function

    Private Function AddCarton(ByVal PICK_NO As String, ByVal PKG_H As Decimal, ByVal PKG_W As Decimal, ByVal PKG_L As Decimal, ByVal PKG_Weight As Decimal, ByVal PKG_CODE As String) As String

        Dim copyFrom As DataRow = Nothing
        Dim providedPickTicket As Boolean = PICK_NO.Length > 0

        If Not providedPickTicket Then
            If grdSOTPICK1.ActiveRow Is Nothing Then
                MessageBox.Show("You must select a pick ticket.", "Add Carton", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Return String.Empty
            Else
                PICK_NO = grdSOTPICK1.ActiveRow.Cells("PICK_NO").Value
                If ASCMAIN1.CLIENT = "RGI" Then
                    If dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'").Length > 0 Then
                        If MessageBox.Show("Do you want to copy the Weight and Dimensions from the last carton?", "Copy", MessageBoxButtons.YesNo, MessageBoxIcon.Question) = Windows.Forms.DialogResult.Yes Then
                            copyFrom = dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'", "CART_SEQ DESC")(0)
                        End If
                    End If
                End If
            End If
        End If

        Dim rowSOTCART1 As DataRow = dst.Tables("SOTCART1").NewRow
        Dim SO_PARM_UPC_VENDOR_ID As String = ROWs("SOTPARM1").Item("SO_PARM_UPC_VENDOR_ID")

        ' Walmart Change 03/20/2019
        If isEcommProcessing Then
            If ASCMAIN1.CLIENT = "RGI" AndAlso CUST_CODE = RegencyWalmartCustCode Then
                If dst.Tables("EDT850T1").Select("EDI_MERCH_TYPE = 'S2S'", "").Length > 0 Then
                    Dim rowEDT850T1 As DataRow = dst.Tables("EDT850T1").Select("EDI_MERCH_TYPE = 'S2S'", "")(0)
                    'EDT850T1.EDI_SUPPLIER_NO=056339
                    Dim EDI_SUPPLIER_NO As String = rowEDT850T1.Item("EDI_SUPPLIER_NO") & String.Empty
                    If EDI_SUPPLIER_NO > 0 Then
                        SO_PARM_UPC_VENDOR_ID = EDI_SUPPLIER_NO
                    End If
                End If
            End If
        End If

        Dim CART_NO As String = TAC.SOCMAIN1.UPC(Me, ASCMAIN1.Next_Control_No("SOTCART1.CART_NO"), "0000" & SO_PARM_UPC_VENDOR_ID)

        rowSOTCART1.Item("CART_NO") = CART_NO ' "NEW" & Format(CART_NO_new, "0000000")
        rowSOTCART1.Item("PICK_NO") = PICK_NO
        dst.Tables("SOTCART1").Rows.Add(rowSOTCART1)

        rowSOTCART1.Item("CART_TOTAL_UNITS") = 0
        rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = 0
        rowSOTCART1.Item("CART_TOTAL_WGT_CALC") = 0
        rowSOTCART1.Item("CART_TRACKING_NO") = String.Empty
        rowSOTCART1.Item("PKG_H") = PKG_H
        rowSOTCART1.Item("PKG_W") = PKG_W
        rowSOTCART1.Item("PKG_L") = PKG_L
        'rowSOTCART1.Item("CART_TYPE") = String.Empty

        Dim SHIP_BOL_NO As String = dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'")(0).Item("SHIP_BOL_NO") & String.Empty

        rowSOTCART1.Item("SHIP_BOL_NO") = SHIP_BOL_NO
        rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE

        Dim rowSOTSVIA1 As DataRow = dst.Tables("SOTSVIA1").Rows.Find(Absx1.txtFor("SHIP_VIA_CODE").Text)
        If rowSOTSVIA1 IsNot Nothing Then
            Refresh_Refs(rowSOTSVIA1.Item("CARRIER_CODE") & String.Empty, CART_NO)
        End If

        Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(PKG_CODE)
        If rowWHTPKGM1 Is Nothing Then
            rowWHTPKGM1 = dst.Tables("WHTPKGM1").Rows.Find(defaultPKG_CODE)
        End If

        If rowWHTPKGM1 IsNot Nothing Then
            rowSOTCART1.Item("PKG_CODE") = PKG_CODE
            rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
            rowSOTCART1.Item("PKG_L") = rowWHTPKGM1.Item("PKG_L")
            rowSOTCART1.Item("PKG_W") = rowWHTPKGM1.Item("PKG_W")
            rowSOTCART1.Item("PKG_H") = rowWHTPKGM1.Item("PKG_H")
        Else
            rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE
            rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
        End If

        If ASCMAIN1.CLIENT = "RGI" Then
            If rowSOTCART1.Item("REFERENCE1") & String.Empty = String.Empty Then
                rowSOTCART1.Item("REFERENCE1") = Val(rowSOTCART1.Item("PICK_NO") & String.Empty)
                rowSOTCART1.Item("REFERENCE2") = rowSOTCART1.Item("CART_NO") & String.Empty
            End If
        End If

        ' Sequence number is used to print the UPS Fedex labels in order. 
        ' Not sequential by Pick Ticket since we can have multiple pick tickets on one shipment.
        Dim CART_SEQ As Int32 = Val(dst.Tables("SOTCART1").Compute("MAX(CART_SEQ)", "") & String.Empty) + 1
        rowSOTCART1.Item("CART_SEQ") = CART_SEQ

        If copyFrom IsNot Nothing Then
            rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = copyFrom.Item("CART_TOTAL_WGT_ACTUAL")
            rowSOTCART1.Item("PKG_H") = copyFrom.Item("PKG_H")
            rowSOTCART1.Item("PKG_W") = copyFrom.Item("PKG_W")
            rowSOTCART1.Item("PKG_L") = copyFrom.Item("PKG_L")
            rowSOTCART1.Item("PKG_CODE") = copyFrom.Item("PKG_CODE")
            rowSOTCART1.Item("PACKAGING_TYPE") = copyFrom.Item("PACKAGING_TYPE")
        End If

        If PKG_H > 0 AndAlso PKG_W > 0 AndAlso PKG_L > 0 Then
            ' Sort the Values to meet Shipping instructions
            Dim dimList As New List(Of Decimal)
            dimList.Add(PKG_L)
            dimList.Add(PKG_W)
            dimList.Add(PKG_H)
            dimList.Sort()
            PKG_L = dimList(2)
            PKG_W = dimList(1)
            PKG_H = dimList(0)

            rowSOTCART1.Item("PKG_H") = PKG_H
            rowSOTCART1.Item("PKG_W") = PKG_W
            rowSOTCART1.Item("PKG_L") = PKG_L
        End If

        If PKG_Weight > 0 Then
            rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = PKG_Weight
        End If

        If Not providedPickTicket Then
            grdSOTPICK1.ActiveRow.Cells("PICK_CNT_CARTONS").Value = dst.Tables("SOTCART1").Select("PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'").Length
        Else
            dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'", "")(0).Item("PICK_CNT_CARTONS") = dst.Tables("SOTCART1").Select("PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'").Length
        End If


        Dim pickWeight As Decimal = Val(grdSOTPICK1.ActiveRow.Cells("PICK_TOTAL_WGT").Value & String.Empty)
        Dim totalCartWeight As Decimal = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & PICK_NO & "'") & String.Empty)

        If ASCMAIN1.CLIENT = "NYA" Then
            If totalCartWeight > pickWeight Then
                grdSOTPICK1.ActiveRow.Cells("PICK_TOTAL_WGT").Value = totalCartWeight
                grdSOTPICK1.UpdateData()
            End If
        Else
            grdSOTPICK1.ActiveRow.Cells("PICK_TOTAL_WGT").Value = totalCartWeight
            grdSOTPICK1.UpdateData()
        End If

        SetupgrdSOTCART1_SHIP()

        SetupgrdSOTCART1_SHIP()

