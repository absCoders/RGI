                    ASCMAIN1.sql = sqlSOTSHIPX_LP _
                    & " and SOTORDR1.CUST_CODE = '" & CUST_CODE & "'"
                Else
                    ASCMAIN1.sql = sqlSOTSHIPX_LP _
                    & " and SOTORDR0.CUST_CODE = '" & CUST_CODE & "'"
                End If

                dst.Tables("SOTPICK1_X").Rows.Clear()

                Fill_Records("SOTSHIPX", "", , ASCMAIN1.sql)
