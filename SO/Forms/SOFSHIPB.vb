                .Address3 = txtCUST_ADDR3.Text

                .City = txtCUST_CITY.Text
                .State = txtCUST_STATE.Text
                .ZipCode = txtCUST_ZIP_CODE.Text

                .CountryCode = txtCUST_COUNTRY.Text.ToUpper.Replace(".", "")
                If .CountryCode.Trim.Length = 0 Then .CountryCode = "US"
                If .CountryCode = "USA" Then .CountryCode = "US"

                .Company = txtCUST_NAME.Text
                .Phone = mdtCUST_PHONE.Text

                If .Phone.Trim.Length = 0 Then
                    .Phone = clsShip.Sender.Phone
                End If

                If .Phone.Trim.Length = 0 Then
                    .Phone = "1234567890"
                End If

                .IsResidental = optAddressType.Value = "R"
                .IsPOBox = optAddressType.Value = "P"
            End With

            clsShip.ShipmentSpecialServices = 0
            If chkSaturday.Checked Then
                clsShip.ShipmentSpecialServices = clsShip.ShipmentSpecialServices Or &H10000000L
            End If

            If chkSignature.Checked Then
                clsShip.SignatureRequired = True
            Else
                clsShip.SignatureRequired = False
            End If

            Select Case rowSOTCARR1.Item("USPS_PARTNER") & String.Empty
                Case "1"
                    clsShip.USPSPostageProvider = WHCSHIP1.USPSPostageProviders.Endicia
                Case "2"
                    clsShip.USPSPostageProvider = WHCSHIP1.USPSPostageProviders.StampsCom
                Case "3"
                    clsShip.USPSPostageProvider = WHCSHIP1.USPSPostageProviders.PitneyBowes
                Case Else
                    Return Nothing
            End Select


            If clsShip.USPSPostageProvider = WHCSHIP1.USPSPostageProviders.PitneyBowes Then

                Dim addressValidationResponse As TAC.WHCSHIP1.PitneyBowesAddress = clsShip.GetPitneyBowesAddresses(clsShip.Recipient)

                If addressValidationResponse IsNot Nothing Then
                    ' ask the user if they want to update the address.
                    Dim addressLine1 As String = String.Empty
                    Dim addressLine2 As String = String.Empty
                    Dim addressLine3 As String = String.Empty

                    ReDim Preserve addressValidationResponse.addressLines(3)
                    addressLine1 = addressValidationResponse.addressLines(0) & String.Empty
                    addressLine2 = addressValidationResponse.addressLines(1) & String.Empty
                    addressLine3 = addressValidationResponse.addressLines(2) & String.Empty

                    Dim city As String = addressValidationResponse.cityTown & String.Empty
                    Dim company = addressValidationResponse.company & String.Empty
                    Dim countryCode = addressValidationResponse.countryCode & String.Empty
                    Dim name = addressValidationResponse.name & String.Empty
                    'Dim phone = addressValidationResponse.phone  & String.Empty
                    Dim phone = addressValidationResponse.postalCode & String.Empty
                    Dim residential = addressValidationResponse.residential & String.Empty
                    Dim stateProvince = addressValidationResponse.stateProvince & String.Empty
                    Dim postalCode = addressValidationResponse.postalCode & String.Empty

                    ' Compare for differences
                    Dim promptToUpdateAddress As Boolean = True
                    If addressLine1 = txtCUST_ADDR1.Text Then
                        If addressLine2 = txtCUST_ADDR2.Text Then
                            If addressLine3 = txtCUST_ADDR3.Text Then
                                If city = txtCUST_CITY.Text Then
                                    If stateProvince = txtCUST_STATE.Text Then
                                        If postalCode = txtCUST_ZIP_CODE.Text Then
                                            If clsShip.Recipient.IsResidental.ToString.ToUpper = addressValidationResponse.residential.ToString.ToUpper Then
                                                promptToUpdateAddress = False

                                            End If
                                        End If
                                    End If
                                End If
                            End If
                        End If
                    End If

                    If promptToUpdateAddress Then
                        Dim pMsg As String = "Pitney Bowes suggets the following address. Do you want to update the shipping address to us this address?" & Environment.NewLine & Environment.NewLine
                        If company.length > 0 Then
                            pMsg &= company & Environment.NewLine
                        End If

                        If name.length > 0 Then
                            pMsg &= name & Environment.NewLine
                        End If

                        If addressLine1.Length > 0 Then
                            pMsg &= addressLine1 & Environment.NewLine
                        End If

                        If addressLine2.Length > 0 Then
                            pMsg &= addressLine2 & Environment.NewLine
                        End If

                        If addressLine2.Length > 0 Then
                            pMsg &= addressLine2 & Environment.NewLine
                        End If

                        pMsg &= city & ", " & stateProvince & "  " & postalCode & Environment.NewLine & Environment.NewLine

                        pMsg &= "Residential: " & addressValidationResponse.residential.ToString.ToUpper

                        If MessageBox.Show(pMsg, "Address Correction", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.Yes Then
                            txtCUST_ADDR1.Text = addressLine1
                            txtCUST_ADDR2.Text = addressLine2
                            txtCUST_ADDR3.Text = addressLine3

                            txtCUST_CITY.Text = city
                            txtCUST_STATE.Text = stateProvince
                            txtCUST_ZIP_CODE.Text = postalCode

                            With clsShip.Recipient
                                .Address1 = txtCUST_ADDR1.Text
                                .Address2 = txtCUST_ADDR2.Text
                                .Address3 = txtCUST_ADDR3.Text

                                .City = txtCUST_CITY.Text
                                .State = txtCUST_STATE.Text
                                .ZipCode = txtCUST_ZIP_CODE.Text

                                If addressValidationResponse.residential.ToString.ToUpper = "TRUE" Then
                                    optAddressType.Value = "R"
                                Else
                                    optAddressType.Value = "O"
                                End If

                                .IsResidental = optAddressType.Value = "R"

                            End With
                        End If
                    End If
                Else
                    MessageBox.Show("Error in Address Validation: " & clsShip.LastError, "USPS Address Ver", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Return Nothing
                End If
                addressValidationResponse = Nothing
            End If

            ' Only uses this for address validation 
            If isEcommProcessing Then
                Return Nothing
            End If

            rList = clsShip.GetUSPSRatesList

            If clsShip.LastError.Length > 0 Then
                MessageBox.Show("USPS Error: " & clsShip.LastError, "USPS Rates Error")
            End If

            If rList Is Nothing Then
                ReDim rList(1)
            End If

            Return rList

        Catch ex As Exception
            MessageBox.Show("The following error occurred getting USPS Rates: " & ex.Message, "Get USPS Rates", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Return Nothing
        End Try

    End Function


#End Region

