    Public Overrides Sub tlb_BeforeToolDropdown(ByVal sender As Object, ByVal e As Infragistics.Win.UltraWinToolbars.BeforeToolDropdownEventArgs)
        MyBase.tlb_BeforeToolDropdown(sender, e)

        If e.Tool.OwnerIsMenu OrElse e.SourceControl Is Nothing OrElse e.SourceControl.Name = "" Then
            e.Cancel = True
            Exit Sub
        End If

        Dim grd As UltraWinGrid.UltraGrid = GRDs(Mid(e.SourceControl.Name, 4))
        If grd Is Nothing Then
            e.Cancel = True
            Exit Sub
        End If

        Dim tlb_pop As UltraWinToolbars.PopupMenuTool = DirectCast(e.Tool, UltraWinToolbars.PopupMenuTool)
        Dim tlb_sbt As UltraWinToolbars.StateButtonTool = Nothing
        Dim tlb_btn As UltraWinToolbars.ButtonTool = Nothing

        Select Case grd.Name
            Case "grdSOTPICK2", "grdSOTPICK2_SC"
                tlb_pop.Tools("Permit Price Change").SharedProps.Visible = Not InquiryMode _
                    AndAlso (EntryMode = "E" OrElse EntryMode = "N") _
                    AndAlso dst.Tables("SOTORDR1").Select("ISNULL(EDI_DOC_SEQ_NO, '') <> ''").Length = 0 _
                    AndAlso dst.Tables("SOTORDR1").Select("CURR_CODE <> 'USD'").Length = 0
            Case "grdSOTPICK1"
                tlb_pop.Tools("Select All").SharedProps.Visible = Not InquiryMode And (EntryMode = "E" OrElse EntryMode = "N") And Not MaintenanceMode
                tlb_pop.Tools("De-Select All").SharedProps.Visible = Not InquiryMode And (EntryMode = "E" OrElse EntryMode = "N") And Not MaintenanceMode

            Case "grdSOTSHIPS"
                tlb_pop.Tools("Show Filter").SharedProps.Visible = Not ScreenMode
                tlb_pop.Tools("Show GroupBox").SharedProps.Visible = Not ScreenMode
                tlb_pop.Tools("Show Pins").SharedProps.Visible = Not ScreenMode

                tlb_pop.Tools("Add BOL to Master").SharedProps.Visible = ScreenMode AndAlso Not InquiryMode AndAlso Not MaintenanceMode
                tlb_pop.Tools("Remove BOL from Master").SharedProps.Visible = ScreenMode AndAlso Not InquiryMode AndAlso Not MaintenanceMode
                tlb_pop.Tools("Refresh Avaliable BOLs").SharedProps.Visible = ScreenMode AndAlso Not InquiryMode AndAlso Not MaintenanceMode

                tlb_pop.Tools("Add BOL to Master").SharedProps.Enabled = grd.ActiveRow.Cells("SEL").Value & String.Empty <> "1"
                tlb_pop.Tools("Remove BOL from Master").SharedProps.Enabled = grd.ActiveRow.Cells("SEL").Value & String.Empty = "1"

            Case "grdSOTSHIPX_BOL"
                shipBolNoList.Clear()
                If InquiryMode Then
                    tlb_pop.Tools("Add Shipment to BOL").SharedProps.Visible = False
                    tlb_pop.Tools("Remove Shipment from BOL").SharedProps.Visible = False
                Else

                    tlb_pop.Tools("Add Shipment to BOL").SharedProps.Enabled = False
                    tlb_pop.Tools("Remove Shipment from BOL").SharedProps.Enabled = False

                    For Each grdRow As Infragistics.Win.UltraWinGrid.UltraGridRow In grd.Selected.Rows
                        shipBolNoList.Add(grdRow.Cells("SHIP_BOL_NO").Value)
                        If grd.ActiveRow.Cells("SELECTED").Value & String.Empty <> "1" Then
                            tlb_pop.Tools("Add Shipment to BOL").SharedProps.Enabled = True
                        End If

                        If grd.ActiveRow.Cells("SELECTED").Value & String.Empty = "1" Then
                            tlb_pop.Tools("Remove Shipment from BOL").SharedProps.Enabled = True
                        End If
                    Next
                End If

            Case "grdSOTSHIPX"
                If InquiryMode Then
                    tlb_pop.Tools("Email Invoice").SharedProps.Enabled = False
                    tlb_pop.Tools("Track Shipment").SharedProps.Enabled = False
                End If

        End Select

        If grd.ActiveRow Is Nothing OrElse grd.ActiveRow.IsAddRow Then
            '  e.Cancel = True
        Else
            'If grd.Selected.Rows.Count = 0 Then
            '    e.Cancel = True
            'End If

            Select Case e.SourceControl.Name
                Case "grdSOTPICK1"
                    tlb_btn = DirectCast(tlb_pop.Tools("Propagate Value"), UltraWinToolbars.ButtonTool)
                    If Not (EntryMode = "E" OrElse EntryMode = "N") OrElse grd.ActiveCell Is Nothing OrElse Not New String() {"PICK_CNT_CARTONS", "PICK_TOTAL_WGT", "PICK_FREIGHT", "BILL_OF_LADING_NO", "ORDR_INV_COMMENT"}.Contains(grd.ActiveCell.Column.Key) Then
                        tlb_btn.SharedProps.Visible = False
                    Else
                        tlb_btn.SharedProps.Visible = True
                        tlb_btn.SharedProps.Caption = "Propagate Values for " & grd.ActiveCell.Column.Header.Caption
                        tlb_btn.Tag = grd.ActiveCell.Column.Key
                    End If

                    For Each ToolKey As String In New String() {"Hide Details"} ' {"Select All", "De-Select All", "Hide Details"}
                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Visible = (EntryMode = "E" OrElse EntryMode = "N")
                    Next

                    Dim PICK_NO As String = grd.ActiveRow.Cells("PICK_NO").Value & String.Empty
                    For Each ToolKey As String In New String() {"Cancel Pick Ticket"}
                        Dim display As Boolean = (ConsolidatedPOProcessing OrElse VandaleVersion2Billing OrElse (ASCMAIN1.USER_ID = "edz" AndAlso ASCMAIN1.Running_in_VS)) _
                            AndAlso dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "' AND PICK_STATUS = 'P' AND PICK_STATUS_ORIG = 'P'").Length > 0

                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Visible = display
                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Enabled = display
                    Next

                    For Each ToolKey As String In New String() {"Restore Pick Ticket"}
                        Dim display As Boolean = (ConsolidatedPOProcessing OrElse VandaleVersion2Billing OrElse (ASCMAIN1.USER_ID = "edz" AndAlso ASCMAIN1.Running_in_VS)) _
                            AndAlso dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "' AND PICK_STATUS = 'C'  AND PICK_STATUS_ORIG = 'P'").Length > 0

                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Visible = display
                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Enabled = display
                    Next


                    Dim CUST_CODE As String = grd.ActiveRow.Cells("CUST_CODE").Value & String.Empty
                    Dim CUST_STORE_NO As String = grd.ActiveRow.Cells("CUST_STORE_NO").Value & String.Empty

                    For Each ToolKey As String In New String() {"Cancel Customer/Ship To Pick Tickets"}
                        Dim display As Boolean = (ConsolidatedPOProcessing OrElse VandaleVersion2Billing OrElse (ASCMAIN1.USER_ID = "edz" AndAlso ASCMAIN1.Running_in_VS)) _
                            AndAlso dst.Tables("SOTPICK1").Select("CUST_CODE = '" & CUST_CODE & "' AND CUST_STORE_NO = '" & CUST_STORE_NO & "' AND PICK_STATUS = 'P'  AND PICK_STATUS_ORIG = 'P'").Length > 1

                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Visible = display
                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Enabled = display
                    Next

                    For Each ToolKey As String In New String() {"Restore Customer/Ship To Pick Tickets"}
                        Dim display As Boolean = (ConsolidatedPOProcessing OrElse VandaleVersion2Billing OrElse (ASCMAIN1.USER_ID = "edz" AndAlso ASCMAIN1.Running_in_VS)) _
                            AndAlso dst.Tables("SOTPICK1").Select("CUST_CODE = '" & CUST_CODE & "' AND CUST_STORE_NO = '" & CUST_STORE_NO & "' AND PICK_STATUS = 'C'  AND PICK_STATUS_ORIG = 'P'").Length > 1

                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Visible = display
                        DirectCast(tlb_pop.Tools(ToolKey), UltraWinToolbars.ButtonTool).SharedProps.Enabled = display
                    Next

                Case "grdSOTPICK2_SC"

                    Dim STYLE_CODE As String = grdSOTPICK2_SC.ActiveRow.Cells("STYLE_CODE").Value & String.Empty
                    Dim COLOR_CODE As String = grdSOTPICK2_SC.ActiveRow.Cells("COLOR_CODE").Value & String.Empty

                    If tlb_pop.Tools.Exists("Copy Qty Confirmed to all Pick Tickets") Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Copy Qty Confirmed to all Pick Tickets"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = Not InquiryMode And Not BOL_isP2L
                    End If

                    If tlb_pop.Tools.Exists("Cancel Qty") Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Cancel Qty"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = Not InquiryMode And Not BOL_isP2L
                        tlb_btn.SharedProps.Caption = $"Cancel Qty for {STYLE_CODE}/{COLOR_CODE}"
                    End If

                    If tlb_pop.Tools.Exists("Back Order Qty") Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Back Order Qty"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = Not InquiryMode And Not BOL_isP2L And ASCMAIN1.Running_in_VS
                        tlb_btn.SharedProps.Caption = $"Back Order Qty for {STYLE_CODE}/{COLOR_CODE}"
                    End If

                    If tlb_pop.Tools.Exists("Restore Qty") Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Restore Qty"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = Not InquiryMode And Not BOL_isP2L
                        tlb_btn.SharedProps.Caption = $"Restore Qty for {STYLE_CODE}/{COLOR_CODE}"
                    End If

                Case "grdSOTSHIPX"
                    If tlb_pop.Tools.Exists("Print Manifest") Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Print Manifest"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Visible = optStatus.Value = "C"
                    End If

                    If InquiryMode Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Track Shipment"), UltraWinToolbars.ButtonTool)
                        If grd.ActiveRow.Band.Key = grd.DisplayLayout.Bands(0).Key Then
                            Dim rowSOTSVIA1 As DataRow = dst.Tables("SOTSVIA1").Rows.Find(grd.ActiveRow.Cells("SHIP_VIA_CODE").Value & String.Empty)
                            If rowSOTSVIA1 IsNot Nothing _
                                AndAlso rowSOTSVIA1.Item("CARRIER_URL_TRACKING") & String.Empty <> String.Empty _
                                AndAlso grd.ActiveRow.Cells("SHIP_REF").Value & String.Empty <> String.Empty Then
                                tlb_btn.SharedProps.Enabled = True
                            End If
                        End If

                        tlb_btn = DirectCast(tlb_pop.Tools("Email Invoice"), UltraWinToolbars.ButtonTool)
                        'If grd.ActiveRow.Band.Key = grd.DisplayLayout.Bands(1).Key Then
                        tlb_btn.SharedProps.Enabled = dst.Tables("SOTINVHX").Select("SHIP_BOL_NO = '" & grd.ActiveRow.Cells("SHIP_BOL_NO").Text & "'").Length > 0
                        'End If
                    End If

                    If isEcommProcessing Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Print Consolidated Pick Slip"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = grdSOTSHIPX.Selected.Rows.Count > 0
                    End If

                Case "grdSOTCART1"
                    If grd.ActiveCell Is Nothing Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Pick Ticket Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = False

                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Shipment Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = False
                    Else
                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Pick Ticket Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = (grd.ActiveCell.Column.Key = "PKG_CODE" OrElse grd.ActiveCell.Column.Key = "CART_TOTAL_WGT_ACTUAL") AndAlso Not InquiryMode
                        If ASCMAIN1.CLIENT = "VAN" Then
                            tlb_btn.SharedProps.Enabled = Not InquiryMode
                        End If

                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Shipment Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = (grd.ActiveCell.Column.Key = "PKG_CODE" OrElse grd.ActiveCell.Column.Key = "CART_TOTAL_WGT_ACTUAL") AndAlso Not InquiryMode
                        If ASCMAIN1.CLIENT = "VAN" Then
                            tlb_btn.SharedProps.Enabled = Not InquiryMode
                        End If
                    End If

                    If grd.Selected.Rows.Count <= 1 Then
                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Selected Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = False
                    Else
                        tlb_btn = DirectCast(tlb_pop.Tools("Copy to Selected Cartons"), UltraWinToolbars.ButtonTool)
                        tlb_btn.SharedProps.Enabled = Not InquiryMode
                    End If

                    tlb_btn = DirectCast(tlb_pop.Tools("Cancel Carton Contents"), UltraWinToolbars.ButtonTool)
                    tlb_btn.SharedProps.Enabled = Not InquiryMode AndAlso grd.Selected.Rows.Count = 1

            End Select
        End If
    End Sub

    Public Overrides Sub tlb_ToolClick(ByVal sender As System.Object, ByVal e As Infragistics.Win.UltraWinToolbars.ToolClickEventArgs)
        MyBase.tlb_ToolClick(sender, e)

        Dim grd As UltraWinGrid.UltraGrid = Nothing
        If e.Tool.OwningMenu IsNot Nothing Then
            grd = GRDs(Mid(e.Tool.OwningMenu.Key, 4))
        End If
        Dim tlb_sbt As UltraWinToolbars.StateButtonTool = Nothing
        Dim tlb_btn As UltraWinToolbars.ButtonTool = Nothing

        Select Case e.Tool.Key
            Case "Create Carton"

                If grdSOTCART1.ActiveRow Is Nothing Then
                    Exit Sub
                End If

                If Not grdSOTCART1.ActiveRow.IsDataRow Then
                    Exit Sub
                End If

                Dim PKG_W As Decimal = Val(grdSOTCART1.ActiveRow.Cells("PKG_W").Value & String.Empty)
                Dim PKG_L As Decimal = Val(grdSOTCART1.ActiveRow.Cells("PKG_L").Value & String.Empty)
                Dim PKG_H As Decimal = Val(grdSOTCART1.ActiveRow.Cells("PKG_H").Value & String.Empty)

                If PKG_H <= 0 OrElse PKG_L <= 0 OrElse PKG_H <= 0 Then
                    MessageBox.Show("Height, Length and Width must all be greter than 0", "Create Carton", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                ASCMAIN1.sql = "SELECT * FROM WHTPKGM1 WHERE PKG_W = :PARM1 AND PKG_L = :PARM2 AND PKG_H = :PARM3"
                Dim rowWHTPKGM1 As DataRow = ASCDATA1.GetDataRow(ASCMAIN1.sql, "NNN", {PKG_W, PKG_L, PKG_H})

                If rowWHTPKGM1 IsNot Nothing Then
                    MessageBox.Show($"These package Dimensions already exist on Carton {rowWHTPKGM1.Item("PKG_CODE")}.", "Create Carton", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                Dim PKG_CODE As String = PKG_L.ToString("00") & PKG_W.ToString("00") & PKG_H.ToString("00")
                Dim PKG_DESC As String = PKG_L.ToString("00") & " x " & PKG_W.ToString("00") & " x " & PKG_H.ToString("00")

                If PKG_CODE.Length > 6 Then
                    PKG_CODE = PKG_CODE.Substring(0, 6)
                End If

                Try
                    BeginTrans()
                    ASCMAIN1.sql = $"Insert Into WHTPKGM1
                                        (PKG_CODE, PKG_DESC, PKG_L, PKG_W, PKG_H, PKG_SEQ)
                                    VALUES
                                        ('{PKG_CODE}', '{PKG_DESC}', {PKG_L.ToString("00")}, {PKG_W.ToString("00")}, {PKG_H.ToString("00")}, 99)"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
                    CommitTrans("Package Created")

                    Try
                        ultraComboPackage.DataSource = ASCDATA1.GetDataTable("SELECT PKG_CODE, PKG_DESC, PKG_L || ' x ' ||  PKG_W || ' x ' || PKG_H PKG_D FROM WHTPKGM1 order by PKG_CODE")
                        ultraComboPackage.ValueMember = "PKG_CODE"
                        ultraComboPackage.DisplayMember = "PKG_DESC"
                        grdSOTCART1.DisplayLayout.Bands(0).Columns("PKG_CODE").EditorComponent = ultraComboPackage
                        grdSOTCART1_SHIP.DisplayLayout.Bands(0).Columns("PKG_CODE").EditorComponent = ultraComboPackage
                    Catch ex As Exception
                    End Try

                Catch ex As Exception
                    Rollback(ex.Message)
                End Try


            Case "Copy Qty Confirmed to all Pick Tickets", "Cancel Qty", "Restore Qty", "Back Order Qty"

                Dim STYLE_CODE As String = grdSOTPICK2_SC.ActiveRow.Cells("STYLE_CODE").Value & String.Empty
                Dim COLOR_CODE As String = grdSOTPICK2_SC.ActiveRow.Cells("COLOR_CODE").Value & String.Empty
                Dim PICK_QTY_CONF As Int32 = Val(grdSOTPICK2_SC.ActiveRow.Cells("PICK_QTY_CONF").Value & String.Empty)

                Select Case e.Tool.Key
                    Case "Cancel Qty"
                        PICK_QTY_CONF = 0
                    Case "Restore Qty"
                        PICK_QTY_CONF = -999
                End Select

                CopyQtyConfirmedToAllPickTickets(STYLE_CODE, COLOR_CODE, PICK_QTY_CONF, e.Tool.Key = "Copy Qty Confirmed to all Pick Tickets")

            Case "Select All", "De-Select All"
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                    rowSOTPICK1.Item("SELECTED") = IIf(e.Tool.Key = "Select All", "1", "0")
                    If rowSOTPICK1.Item("PICK_STATUS") & String.Empty = "C" Then
                        rowSOTPICK1.Item("SELECTED") = "0"
                    End If
                Next
                Display_Totals()

            Case "Hide Details"
                tlb_sbt = DirectCast(e.Tool, UltraWinToolbars.StateButtonTool)
                splSOTPICK1.Panel2Collapsed = tlb_sbt.Checked

            Case "Cancel Pick Ticket", "Cancel Customer/Ship To Pick Tickets", "Restore Pick Ticket", "Restore Customer/Ship To Pick Tickets"
                If grdSOTPICK1.ActiveRow Is Nothing Then
                    MessageBox.Show("Cannot determine the selected row.", "Cancel Pick Ticket", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                Dim PICK_NO As String = grdSOTPICK1.ActiveRow.Cells("PICK_NO").Value & String.Empty
                If PICK_NO.Length = 0 Then
                    MessageBox.Show("Cannot determine the selected Pick Ticket.", "Pick Ticket", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)
                If rowSOTPICK1 Is Nothing Then
                    MessageBox.Show("Cannot locate the selected Pick Ticket (" & PICK_NO & ")", "Pick Ticket", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                Dim CUST_CODE As String = rowSOTPICK1.Item("CUST_CODE") & String.Empty
                Dim CUST_STORE_NO As String = rowSOTPICK1.Item("CUST_STORE_NO") & String.Empty
                Dim numCustPickTickets As Int32 = dst.Tables("SOTPICK1").Select("CUST_CODE = '" & CUST_CODE & "' AND CUST_STORE_NO = '" & CUST_STORE_NO & "' and PICK_STATUS = 'P'  AND PICK_STATUS_ORIG = 'P'").Length
                Dim sql As String = String.Empty
                Dim zMsg As String = String.Empty
                Dim PICK_STATUS_from As String = String.Empty
                Dim PICK_STATUS_to As String = String.Empty

                Select Case e.Tool.Key
                    Case "Cancel Pick Ticket"
                        If MessageBox.Show("Do you want to Cancel Pick Ticket: " & PICK_NO & "?", "Cancel Pick Ticket", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Exit Sub
                        End If
                        sql = "PICK_NO = '" & PICK_NO & "'"
                        PICK_STATUS_from = "P"
                        PICK_STATUS_to = "C"

                    Case "Cancel Customer/Ship To Pick Tickets"
                        If MessageBox.Show("Do you want to cancel " & numCustPickTickets & "Cancel Pick Tickets for " & CUST_CODE & " - " & CUST_STORE_NO & "?", "Cancel Pick Tickets", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Exit Sub
                        End If
                        sql = "CUST_CODE = '" & CUST_CODE & "' AND CUST_STORE_NO = '" & CUST_STORE_NO & "'"
                        PICK_STATUS_from = "P"
                        PICK_STATUS_to = "C"

                    Case "Restore Pick Ticket"
                        If MessageBox.Show("Do you want to Restore Pick Ticket: " & PICK_NO & "?", "Restore Pick Ticket", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Exit Sub
                        End If
                        sql = "PICK_NO = '" & PICK_NO & "'"
                        PICK_STATUS_from = "C"
                        PICK_STATUS_to = "P"

                    Case "Restore Customer/Ship To Pick Tickets"
                        If MessageBox.Show("Do you want to Restore " & numCustPickTickets & " Pick Tickets for " & CUST_CODE & " - " & CUST_STORE_NO & "?", "Restore Pick Tickets", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Exit Sub
                        End If
                        sql = "CUST_CODE = '" & CUST_CODE & "' AND CUST_STORE_NO = '" & CUST_STORE_NO & "'"
                        PICK_STATUS_from = "C"
                        PICK_STATUS_to = "P"

                End Select

                Me.Cursor = Cursors.WaitCursor

                Dim lstPickTickets As New List(Of String)
                For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select(sql & " AND PICK_STATUS = '" & PICK_STATUS_from & "' AND PICK_STATUS_ORIG = 'P'")
                    PICK_NO = rowSOTPICK1.Item("PICK_NO") & String.Empty
                    lstPickTickets.Add(PICK_NO)

                    ASCMAIN1.Progress("Canceling Pick Ticket: " & PICK_NO)

                    rowSOTPICK1.Item("PICK_STATUS") = PICK_STATUS_to
                    'rowSOTPICK1.Item("SELECTED") = "0"
                    For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "'")
                        Select Case PICK_STATUS_to
                            Case "C"
                                rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                                rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                                rowSOTPICK2.Item("PICK_QTY_CANC") = rowSOTPICK2.Item("PICK_QTY")

                            Case "P"
                                rowSOTPICK2.Item("PICK_QTY_CONF") = rowSOTPICK2.Item("PICK_QTY")
                                rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                                rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                        End Select
                    Next
                Next

                ASCMAIN1.Progress("Cleaning up cartons", "")

                Force_Cartons_to_Balance(False)

                For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select(sql & " AND PICK_STATUS = '" & PICK_STATUS_from & "' AND PICK_STATUS_ORIG = 'P'")
                    For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'", "CART_NO", DataViewRowState.CurrentRows)
                        Dim CART_NO As String = rowSOTCART1.Item("CART_NO")
                        rowSOTCART1.Item("CART_TOTAL_UNITS") = Val(dst.Tables("SOTCART2").Compute("SUM(QTY_PACKED)", "CART_NO = '" & CART_NO & "'") & String.Empty)
                    Next

                    rowSOTPICK1.Item("PICK_TOTAL_WGT") = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & PICK_NO & "'") & String.Empty)
                    rowSOTPICK1.Item("PICK_CNT_CARTONS") = dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'", "", DataViewRowState.CurrentRows).Length

                    If PICK_STATUS_to = "C" Then
                        rowSOTPICK1.Item("PICK_TOTAL_WGT") = 0
                    End If
                Next

                Setup_SOTPICK1()

                Me.Cursor = Cursors.Default

                MessageBox.Show("Pick Ticket(s) " & IIf(PICK_STATUS_to = "C", "canceled.", "restored."), "Pick Tickets", MessageBoxButtons.OK, MessageBoxIcon.Information)
                ASCMAIN1.Progress("", "")

            Case "Refresh"
                ' Refresh What

            Case "Set Appointment"
                If grd.ActiveRow.Band.Key <> grd.DisplayLayout.Bands(0).Key Then
                    Exit Sub
                End If

                If grd.Selected.Rows.Count = 0 Then
                    MessageBox.Show("You must select at least one shipment.", "Set Appointment", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                Dim lstBols As New List(Of String)
                For Each grdRow As Infragistics.Win.UltraWinGrid.UltraGridRow In grd.Selected.Rows
                    lstBols.Add(grdRow.Cells("SHIP_BOL_NO").Value & String.Empty)
                Next

                Dim msg As String = "Do you want to update the Appt No for the " & lstBols.Count & " selected shipment(s)?"
                If MessageBox.Show(msg, "Set Appointment", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If

                For Each SHIP_BOL_NO As String In lstBols
                    If Not ASCMAIN1.Logical_Lock("SOTSHIP1", SHIP_BOL_NO) Then Exit Sub
                    Dim rowSOTSHIPS As DataRow = LookUp("SOTSHIP1", SHIP_BOL_NO)
                    Dim ORDR_GROUP_NO As String = rowSOTSHIPS.Item("ORDR_GROUP_NO") & String.Empty
                    If Not ASCMAIN1.Logical_Lock("SOTORDR0", ORDR_GROUP_NO) Then Exit Sub
                Next

                ' Prompt user for message.
                Dim prompt As String = InputBox("Please provide an Appointment note. Max 20 characters.", "Set Appointment") & String.Empty
                If prompt.Length > 20 Then
                    prompt = prompt.Substring(0, 20).Trim
                End If

                If prompt.Length > 0 Then
                    For Each SHIP_BOL_NO As String In lstBols
                        Dim rowSOTSHIPX As DataRow = dst.Tables("SOTSHIPX").Rows.Find(SHIP_BOL_NO)
                        rowSOTSHIPX.Item("SHIP_APPT_NO") = prompt
                        ASCMAIN1.sql = "UPDATE SOTSHIP1 SET SHIP_APPT_NO = :PARM1 WHERE SHIP_BOL_NO = :PARM2"
                        ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {prompt, SHIP_BOL_NO})

                        Dim BILL_OF_LADING_NO As String = rowSOTSHIPX.Item("BILL_OF_LADING_NO") & String.Empty
                        If BILL_OF_LADING_NO.Length > 0 Then
                            ASCMAIN1.sql = "UPDATE SOTSHIPB SET SHIP_APPT_NO = :PARM1 WHERE BOL_NO = :PARM2"
                            ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {prompt, BILL_OF_LADING_NO})
                        End If
                    Next
                End If

                ASCMAIN1.MultiTask_Release()

            Case "Place on Hold"
                If grd.ActiveRow.Band.Key <> grd.DisplayLayout.Bands(0).Key Then
                    Exit Sub
                End If
                Dim SHIP_BOL_NO As String = grd.ActiveRow.Cells("SHIP_BOL_NO").Value & String.Empty
                ASCMAIN1.sql = "UPDATE SOTPICK1 SET PICK_PICKER = '" & ecommerceOnHold & "' WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "'"
                ASCDATA1.ExecuteSQL(ASCMAIN1.sql)

                For Each row As DataRow In dst.Tables("SOTPICK1_X").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                    row.Item("PICK_PICKER") = ecommerceOnHold
                Next

            Case "Print Consolidated Pick Slip"
                If grd.ActiveRow.Band.Key <> grd.DisplayLayout.Bands(0).Key Then
                    Exit Sub
                End If

                If Not isEcommProcessing Then
                    Exit Sub
                End If

                Dim list As New List(Of String)
                For Each grdRow As Infragistics.Win.UltraWinGrid.UltraGridRow In grdSOTSHIPX.Selected.Rows
                    If grdRow.Band.Key = grd.DisplayLayout.Bands(0).Key Then
                        list.Add(grdRow.Cells("SHIP_BOL_NO").Value)
                    End If
                Next

                If list.Count > 0 Then

                    Dim tbl As DataTable = ASCDATA1.GetDataTable("SELECT SHIP_BOL_NO FROM SOTPICK1 WHERE PICK_PICKER IS NOT NULL AND SHIP_BOL_NO IN ('" & String.Join("','", list.ToArray) & "')")
                    If tbl.Rows.Count > 0 Then
                        Dim zMsg As String = "The following shipments appear to have been printed on a Consolidated packing List:" & Environment.NewLine & Environment.NewLine
                        For Each row As DataRow In tbl.Select("", "SHIP_BOL_NO")
                            zMsg &= row.Item("SHIP_BOL_NO") & Environment.NewLine
                        Next

                        zMsg &= Environment.NewLine
                        zMsg &= "Choose Yes to print all the selected shipments." & Environment.NewLine
                        zMsg &= "Choose No to skip the already printed shipments." & Environment.NewLine
                        zMsg &= "Choose Cancel to not print anything." & Environment.NewLine

                        Select Case MessageBox.Show(zMsg, "Print Consolidated Pick Slip", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2)
                            Case Windows.Forms.DialogResult.Yes
                                ' do nothing at this point
                            Case Windows.Forms.DialogResult.No
                                For Each row As DataRow In tbl.Select("", "SHIP_BOL_NO")
                                    Dim SHIP_BOL_NO As String = row.Item("SHIP_BOL_NO") & String.Empty
                                    list.Remove(SHIP_BOL_NO)
                                Next

                                If list.Count = 0 Then
                                    MessageBox.Show("All shipments were removed from the list. Nothing to print", "Print Consolidated Pick Slip", MessageBoxButtons.OK)
                                    grdSOTSHIPX.Selected.Rows.Clear()
                                    Exit Sub
                                End If

                            Case Windows.Forms.DialogResult.Cancel
                                grdSOTSHIPX.Selected.Rows.Clear()
                                Exit Sub
                        End Select

                    End If

                    If isEcommProcessing AndAlso MENU_ITEM_OBJECT = "SOFSHIPQ" Then
                        Dim msg As String = "QVC printer should have Crack and Peel paper in it. Please place a standard sheet of paper in the printer. Do you want to print the Consolidated Pick Slip?"
                        If MessageBox.Show(msg, "Print Consolidated Pick Slip", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Exit Sub
                        End If
                    End If

                    Try
                        If Not ASCMAIN1.Logical_Lock("CONSPICK", "*", , , False, CONSPICK_MTASK) Then
                            Exit Sub
                        End If

                        Me.Cursor = Cursors.WaitCursor

                        Dim RPT As String = "SORPICKE"
                        If Not REPORTS.ContainsKey(RPT) Then
                            REPORTS.Add(RPT, Load_rptClass(RPT))
                            REPORTS(RPT).Prepare_dst(False, "")
                        End If

                        REPORTS(RPT).Fill_Records_RPT(New String() {"'" & String.Join("','", list.ToArray) & "'"})

                        Dim REPORT_NO As String = String.Empty
                        With REPORTS(RPT).clsASCBASE1
                            .Print_Report_Begin()

                            .Generate_Report("SORECOMC", "Consolidated Packing List", String.Empty, False, False, String.Empty, "RPT", String.Empty, False)

                            If LaserPrinterName.Length = 0 AndAlso LaserPrinterIpAddress.Length = 0 Then
                                .Print_Report_End()
                            Else
                                .Print_Report_End(True, False, LaserPrinterName, , LaserPrinterIpAddress)
                            End If

                        End With

                        ASCDATA1.ExecuteSQL("UPDATE SOTPICK1 SET PICK_PICKER = '" & ASCMAIN1.USER_ID & "', PICK_PACKED = SYSDATE, PICK_PRINTED = SYSDATE WHERE SHIP_BOL_NO IN ('" & String.Join("','", list.ToArray) & "')")

                        For Each SHIP_BOL_NO As String In list
                            SHIP_BOL_NO = SHIP_BOL_NO.Trim
                            If SHIP_BOL_NO.Length = 0 Then Continue For

                            For Each rowSOTPICKX As DataRow In dst.Tables("SOTPICK1_X").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                                rowSOTPICKX.Item("PICK_PICKER") = ASCMAIN1.USER_ID
                                rowSOTPICKX.Item("PICK_PACKED") = DateTime.Now
                                rowSOTPICKX.Item("PICK_PRINTED") = DateTime.Now
                            Next
                        Next
                    Catch ex As Exception

                    Finally
                        ASCMAIN1.MultiTask_Release(,, CONSPICK_MTASK)
                    End Try

                    grdSOTSHIPX.Selected.Rows.Clear()
                    Me.Cursor = Cursors.Default

                    MessageBox.Show("Print Consolidated Pick Slip Complete.", "Print Consolidated Pick Slip", MessageBoxButtons.OK, MessageBoxIcon.Information)
                End If

            Case "Invoice Shipments"
                If dst.Tables("WHT3PLS1").Rows.Count = 0 Then
                    MessageBox.Show("There are No shipments to Invoice.", "Invoice Shipments", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                If MessageBox.Show("Do you want to Invoice the EDI 945 Shipments?", "Invoice Shipments", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If

                Dim lstShipBols As New List(Of String)
                For Each row As DataRow In dst.Tables("WHT3PLS1").Select("")
                    lstShipBols.Add(row.Item("SHIP_BOL_NO"))
                Next

                autoEDI945ProcessingList = New List(Of String)

                For Each SHIP_BOL_NO As String In lstShipBols
                    errorInAutoInvoice = True
                    AutoInvoiceInProcess = True

                    Dim selectedEDI_BOL_NO As String = SHIP_BOL_NO
                    processing_select_from_3PL_list = True
                    select_from_3PL_list = True
                    Absx1.txtFor("SHIP_BOL_NO").Text = selectedEDI_BOL_NO
                    Click_Command("Select")

                    If errorInAutoInvoice Then
                        processing_select_from_3PL_list = True
                        Click_Command("Cancel")
                        Continue For
                    End If

                    processing_select_from_3PL_list = False
                    System.Threading.Thread.Sleep(1000)
                    Click_Command("Finalize")

                    If errorInAutoInvoice Then
                        Click_Command("Cancel")
                    End If
                Next

                AutoInvoiceInProcess = False
                MessageBox.Show("Invoicing Complete", "Invoice Shipments", MessageBoxButtons.OK, MessageBoxIcon.Information)

                If autoEDI945ProcessingList.Count > 0 Then
                    Dim clsASCNOTE1 As New TAC.ASCNOTE1("EDI945PR", dst)
                    clsASCNOTE1.Note = String.Join(Environment.NewLine, autoEDI945ProcessingList)
                    clsASCNOTE1.CreateComponents()
                    clsASCNOTE1.EmailDocument()
                End If

            Case "Permit Price Change"
                tlb_sbt = DirectCast(e.Tool, UltraWinToolbars.StateButtonTool)

                If dst.Tables("SOTORDR1").Select("ISNULL(EDI_DOC_SEQ_NO, '') <> '' or CURR_CODE <> 'USD'").Length > 0 Then
                    MessageBox.Show("You are not permitted to change prices on EDI orders and non USD orders.", "", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    tlb_sbt.Checked = False
                End If

                With grdSOTPICK2.DisplayLayout.Bands(0).Columns("PICK_UNIT_PRICE")
                    If tlb_sbt.Checked Then
                        .CellActivation = UltraWinGrid.Activation.AllowEdit
                        .Header.Appearance.BackColor2 = Drawing.Color.LightGreen
                        .CellAppearance.BackColor = Drawing.Color.Empty
                    Else
                        .CellActivation = UltraWinGrid.Activation.NoEdit
                        .Header.Appearance.BackColor2 = Drawing.Color.LightGray
                        .CellAppearance.BackColor = Drawing.Color.Beige
                    End If
                End With

                With grdSOTPICK2_SC.DisplayLayout.Bands(0).Columns("PICK_UNIT_PRICE")
                    If tlb_sbt.Checked Then
                        .CellActivation = UltraWinGrid.Activation.AllowEdit
                        .Header.Appearance.BackColor2 = Drawing.Color.LightGreen
                        .CellAppearance.BackColor = Drawing.Color.Empty
                    Else
                        .CellActivation = UltraWinGrid.Activation.NoEdit
                        .Header.Appearance.BackColor2 = Drawing.Color.LightGray
                        .CellAppearance.BackColor = Drawing.Color.Beige
                    End If
                End With

            Case "Print Manifest"
                If grdSOTSHIPX.ActiveRow Is Nothing Then
                    MessageBox.Show("Select a Shipment from the list of shipments.")
                    Exit Sub
                End If

                PrintManifest(grdSOTSHIPX.ActiveRow.Cells("SHIP_BOL_NO").Value & String.Empty)

            Case "Track Shipment"
                Dim rowSOTSVIA1 As DataRow = dst.Tables("SOTSVIA1").Rows.Find(grd.ActiveRow.Cells("SHIP_VIA_CODE").Value & String.Empty)
                SOCMAIN1.Track_Shipment(grd.ActiveRow.Cells("SHIP_VIA_CODE").Text, grd.ActiveRow.Cells("SHIP_REF").Text)

            Case "Email Invoice"

                Dim lst As New List(Of String)
                Dim lstCustCode As New List(Of String)

                For Each grdRow As UltraWinGrid.UltraGridRow In grd.Selected.Rows
                    If Not lst.Contains(grdRow.Cells("SHIP_BOL_NO").Text) Then
                        lst.Add(grdRow.Cells("SHIP_BOL_NO").Text)
                    End If

                    If Not lstCustCode.Contains(grdRow.Cells("CUST_CODE").Text) Then
                        lstCustCode.Add(grdRow.Cells("CUST_CODE").Text)
                    End If

                Next

                Select Case lstCustCode.Count
                    Case 0
                        MessageBox.Show("There are no selected items.", "Email Invoice", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Sub
                    Case 1
                        ' Nothing
                    Case Else
                        MessageBox.Show("You can only email invoices to a single customer.", "Email Invoice", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Sub
                End Select

                Dim INV_NO As String = String.Empty
                Dim CUST_CODE As String = String.Empty

                If grd.Selected.Rows(0).Band.Key = grd.DisplayLayout.Bands(0).Key Then
                    For Each SHIP_BOL_NO As String In lst
                        For Each row As DataRow In dst.Tables("SOTINVHX").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                            INV_NO &= "," & row.Item("INV_NO") & ""
                            CUST_CODE = row.Item("CUST_CODE") & ""
                        Next
                    Next
                Else
                    For Each grdRow As Infragistics.Win.UltraWinGrid.UltraGridRow In grd.Selected.Rows
                        INV_NO &= "," & grdRow.Cells("INV_NO").Value & ""
                        CUST_CODE = grdRow.Cells("CUST_CODE").Value & ""
                    Next
                End If

                If INV_NO.Length = 0 Then
                    MessageBox.Show("There are no invoices to email.", "Email Invoice", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                Dim rowARTCUST1 As DataRow = LookUp("ARTCUST1", CUST_CODE)

                If rowARTCUST1 Is Nothing Then
                    MessageBox.Show("Could not locate Customer in Customer Master.", "Email Invoice", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                ElseIf rowARTCUST1.Item("CUST_EMAIL") & String.Empty = String.Empty Then
                    MessageBox.Show("This customer does not have an email address on their customer master record.", "Email Invoice", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                INV_NO = INV_NO.Substring(1).Trim

                Dim FILENAME As String = TAC.SOCMAIN1.Create_Invoice(Me, INV_NO)
                Dim SUBJECT As String = "Invoice(s) " & INV_NO

                TAC.SOCMAIN1.email_Invoice(Me, rowARTCUST1.Item("CUST_CODE"), rowARTCUST1.Item("CUST_NAME"), rowARTCUST1.Item("CUST_EMAIL"), rowARTCUST1.Item("CUST_EMAIL"), FILENAME, FILENAME, SUBJECT, INV_NO)

        End Select

        If grd Is Nothing Then
            Exit Sub
        Else
            If grd.ActiveRow Is Nothing OrElse grd.ActiveRow.IsAddRow OrElse Not grd.ActiveRow.IsDataRow Then
                Exit Sub
            End If
        End If

        Select Case e.Tool.Key

            Case "Consolidate Cartons"
                Dim CART_NO As String = grd.ActiveRow.Cells("CART_NO").Text
                ConsolidateIntoOneCarton(CART_NO)

            Case "Propagate Value"
                Dim COLUMN_NAME As String = e.Tool.Tag
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                    rowSOTPICK1.Item(COLUMN_NAME) = grdSOTPICK1.ActiveCell.Value
                Next
                Display_Totals()

            Case "Calc Ctns and Wgt from Pick Tickets"
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("", "", DataViewRowState.CurrentRows)
                    For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & rowSOTSHIP1.Item("SHIP_BOL_NO") & "'", "", DataViewRowState.CurrentRows)
                        rowSOTSHIP1.Item("SHIP_CNT_CARTONS") = Val(rowSOTSHIP1.Item("SHIP_CNT_CARTONS") & "") + dst.Tables("SOTCART1").Select("PICK_NO = '" & rowSOTPICK1.Item("PICK_NO") & "'", "", DataViewRowState.CurrentRows).Length
                        rowSOTSHIP1.Item("SHIP_TOTAL_WGT") = Val(rowSOTSHIP1.Item("SHIP_TOTAL_WGT") & String.Empty) + Val(rowSOTPICK1.Item("PICK_TOTAL_WGT") & String.Empty)
                    Next
                Next

            Case "Style Status Inquiry"
                Dim STYLE_CODE As String = grd.ActiveRow.Cells("STYLE_CODE").Text
                Dim rowICTSTYL1 As DataRow = LookUp("ICTSTYL1", STYLE_CODE)
                If rowICTSTYL1 IsNot Nothing Then
                    Context_Launch("Select", STYLE_CODE, e.Tool.Key, "ICFSTAT1")
                End If

            Case "Sales Order Inquiry"
                Dim ORDR_NO As String = grd.ActiveRow.Cells("ORDR_NO").Value & ""
                Context_Launch("View", ORDR_NO, e.Tool.Key, "SOFORDRI")

            Case "Add Shipment to BOL"
                If isEcommProcessing AndAlso isLpCodeWarehouse Then
                    MessageBox.Show("Ecommerce Shipments cannot be combined.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Exit Sub
                End If

                AddShipmentToBol()
                Display_Totals()

            Case "Remove Shipment from BOL"
                RemoveShipmentFromBol()
                Display_Totals()

            Case "Refresh Avaliable Shipments"
                RefreshBolShipments(False)

            Case "Add BOL to Master"
                If grdSOTSHIPS.ActiveRow Is Nothing Then Exit Sub
                AddBOLtoMaster(grd.ActiveRow.Cells("BOL_NO").Text)
                Display_Totals()

            Case "Remove BOL from Master"
                If grdSOTSHIPS.ActiveRow Is Nothing Then Exit Sub
                RemoveBolfromMaster(grd.ActiveRow.Cells("BOL_NO").Text)
                Display_Totals()

            Case "Add to Master"
                Add_To_Master()

            Case "Refresh Avaliable BOLs"
                RefreshMasterBol()

            Case "Copy to Selected Cartons"
                Dim sql As String = String.Empty
                If grdSOTCART1.Selected.Rows.Count <= 1 Then
                    MessageBox.Show("You must have more than one carton selected.", "", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit Sub
                End If

                Dim PKG_L As Decimal = 0
                Dim PKG_W As Decimal = 0
                Dim PKG_H As Decimal = 0
                Dim CART_TOTAL_WGT_ACTUAL As Decimal = 0
                Dim CART_NO As String = String.Empty

                PKG_L = Val(grd.Selected.Rows(0).Cells("PKG_L").Value & String.Empty)
                PKG_W = Val(grd.Selected.Rows(0).Cells("PKG_W").Value & String.Empty)
                PKG_H = Val(grd.Selected.Rows(0).Cells("PKG_H").Value & String.Empty)
                CART_TOTAL_WGT_ACTUAL = Val(grd.Selected.Rows(0).Cells("CART_TOTAL_WGT_ACTUAL").Value & String.Empty)
                CART_NO = grd.Selected.Rows(0).Cells("CART_NO").Value & String.Empty

                Dim zmsg As String = "Do you want to copy the Weight (" & CART_TOTAL_WGT_ACTUAL & ") and Carton dimensions (" & PKG_L & " x " & PKG_W & " x " & PKG_H & ") from Carton ( " & CART_NO & ") to the other selected cartons?"
                If MessageBox.Show(zmsg, "Copy", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If

                For Each grdRow As Infragistics.Win.UltraWinGrid.UltraGridRow In grdSOTCART1.Selected.Rows
                    CART_NO = grdRow.Cells("CART_NO").Value
                    Dim rowSOTCART1 As DataRow = dst.Tables("SOTCART1").Rows.Find(CART_NO)

                    If rowSOTCART1 Is Nothing Then
                        Continue For
                    End If

                    rowSOTCART1.Item("PKG_L") = PKG_L
                    rowSOTCART1.Item("PKG_W") = PKG_W
                    rowSOTCART1.Item("PKG_H") = PKG_H
                    rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = CART_TOTAL_WGT_ACTUAL

                    Dim pickWeight As Decimal = Val(dst.Tables("SOTPICK1").Select("PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'")(0).Item("PICK_TOTAL_WGT") & String.Empty)
                    Dim totalCartWeight As Decimal = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'") & String.Empty)

                    If ASCMAIN1.CLIENT = "NYA" Then
                        If totalCartWeight > pickWeight Then
                            dst.Tables("SOTPICK1").Select("PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'")(0).Item("PICK_TOTAL_WGT") = totalCartWeight
                        End If
                    Else
                        dst.Tables("SOTPICK1").Select("PICK_NO = '" & rowSOTCART1.Item("PICK_NO") & "'")(0).Item("PICK_TOTAL_WGT") = totalCartWeight
                    End If
                Next

                Display_Totals()
                MessageBox.Show("Copy Complete", "Copy", MessageBoxButtons.OK, MessageBoxIcon.Information)

            Case "Cancel Carton Contents"
                Try
                    Dim CART_NO As String = grd.ActiveRow.Cells("CART_NO").Value & String.Empty
                    Dim QTY_PACKED_TOTAL As Int32 = dst.Tables("SOTCART2").Compute("SUM(QTY_PACKED)", $"CART_NO = '{CART_NO}'")

                    If MessageBox.Show($"Do you want to Cancel the {QTY_PACKED_TOTAL} pieces in this carton?", "Cancel Carton Contents", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = DialogResult.No Then
                        Exit Sub
                    End If

                    Me.Cursor = Cursors.WaitCursor

                    For iloop As Int16 = 1 To 2
                        For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select($"CART_NO = '{CART_NO}'")
                            Dim PICK_NO As String = rowSOTCART1.Item("PICK_NO") & String.Empty
                            Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)

                            For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select($"CART_NO = '{CART_NO}'")
                                Dim ORDR_NO As String = rowSOTCART2.Item("ORDR_NO") & String.Empty
                                Dim ORDR_LNO As Int32 = rowSOTCART2.Item("ORDR_LNO") & String.Empty
                                Dim QTY_PACKED As Int32 = Val(rowSOTCART2.Item("QTY_PACKED") & String.Empty)

                                ASCMAIN1.sql = $"PICK_NO = '{PICK_NO}' AND ORDR_NO = '{ORDR_NO}' AND ORDR_LNO = {ORDR_LNO}"

                                Select Case iloop
                                    Case 1
                                        If dst.Tables("SOTPICK2").Select(ASCMAIN1.sql).Length = 0 Then
                                            MessageBox.Show($"Cannot locate Pick Ticket Detail for Sales Order {ORDR_NO}, Line No. {ORDR_LNO}", "Cancel Carton Contents", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                            Exit Sub
                                        End If

                                    Case 2
                                        Dim rowSOTPICK2 As DataRow = dst.Tables("SOTPICK2").Select(ASCMAIN1.sql)(0)
                                        rowSOTPICK2.Item("PICK_QTY_CANC") = Val(rowSOTPICK2.Item("PICK_QTY_CANC") & String.Empty) + QTY_PACKED ' Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty)
                                        rowSOTPICK2.Item("PICK_QTY_CONF") = Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) - QTY_PACKED
                                        If rowSOTPICK2.Item("PICK_QTY_CONF") < 0 Then
                                            rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                                        End If

                                End Select
                            Next

                            If iloop = 2 Then
                                rowSOTCART1.Delete()
                                rowSOTPICK1.Item("PICK_CNT_CARTONS") = dst.Tables("SOTCART1").Select($"PICK_NO = '{PICK_NO}'", "", DataViewRowState.CurrentRows).Length
                                Dim totalCartWeight As Decimal = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", $"PICK_NO = '{PICK_NO}'") & String.Empty)
                                rowSOTPICK1.Item("PICK_TOTAL_WGT") = totalCartWeight
                            End If
                        Next
                    Next

                    SetupgrdSOTCART1_SHIP()
                    Display_Totals()
                    MessageBox.Show("The carton has been deleted and the contents marked as cancelled.", "Cancel Carton Contents", MessageBoxButtons.OK, MessageBoxIcon.Information)

                Catch ex As Exception
                    MessageBox.Show(ex.Message, "Cancel Carton Contents", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Finally
                    Me.Cursor = Cursors.Default
                End Try

            Case "Copy to Pick Ticket Cartons", "Copy to Shipment Cartons"
                Dim sql As String = String.Empty
                If e.Tool.Key = "Copy to Pick Ticket Cartons" Then
                    sql = "PICK_NO = '" & grd.ActiveRow.Cells("PICK_NO").Value & "'"
                End If

                Dim valueToCopy As String = grd.ActiveCell.Value & String.Empty
                Dim columnToCopy As String = grd.ActiveCell.Column.Key

                Dim PKG_L As Decimal = 0
                Dim PKG_W As Decimal = 0
                Dim PKG_H As Decimal = 0
                Dim PKG_Wght As Decimal = 0

                Dim zMsg As String = String.Empty
                If ASCMAIN1.CLIENT = "VAN" Then
                    zMsg = "Do you want use this Carton (" & grd.ActiveRow.Cells("CART_NO").Value & ") to " & e.Tool.Key & "? Note: box dimensions and weight will be copied."
                    PKG_Wght = grd.ActiveRow.Cells("CART_TOTAL_WGT_ACTUAL").Value
                    PKG_L = Val(grd.ActiveCell.Row.Cells("PKG_L").Value & String.Empty)
                    PKG_W = Val(grd.ActiveCell.Row.Cells("PKG_W").Value & String.Empty)
                    PKG_H = Val(grd.ActiveCell.Row.Cells("PKG_H").Value & String.Empty)
                Else
                    If columnToCopy = "PKG_CODE" Then
                        zMsg = "Do you want to use the value of this Package (" & valueToCopy & ") to " & e.Tool.Key & "? Note: box dimensions will be copied as well."
                        PKG_L = Val(grd.ActiveCell.Row.Cells("PKG_L").Value & String.Empty)
                        PKG_W = Val(grd.ActiveCell.Row.Cells("PKG_W").Value & String.Empty)
                        PKG_H = Val(grd.ActiveCell.Row.Cells("PKG_H").Value & String.Empty)
                    Else
                        zMsg = "Do you want to use the value of this Weight (" & valueToCopy & ") to " & e.Tool.Key & "?"
                        valueToCopy = Val(valueToCopy)
                    End If

                End If

                If MessageBox.Show(zMsg, "Copy", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If

                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select(sql, "", DataViewRowState.CurrentRows)

                    Dim PICK_NO As String = rowSOTCART1.Item("PICK_NO")
                    If dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'")(0).Item("PICK_STATUS") <> "P" Then
                        Continue For
                    End If

                    If ASCMAIN1.CLIENT = "VAN" Then
                        rowSOTCART1.Item("PKG_L") = PKG_L
                        rowSOTCART1.Item("PKG_W") = PKG_W
                        rowSOTCART1.Item("PKG_H") = PKG_H
                        rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = PKG_Wght
                    Else
                        rowSOTCART1.Item(columnToCopy) = valueToCopy

                        If columnToCopy = "PKG_CODE" Then
                            rowSOTCART1.Item("PKG_L") = PKG_L
                            rowSOTCART1.Item("PKG_W") = PKG_W
                            rowSOTCART1.Item("PKG_H") = PKG_H
                        End If
                    End If
                    Dim pickWeight As Decimal = Val(dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'")(0).Item("PICK_TOTAL_WGT") & String.Empty)
                    Dim totalCartWeight As Decimal = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & PICK_NO & "'") & String.Empty)

                    If ASCMAIN1.CLIENT = "NYA" Then
                        If totalCartWeight > pickWeight Then
                            dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'")(0).Item("PICK_TOTAL_WGT") = totalCartWeight
                        End If
                    Else
                        dst.Tables("SOTPICK1").Select("PICK_NO = '" & PICK_NO & "'")(0).Item("PICK_TOTAL_WGT") = totalCartWeight
                    End If
                Next
                Display_Totals()
                MessageBox.Show("Copy Complete", "Copy", MessageBoxButtons.OK, MessageBoxIcon.Information)

        End Select
    End Sub

