                & " AND T5.EDI_DOC_SEQ_NO IN (Select EDI_DOC_SEQ_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))" _
                & " AND EDI_ADDR_TYPE = 'ST' AND CONTACT_COMM_NO_QUAL_1 = 'TE'"
            Fill_Records("EDT850T9_PH", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
        End If

        If dst.Tables.Contains("EDT850TC") Then
            ASCMAIN1.sql = "SELECT * FROM EDT850TC WHERE EDI_DOC_SEQ_NO IN (Select EDI_DOC_SEQ_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                    & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))"
            Fill_Records("EDT850TC", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
        End If

        If dst.Tables.Contains("EDT850TE") Then
            ASCMAIN1.sql = "SELECT * FROM EDT850TE WHERE EDI_DOC_SEQ_NO IN (Select EDI_DOC_SEQ_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                    & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))"
            Fill_Records("EDT850TE", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
        End If

        If dst.Tables.Contains("EDT850T5_ST") Then
            ASCMAIN1.sql = "SELECT * FROM EDT850T5 WHERE EDI_ADDR_TYPE = 'ST' AND EDI_DOC_SEQ_NO IN (Select EDI_DOC_SEQ_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))"
            Fill_Records("EDT850T5_ST", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
        End If

        If dst.Tables.Contains("EDT850T5_BT") Then
            ASCMAIN1.sql = "SELECT * FROM EDT850T5 WHERE EDI_ADDR_TYPE = 'BT' AND EDI_DOC_SEQ_NO IN (Select EDI_DOC_SEQ_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))"
            Fill_Records("EDT850T5_BT", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
        End If

        ' Reset Order header level Messges, tax and Less Credit
        For Each rowEDT850T1 As DataRow In dst.Tables("EDT850T1").Select("")
            Dim EDI_DOC_SEQ_NO As String = rowEDT850T1.Item("EDI_DOC_SEQ_NO") & String.Empty

            rowEDT850T1.Item("HEADER_MESSAGE") = String.Empty
            rowEDT850T1.Item("SID_SKU") = String.Empty
            rowEDT850T1.Item("EDI_CMT_REF_06") = String.Empty
            rowEDT850T1.Item("EDI_CMT_REF_07") = String.Empty

            Dim EDI_CMT_REF_06 As String = String.Empty
            Dim EDI_CMT_REF_07 As String = String.Empty

            rowEDT850T1.Item("RETURN_LABEL_FEE") = Val(dst.Tables("EDT850T8").Compute("MAX(SAH_AMOUNT)", "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND SAH_ALLOW_CODE = 'G500'") & String.Empty)

            If dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'OD' AND EDI_CMMNT = 'NEWGISTICS PREPAID LABEL' AND EDI_CMT_REF IS NOT NULL", "").Length > 0 Then
                rowEDT850T1.Item("LABEL_TRACKING_NO") = dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'OD' AND EDI_CMMNT = 'NEWGISTICS PREPAID LABEL' AND EDI_CMT_REF IS NOT NULL", "")(0).Item("EDI_CMT_REF")
            End If

            If dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'KK' AND EDI_CMT_REF IS NOT NULL", "").Length > 0 Then
                rowEDT850T1.Item("LABEL_CONF_NO") = dst.Tables("EDT850TC").Compute("MAX(EDI_CMT_REF)", "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'KK' AND EDI_CMT_REF IS NOT NULL")
            End If

            If dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = '4C' AND EDI_CMT_REF IS NOT NULL", "").Length > 0 Then
                rowEDT850T1.Item("RETURN_SERVICE_POSTAL_CODE") = dst.Tables("EDT850TC").Compute("MAX(EDI_CMT_REF)", "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = '4C' AND EDI_CMT_REF IS NOT NULL")
            End If

            If dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'PN' AND EDI_CMT_REF IS NOT NULL", "").Length > 0 Then
                rowEDT850T1.Item("RETURN_PERMIT_NO") = dst.Tables("EDT850TC").Compute("MAX(EDI_CMT_REF)", "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'PN' AND EDI_CMT_REF IS NOT NULL")
            End If

            If dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'RU' AND EDI_CMT_REF IS NOT NULL", "").Length > 0 Then
                rowEDT850T1.Item("PARTNER_SORT_CODE") = dst.Tables("EDT850TC").Compute("MAX(EDI_CMT_REF)", "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'RU' AND EDI_CMT_REF IS NOT NULL")
            End If

            Dim headerMessage As String = String.Empty

            Select Case CUST_CODE
                Case RegencyQVCCustCode
                    For Each rowEDT850T7 As DataRow In dst.Tables("EDT850T7").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'", "SAH_SEQ_NO")
                        Select Case rowEDT850T7.Item("SAH_ALLOW_CODE") & String.Empty
                            Case "F050"
                                headerMessage &= rowEDT850T7.Item("SAH_DESC") & String.Empty
                        End Select
                    Next

                Case RegencyHomeDepotCustCode
                    For Each rowEDT850T7 As DataRow In dst.Tables("EDT850T7").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'", "SAH_SEQ_NO")
                        Select Case rowEDT850T7.Item("SAH_ALLOW_CODE") & String.Empty
                            Case "H151"
                                headerMessage &= rowEDT850T7.Item("SAH_DESC") & String.Empty
                        End Select
                    Next


                Case RegencyAmazonComCustCode
                    For Each rowEDT850T4 As DataRow In dst.Tables("EDT850T4").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'", "EDI_CMT_SEQ")
                        If rowEDT850T4.Item("EDI_CMMNT") & String.Empty <> String.Empty Then
                            Select Case Val(rowEDT850T4.Item("EDI_CMT_REF") & String.Empty)
                                Case 1 To 5
                                    headerMessage &= rowEDT850T4.Item("EDI_CMMNT") & String.Empty & Environment.NewLine

                                Case 6
                                    EDI_CMT_REF_06 &= rowEDT850T4.Item("EDI_CMMNT") & String.Empty & Environment.NewLine

                                Case 7
                                    EDI_CMT_REF_07 &= rowEDT850T4.Item("EDI_CMMNT") & String.Empty & Environment.NewLine

                            End Select
                        End If
                    Next

                Case RegencyWayfairCustCode
                    For Each rowEDT850T4 As DataRow In dst.Tables("EDT850T4").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_CMT_REF_QUAL = 'TH' AND ISNULL(EDI_CMMNT_2, '') <> ''", "EDI_CMT_SEQ")
                        CustomerPreferredThirdPartyAccountNo = rowEDT850T4.Item("EDI_CMMNT_2") & String.Empty
                        If CustomerPreferredThirdPartyAccountNo.Length > 0 Then
                            Exit For
                        End If
                    Next
            End Select

            headerMessage = headerMessage.Trim
            While headerMessage.Contains(Space(2))
                headerMessage = headerMessage.Replace(Space(2), Space(1))
            End While
            rowEDT850T1.Item("HEADER_MESSAGE") = headerMessage

            EDI_CMT_REF_06 = EDI_CMT_REF_06.Trim
            While EDI_CMT_REF_06.Contains(Space(2))
                EDI_CMT_REF_06 = EDI_CMT_REF_06.Replace(Space(2), Space(1))
            End While
            rowEDT850T1.Item("EDI_CMT_REF_06") = EDI_CMT_REF_06

            EDI_CMT_REF_07 = EDI_CMT_REF_07.Trim
            While EDI_CMT_REF_07.Contains(Space(2))
                EDI_CMT_REF_07 = EDI_CMT_REF_07.Replace(Space(2), Space(1))
            End While
            rowEDT850T1.Item("EDI_CMT_REF_07") = EDI_CMT_REF_07

            For Each rowEDT850T2 As DataRow In dst.Tables("EDT850T2").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'", "EDI_DTL_SEQ")
                ' USE ONLY THE FIRST ITEM
                rowEDT850T1.Item("SID_SKU") = rowEDT850T2.Item("EDI_SKU") & Space(2) & rowEDT850T2.Item("EDI_LBL_CODE") & Space(2) & rowEDT850T2.Item("EDI_SIZE_DESC")
                Exit For
            Next
        Next

        ' Reset Order header gift Messges, Shipping and handling and total line price
        If ASCMAIN1.CLIENT = "RGI" Then
            For Each rowEDT850T2 As DataRow In dst.Tables("EDT850T2").Select("", "EDI_DOC_SEQ_NO, EDI_DTL_SEQ")
                Dim EDI_DOC_SEQ_NO As String = rowEDT850T2.Item("EDI_DOC_SEQ_NO") & String.Empty
                Dim EDI_DTL_SEQ As Int16 = Val(rowEDT850T2.Item("EDI_DTL_SEQ") & String.Empty)

                rowEDT850T2.Item("SHIP_HANDLE") = 0
                rowEDT850T2.Item("TOTAL_PRICE") = 0
                rowEDT850T2.Item("TAX") = 0
                rowEDT850T2.Item("LESS_CREDIT") = 0
                rowEDT850T2.Item("GIFT_MESSAGE") = String.Empty

                For Each rowEDT850T8 As DataRow In dst.Tables("EDT850T8").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_DTL_SEQ = " & EDI_DTL_SEQ, "")
                    Select Case rowEDT850T8.Item("SAH_ALLOW_CODE") & String.Empty
                        Case "G821"
                            rowEDT850T2.Item("SHIP_HANDLE") += Val(rowEDT850T8.Item("SAH_AMOUNT") & String.Empty)
                        Case "A520"
                            rowEDT850T2.Item("TOTAL_PRICE") += Val(rowEDT850T8.Item("SAH_AMOUNT") & String.Empty)
                        Case "H850"
                            rowEDT850T2.Item("TAX") += Val(rowEDT850T8.Item("SAH_AMOUNT") & String.Empty)
                        Case "B800"
                            rowEDT850T2.Item("LESS_CREDIT") += Val(rowEDT850T8.Item("SAH_AMOUNT") & String.Empty)
                    End Select
                Next

                Dim giftMessage As String = String.Empty

                Select Case CUST_CODE
                    Case RegencyAmazonComCustCode
                        For Each row As DataRow In dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' and EDI_DTL_SEQ = " & EDI_DTL_SEQ & " and EDI_CMT_SEQ >= 2", "EDI_DTL_SEQ, EDI_CMT_SEQ")
                            If row.Item("EDI_CMMNT") & String.Empty <> String.Empty Then
                                giftMessage &= " " & row.Item("EDI_CMMNT") & String.Empty
                            End If
                        Next

                    Case RegencyQVCCustCode
                        For Each row As DataRow In dst.Tables("EDT850TC").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' and EDI_DTL_SEQ = " & EDI_DTL_SEQ & " and EDI_CMT_CODE = 'GFT'", "EDI_DTL_SEQ, EDI_CMT_SEQ")
                            If row.Item("EDI_CMMNT") & String.Empty <> String.Empty Then
                                giftMessage &= " " & row.Item("EDI_CMMNT") & String.Empty
                            End If
                        Next
                End Select

                rowEDT850T2.Item("GIFT_MESSAGE") = giftMessage.Trim
            Next
        End If

        dst.Tables("QVCPack").Rows.Clear()
        If ASCMAIN1.CLIENT = "RGI" AndAlso CUST_CODE = RegencyQVCCustCode Then
            Try
                If dst.Tables.Contains("EDT850T1") Then
                    For Each rowEDT850T1 As DataRow In dst.Tables("EDT850T1").Select("")
                        Dim EDI_DOC_SEQ_NO As String = rowEDT850T1.Item("EDI_DOC_SEQ_NO") & String.Empty
                        ASCMAIN1.sql = "SELECT DISTINCT EDT850TC.EDI_DTL_SEQ CARTON_NO, 1 CARTON_LNO," _
                            & " EDT850T2.EDI_ITEM, EDT850T2.EDI_STYLE, EDT850T2.EDI_COLOR_CODE" _
                            & " FROM EDT850TC, EDT850T2" _
                            & " WHERE EDT850TC.EDI_DOC_SEQ_NO = EDT850T2.EDI_DOC_SEQ_NO" _
                            & " AND EDT850TC.EDI_DTL_SEQ = EDT850T2.EDI_DTL_SEQ" _
                            & " AND EDT850TC.EDI_CMMNT = 'NEWGISTICS PREPAID LABEL'" _
                            & " AND EDT850TC.EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'"

                        ' EDT850TC.EDI_CMT_SEQ

                        Fill_Records("QVCPack", String.Empty, False, ASCMAIN1.sql)
                    Next

                    For Each row As DataRow In ASCDATA1.SelectDistinct("QVCPack", New String() {"CARTON_NO"}).Select("", "CARTON_NO")
                        Dim CARTON_NO As Int32 = row.Item("CARTON_NO")

                        Dim CARTON_LNO As Int16 = 1
                        For Each rowQVC As DataRow In dst.Tables("QVCPack").Select("CARTON_NO = " & CARTON_NO, "CARTON_NO, CARTON_LNO")
                            rowQVC.Item("CARTON_LNO") = CARTON_LNO
                            CARTON_LNO += 1
                        Next
                    Next

                    Sort_grdColumns(grdQVCPack, "CARTON_NO,CARTON_LNO")
                End If
            Catch ex As Exception
                dst.Tables("QVCPack").Rows.Clear()
            End Try
        End If

        'requiresSignature
        If ASCMAIN1.CLIENT = "RGI" AndAlso CUST_CODE = RegencyHomeDepotCustCode Then
            If dst.Tables.Contains("EDT850T1") Then
                If dst.Tables("EDT850T1").Select("EDI_SHIP_SVC_LEVEL = 'ET'").Length > 0 Then
                    requiresSignature = True
                End If
            End If
        End If
    End Sub

