    Private Sub SaveShipAddress(ByVal prefix As String)

        'SHIP_TO_CODE, FRT_3PY_CODE
        Dim CUST_CODE As String = Absx1.txtFor("CUST_CODE").Text
        Dim CUST_ADDR_CODE As String = Absx1.txtFor(prefix & "_CODE").Text
        CUST_ADDR_CODE = CUST_ADDR_CODE.ToUpper.Trim

        If CUST_ADDR_CODE.Length = 0 Then
            MessageBox.Show("You must provide an Address Code.", "Add Address", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        Absx1.txtFor(prefix & "_CODE").Text = CUST_ADDR_CODE

        Dim CUST_ADDR_TYPE As String = String.Empty
        Select Case prefix
            Case "SHIP_TO"
                CUST_ADDR_TYPE = "ST"
            Case "FRT_3PY"
                CUST_ADDR_TYPE = "3P"
            Case Else
                MessageBox.Show("Unable to determine the Address Type.", "Add Address", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
        End Select

        ' Clean up data Look for minimum requirements
        For Each suffix As String In New String() {"NAME", "ADDR1", "ADDR2", "CITY", "STATE", "ZIP_CODE", "COUNTRY", "CONTACT"}
            Absx1.txtFor(prefix & "_" & suffix).Text = Absx1.txtFor(prefix & "_" & suffix).Text.Trim
        Next

        Absx1.txtFor(prefix & "_" & "NAME").Text = StrConv(Absx1.txtFor(prefix & "_" & "NAME").Text, VbStrConv.ProperCase)
        Absx1.txtFor(prefix & "_" & "ADDR1").Text = StrConv(Absx1.txtFor(prefix & "_" & "ADDR1").Text, VbStrConv.ProperCase)
        Absx1.txtFor(prefix & "_" & "ADDR2").Text = StrConv(Absx1.txtFor(prefix & "_" & "ADDR2").Text, VbStrConv.ProperCase)
        Absx1.txtFor(prefix & "_" & "CITY").Text = StrConv(Absx1.txtFor(prefix & "_" & "CITY").Text, VbStrConv.ProperCase)
        Absx1.txtFor(prefix & "_" & "STATE").Text = Absx1.txtFor(prefix & "_" & "STATE").Text.ToUpper
        Absx1.txtFor(prefix & "_" & "COUNTRY").Text = Absx1.txtFor(prefix & "_" & "COUNTRY").Text.ToUpper
        Absx1.txtFor(prefix & "_" & "CONTACT").Text = StrConv(Absx1.txtFor(prefix & "_" & "CONTACT").Text, VbStrConv.ProperCase)

        If Absx1.txtFor(prefix & "_" & "NAME").TextLength = 0 _
            OrElse Absx1.txtFor(prefix & "_" & "ADDR1").TextLength = 0 _
            OrElse Absx1.txtFor(prefix & "_" & "CITY").TextLength = 0 _
            OrElse Absx1.txtFor(prefix & "_" & "STATE").TextLength = 0 _
            OrElse Absx1.txtFor(prefix & "_" & "ZIP_CODE").TextLength = 0 Then
            MessageBox.Show("Name, Address Line 1, City, State and Zip Code are required.", "Add Address", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        Fill_Records("SOTSHIPA", New Object() {CUST_CODE, CUST_ADDR_TYPE, CUST_ADDR_CODE})
        If dst.Tables("SOTSHIPA").Rows.Count > 0 Then
            If MessageBox.Show("Do you want to Update the existing address data with the data on the screen?", "Add Address",
                                 MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                Exit Sub
            End If
        End If

        Dim rowSOTSHIPA As DataRow = Nothing
        If dst.Tables("SOTSHIPA").Rows.Count = 0 Then
            rowSOTSHIPA = dst.Tables("SOTSHIPA").NewRow
            rowSOTSHIPA.Item("CUST_CODE") = CUST_CODE
            rowSOTSHIPA.Item("CUST_ADDR_TYPE") = CUST_ADDR_TYPE
            rowSOTSHIPA.Item("CUST_ADDR_CODE") = CUST_ADDR_CODE
            dst.Tables("SOTSHIPA").Rows.Add(rowSOTSHIPA)
        Else
            rowSOTSHIPA = dst.Tables("SOTSHIPA").Rows(0)
        End If

        rowSOTSHIPA.Item("CUST_NAME") = Absx1.txtFor(prefix & "_" & "NAME").Text
        rowSOTSHIPA.Item("CUST_ADDR1") = Absx1.txtFor(prefix & "_" & "ADDR1").Text
        rowSOTSHIPA.Item("CUST_ADDR2") = Absx1.txtFor(prefix & "_" & "ADDR2").Text
        rowSOTSHIPA.Item("CUST_CITY") = Absx1.txtFor(prefix & "_" & "CITY").Text
        rowSOTSHIPA.Item("CUST_STATE") = Absx1.txtFor(prefix & "_" & "STATE").Text
        rowSOTSHIPA.Item("CUST_ZIP_CODE") = Absx1.txtFor(prefix & "_" & "ZIP_CODE").Text
        rowSOTSHIPA.Item("CUST_COUNTRY") = Absx1.txtFor(prefix & "_" & "COUNTRY").Text
        rowSOTSHIPA.Item("CUST_CONTACT") = Absx1.txtFor(prefix & "_" & "CONTACT").Text
        rowSOTSHIPA.Item("CUST_PHONE") = Absx1.medFor(prefix & "_" & "PHONE").Text

        Try
            BeginTrans()
            Update_Record_TDA("SOTSHIPA")
            CommitTrans("Address Updated")
        Catch ex As Exception
            Rollback(ex.Message)
        End Try

    End Sub

    Private Sub RefreshBolShipments(ByVal refreshOrders As Boolean)

        ' Never allow the user to combine Ecommerce shipments.
        ' 5/29/2018 - Regency Ecommerce
        If isEcommProcessing OrElse isRegencyTransferShipment Then
            dst.Tables("SOTSHIPX_BOL").Rows.Clear()
            Exit Sub
        End If

        If Not processingMasterBOL Then
            dst.Tables("SOTSHIPX_BOL").Rows.Clear()
        End If

        If dst.Tables("SOTSHIP1").Rows.Count > 0 Then
            Dim WHSE_CODE As String = dst.Tables("SOTSHIP1").Rows(0).Item("WHSE_CODE") & String.Empty
            Dim CUST_CODE As String = dst.Tables("SOTSHIP1").Rows(0).Item("CUST_CODE") & String.Empty
            Dim SHIP_ADDR_TYPE As String = dst.Tables("SOTSHIP1").Rows(0).Item("SHIP_ADDR_TYPE") & String.Empty
            Dim SHIP_ADDR_CODE As String = dst.Tables("SOTSHIP1").Rows(0).Item("SHIP_ADDR_CODE") & String.Empty

            If WHSE_CODE.Length > 0 AndAlso CUST_CODE.Length > 0 Then

                Dim SHIP_BOL_NO_CONS As String = dst.Tables("SOTSHIP1").Compute("MAX(SHIP_BOL_NO_CONS)", "") & String.Empty

                If ConsolidatedPOProcessing Then
                    ' No merging shipments for a Consolidated shipment
                    dst.Tables("SOTSHIPX_BOL").Rows.Clear()
                ElseIf SHIP_BOL_NO_CONS.Length > 0 AndAlso Not processingMasterBOL Then
                    ' No merging shipments for a Consolidated shipment
                    ' dst.Tables("SOTSHIPX_BOL").Rows.Clear()
                    ASCMAIN1.sql = sqlSOTSHIPX_BOL & " and SOTSHIP1.SHIP_BOL_NO_CONS IS NOT NULL"
                    ASCMAIN1.sql = ASCMAIN1.sql.Replace(":PARM1", "'" & WHSE_CODE & "'")
                    ASCMAIN1.sql = ASCMAIN1.sql.Replace(":PARM2", "'" & CUST_CODE & "'")
                    ASCMAIN1.sql = ASCMAIN1.sql.Replace(":PARM3", "'" & Absx1.txtFor("BILL_OF_LADING_NO").Text & "'")

                    Fill_Records("SOTSHIPX_BOL", String.Empty, True, ASCMAIN1.sql)

                ElseIf ASCMAIN1.CLIENT = "RGI" OrElse ASCMAIN1.CLIENT = "VAN" AndAlso Not processingMasterBOL Then
                    Fill_Records("SOTSHIPX_BOL", New Object() {WHSE_CODE, CUST_CODE})
                ElseIf Not processingMasterBOL Then
                    Fill_Records("SOTSHIPX_BOL", New Object() {WHSE_CODE, CUST_CODE, Absx1.txtFor("BILL_OF_LADING_NO").Text})
                End If

                ' 6/24/2019
                If Not ConsolidatedPOProcessing AndAlso Not processingMasterBOL Then
                    For Each row As DataRow In dst.Tables("ARTCUSTM").Select("CUST_CODE = '" & CUST_CODE & "' AND CUST_CODE_M <> '" & CUST_CODE & "'")
                        If ASCMAIN1.CLIENT = "RGI" OrElse ASCMAIN1.CLIENT = "VAN" Then
                            Fill_Records("SOTSHIPX_BOL", New Object() {WHSE_CODE, row.Item("CUST_CODE_M")}, False)
                        Else
                            Fill_Records("SOTSHIPX_BOL", New Object() {WHSE_CODE, row.Item("CUST_CODE_M"), Absx1.txtFor("BILL_OF_LADING_NO").Text}, False)
                        End If
                    Next
                End If
            End If

            For Each row As DataRow In dst.Tables("SOTSHIPX_BOL").Rows
                row.Item("Selected") = "0"
            Next

            If dst.Tables("SOTSHIPX_BOL").Rows.Count > 0 Then
                For Each row As DataRow In dst.Tables("SOTSHIP1").Select("")
                    If dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & row.Item("SHIP_BOL_NO") & "'").Length > 0 Then
                        dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & row.Item("SHIP_BOL_NO") & "'")(0).Item("Selected") = "1"
                    End If
                Next
            End If

            dst.Tables("SOTSHIPX_BOL").AcceptChanges()

            If refreshOrders Then
                'Dim SHIP_BOL_NO As String = String.Empty
                Dim SHIP_BOL_NOs As New List(Of String)

                If SOTSHIP1_ALL = "" Then
                    ASCMAIN1.sql = "Select SHIP_BOL_NO from SOTSHIP1 where ROWNUM < 1"
                    SOTSHIP1_ALL = ASCMAIN1.Temp_Table
                    Create_TDA(dst.Tables.Add("SOTSHIP1_ALL"), SOTSHIP1_ALL, "*")
                End If
                dst.Tables("SOTSHIP1_ALL").Rows.Clear()

                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select()
                    Dim SHIP_BOL_NO As String = rowSOTSHIP1.Item("SHIP_BOL_NO")
                    'SHIP_BOL_NO &= ", '" & SHIP_BOL_NO & "'"
                    SHIP_BOL_NOs.Add(SHIP_BOL_NO)
                    dst.Tables("SOTSHIP1_ALL").Rows.Add(New String() {SHIP_BOL_NO})
                Next
                ASCDATA1.ExecuteSQL("Delete from " & SOTSHIP1_ALL)
                Update_Record_TDA("SOTSHIP1_ALL")

                'SHIP_BOL_NO = SHIP_BOL_NO.Substring(1).Trim
                'SHIP_BOL_NO = "(" & SHIP_BOL_NO & ")"

                'ASCMAIN1.sql = "Select * from SOTORDR1 where ORDR_NO in" & vbCrLf _
                '    & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO IN " & SHIP_BOL_NO & ")"
                ASCMAIN1.sql = "Select * from SOTORDR1 where ORDR_NO in" & vbCrLf _
                    & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP1_ALL & "))"
                Fill_Records("SOTORDR1", String.Empty, False, ASCMAIN1.sql)

                ASCMAIN1.sql = "Select SOTORDR2.*, SOTORDR2.ORDR_UNIT_PRICE ORDR_UNIT_PRICE_ORIG from SOTORDR2 where ORDR_NO in" & vbCrLf _
                  & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP1_ALL & "))"
                Fill_Records("SOTORDR2", String.Empty, False, ASCMAIN1.sql)

                ASCMAIN1.sql = "SELECT * FROM SOTORDR9 WHERE ORDR_NO IN ( Select ORDR_NO from SOTORDR1 where ORDR_NO in" & vbCrLf _
                             & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP1_ALL & ")))"
                Fill_Records("SOTORDR9", String.Empty, False, ASCMAIN1.sql)

                FillEDT850Tables(SOTSHIP1_ALL, False)

                If (Not ScreenMode AndAlso Not processingMasterBOL AndAlso dst.Tables("SOTSHIP2").Rows.Count = 0) _
                     OrElse (ScreenMode AndAlso Not processingMasterBOL) Then

                    For Each shipBolNo As String In shipBolNoList
                        For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & shipBolNo & "'")
                            For Each rowSOTORDR1 As DataRow In dst.Tables("SOTORDR1").Select("ORDR_NO = '" & rowSOTPICK1.Item("ORDR_NO") & "'")
                                rowSOTORDR1.Item("ORDR_CUST_PO") = (rowSOTORDR1.Item("ORDR_CUST_PO") & String.Empty).ToString.Trim
                                If rowSOTORDR1.Item("ORDR_CUST_PO").ToString.Length = 0 Then
                                    Continue For
                                End If
                                CreateSotship2Entry(rowSOTORDR1.Item("ORDR_CUST_PO"))
                            Next
                        Next
                    Next
                ElseIf processingMasterBOL Then
                    For Each shipBolNo As String In SHIP_BOL_NOs ' SHIP_BOL_NO.Split(",")
                        shipBolNo = shipBolNo.Replace("'", "").Replace("(", "").Replace(")", "")
                        If dst.Tables("SOTSHIP2").Select("SHIP_BOL_NO = '" & shipBolNo & "'").Length = 0 Then
                            ASCMAIN1.sql = "SELECT * FROM SOTSHIP2 WHERE SHIP_BOL_NO IN ('" & shipBolNo & "')"
                            Fill_Records("SOTSHIP2", String.Empty, False, ASCMAIN1.sql)
                        End If
                    Next
                End If
            End If
        End If

        Sort_grdColumns(grdSOTSHIPX_BOL, "SHIP_BOL_NO")
    End Sub

    Private Sub RefreshMasterBol()

        Dim listSelectedBols As New List(Of String)
        Dim rowSOTSHIPS As DataRow = Nothing

        For Each rowSOTSHIPS In dst.Tables("SOTSHIPS").Select("SEL = '1'")
            listSelectedBols.Add(rowSOTSHIPS.Item("BOL_NO") & String.Empty)
        Next

        Load_SOTSHIPS()

        For Each rowSOTSHIPS In dst.Tables("SOTSHIPS").Rows
            rowSOTSHIPS.Item("SEL") = "0"
            If listSelectedBols.Contains(rowSOTSHIPS.Item("BOL_NO") & String.Empty) Then
                rowSOTSHIPS.Item("SEL") = "1"
            End If
        Next

        SetUpMasterBolScreen()

    End Sub

    Private Sub RemoveShipmentFromBol()

        Try
            Me.Cursor = Cursors.WaitCursor
            ASCMAIN1.Progress(String.Empty, String.Empty)

            Dim removeConsolidatedShipments As Boolean = False
            Dim evalList = New List(Of String)(shipBolNoList)

            ' See if the user selected part of a consolidated shipment.
            For Each SHIP_BOL_NO As String In evalList
                If dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length > 0 Then
                    Dim SHIP_BOL_NO_CONSx As String = dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("SHIP_BOL_NO_CONS") & String.Empty
                    If SHIP_BOL_NO_CONSx.Length > 0 Then
                        For Each row As DataRow In dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO_CONS = '" & SHIP_BOL_NO_CONSx & "' And ISNULL(Selected, '0') = '1'")
                            If Not shipBolNoList.Contains(row.Item("SHIP_BOL_NO")) Then
                                shipBolNoList.Add(row.Item("SHIP_BOL_NO"))
                                removeConsolidatedShipments = True
                            End If
                        Next
                    End If
                End If
            Next

            If removeConsolidatedShipments Then
                MessageBox.Show("At least one of the selected shipments belongs to a Consolidated Shipment; therefire, all shipments belonging to a Consolidated Shipment will be Removed.", "Remove Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If

            Dim numSelected As Int16 = 0
            For Each SHIP_BOL_NO As String In shipBolNoList
                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length > 0 Then
                    If SHIP_BOL_NO_CONS.Length > 0 Then
                        If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("SHIP_BOL_NO_CONS") & String.Empty = SHIP_BOL_NO_CONS Then
                            MessageBox.Show("You cannot remove shipment (" & SHIP_BOL_NO & ") from the list. It belongs to this consolidated Shipment.", "Remove Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                            Exit Sub
                        End If
                    End If
                    numSelected += 1
                End If
            Next

            If numSelected = 0 Then
                MessageBox.Show("There are no selected Shipment to Remove from the Bill of Lading.", "Remove Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            Else
                If MessageBox.Show("Do you want to Remove the " & numSelected & " selected shipment(s) from the Bill of Lading?", "Remove Shipment", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If
            End If

            For Each SHIP_BOL_NO As String In shipBolNoList
                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length = 0 Then
                    Continue For
                End If

                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO <> '" & SHIP_BOL_NO & "'").Length = 0 Then
                    MessageBox.Show("The Bill of Lading requires at least one shipment.", "Remove Shipment", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Exit For
                End If

                Me.Cursor = Cursors.WaitCursor
                CleanUptables(SHIP_BOL_NO)
            Next

        Catch ex As Exception
            MessageBox.Show(ex.Message)
        Finally
            Me.Cursor = Cursors.Default
            ASCMAIN1.Progress(String.Empty, String.Empty)
        End Try

        RefreshBolShipments(True)
        MessageBox.Show("Shipment(s) Removed from BOL.", "Remove Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)

    End Sub

    Private Sub RemoveBolfromMaster(ByVal BOL_NO As String)

        If dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "'").Length = 0 Then
            MessageBox.Show("Cannot locate the selected Bill of Lading.", "Remove BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        If dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "' AND SEL <> '1'").Length > 0 Then
            MessageBox.Show("The selected BOL does NOT belong to this Master Bill of Lading.", "Remove BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        If dst.Tables("SOTSHIPS").Select("BOL_NO <> '" & BOL_NO & "' AND SEL = '1'").Length = 0 Then
            MessageBox.Show("The Bill of Lading requires at least one Bill of Lading.", "Remove BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        If MessageBox.Show("Do you want to remove Bill of Lading (" & BOL_NO & ") from this Master Bill of Lading?",
                            "Bill of Lading", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
            Exit Sub
        End If

        Me.Cursor = Cursors.WaitCursor

        CleanUpBOLtables(BOL_NO)
        dst.Tables("SOTSHIPS").Select($"BOL_NO = '{BOL_NO}'")(0).Item("SEL") = "0"
        dst.Tables("SOTSHIPS").Select($"BOL_NO = '{BOL_NO}'")(0).Item("MASTER_BOL_NO") = ""

        ' removed on 12/03/2021
        'RefreshBolShipments(True)

        Me.Cursor = Cursors.Default

        MessageBox.Show("Bill of Lading Removed from Master.", "Remove BOL", MessageBoxButtons.OK, MessageBoxIcon.Information)
    End Sub

    Private Sub CleanUptables(ByVal SHIP_BOL_NO As String)

        ' Modified on 12/03/2021

        EnforceConstraints(False)

        For Each tableName As String In processingTables
            dst.Tables(tableName).AcceptChanges()
        Next

        ' remove rows from all the tables
        'CascadeRelationDeleteRule()
        'For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
        '    rowSOTSHIP1.Delete()
        'Next

        '' remove rows from all the tables
        For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")

            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                Dim PICK_NO As String = rowSOTPICK1.Item("PICK_NO")
                Dim ORDR_NO As String = rowSOTPICK1.Item("ORDR_NO")

                For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "'")
                    rowSOTPICK2.Delete()
                Next

                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'")
                    For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select("CART_NO = '" & rowSOTCART1.Item("CART_NO") & "'")
                        rowSOTCART2.Delete()
                    Next
                    rowSOTCART1.Delete()
                Next

                For Each rowSOTCARTX As DataRow In dst.Tables("SOTCARTX").Select("PICK_NO = '" & PICK_NO & "'")
                    rowSOTCARTX.Delete()
                Next

                ' It may be the case there is more than one Pick Ticket in memory that points to the same sales order
                If dst.Tables("SOTPICK1").Select($"ORDR_NO = '{ORDR_NO}' AND PICK_NO <> '{PICK_NO}'").Length = 0 Then
                    For Each rowSOTORDR1 As DataRow In dst.Tables("SOTORDR1").Select("ORDR_NO = '" & ORDR_NO & "'")
                        For Each rowSOTORDR2 As DataRow In dst.Tables("SOTORDR2").Select("ORDR_NO = '" & ORDR_NO & "'")
                            rowSOTORDR2.Delete()
                        Next

                        For Each rowSOTORDR9 As DataRow In dst.Tables("SOTORDR9").Select("ORDR_NO = '" & ORDR_NO & "'")
                            rowSOTORDR9.Delete()
                        Next

                        rowSOTORDR1.Delete()
                    Next
                End If

                rowSOTPICK1.Delete()
            Next
            rowSOTSHIP1.Delete()
        Next

        Dim ORDR_CUST_PO As String = String.Empty
        For Each rowSOTSHIP2 As DataRow In dst.Tables("SOTSHIP2").Select("")
            ORDR_CUST_PO = rowSOTSHIP2.Item("ORDR_CUST_PO") & String.Empty
            If dst.Tables("SOTORDR1").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO & "'").Length = 0 Then
                rowSOTSHIP2.Delete()
            End If
        Next

        For Each tableName As String In processingTables
            dst.Tables(tableName).AcceptChanges()
        Next

        EnforceConstraints(True)
    End Sub

    Private Sub CascadeRelationDeleteRule()

        For Each relationship As String In New String() {"SOTSHIP1_SOTPICK1", "SOTPICK1_SOTPICK2", "SOTPICK1_SOTCART1", "SOTPICK1_SOTCARTX", "SOTCART1_SOTCART2", "SOTPICK1_SOTORDR1", "SOTORDR1_SOTORDR2", "SOTORDR1_SOTORDR9"}
            If Not dst.Relations.Contains(relationship) Then
                Select Case relationship
                    Case "SOTSHIP1_SOTPICK1"
                        Create_Relation("SOTSHIP1", "SOTPICK1", "SHIP_BOL_NO")
                    Case "SOTPICK1_SOTPICK2"
                        Create_Relation("SOTPICK1", "SOTPICK2", "PICK_NO")
                    Case "SOTPICK1_SOTCART1"
                        Create_Relation("SOTPICK1", "SOTCART1", "PICK_NO")
                    Case "SOTPICK1_SOTCARTX"
                        Create_Relation("SOTPICK1", "SOTCARTX", "PICK_NO")
                    Case "SOTCART1_SOTCART2"
                        Create_Relation("SOTCART1", "SOTCART2", "CART_NO")
                    Case "SOTPICK1_SOTORDR1"
                        Create_Relation("SOTPICK1", "SOTORDR1", "ORDR_NO")
                    Case "SOTORDR1_SOTORDR2"
                        Create_Relation("SOTORDR1", "SOTORDR2", "ORDR_NO")
                    Case "SOTORDR1_SOTORDR9"
                        Create_Relation("SOTORDR1", "SOTORDR9", "ORDR_NO")
                End Select
            End If
        Next

        dst.Relations("SOTSHIP1_SOTPICK1").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTPICK1_SOTPICK2").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTPICK1_SOTCART1").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTPICK1_SOTCARTX").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTCART1_SOTCART2").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTPICK1_SOTORDR1").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTORDR1_SOTORDR2").ChildKeyConstraint.DeleteRule = Rule.Cascade
        dst.Relations("SOTORDR1_SOTORDR9").ChildKeyConstraint.DeleteRule = Rule.Cascade

    End Sub

    Private Sub CleanUpBOLtables(ByVal BOL_NO As String)

        EnforceConstraints(False)

        dst.Tables("SOTSHIPS").Select($"BOL_NO = '{BOL_NO}'")(0).Item("SEL") = "0"

        For Each tableName As String In processingTables
            dst.Tables(tableName).AcceptChanges()
        Next

        For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'")
            CleanUptables(rowSOTSHIP1.Item("SHIP_BOL_NO"))
        Next

        EnforceConstraints(True)
    End Sub

    Private Sub AddShipmentToBol()

        Try
            'prevent not complete p2l shipments from being inducted when open cartons
            Me.Cursor = Cursors.WaitCursor
            ASCMAIN1.Progress(String.Empty, String.Empty)

            Dim addedConsolidatedShipments As Boolean = False
            Dim evalList = New List(Of String)(shipBolNoList)

            ' See if the user selected part of a consolidated shipment.
            For Each SHIP_BOL_NO As String In evalList
                If dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length > 0 Then
                    Dim SHIP_BOL_NO_CONS As String = dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("SHIP_BOL_NO_CONS") & String.Empty
                    If SHIP_BOL_NO_CONS.Length > 0 Then
                        For Each row As DataRow In dst.Tables("SOTSHIPX_BOL").Select("SHIP_BOL_NO_CONS = '" & SHIP_BOL_NO_CONS & "' And ISNULL(Selected, '0') = '0'")
                            If Not shipBolNoList.Contains(row.Item("SHIP_BOL_NO")) Then
                                shipBolNoList.Add(row.Item("SHIP_BOL_NO"))
                                addedConsolidatedShipments = True
                            End If
                        Next
                    End If
                End If
            Next

            If addedConsolidatedShipments Then
                MessageBox.Show("At least one of the selected shipments belongs to a Consolidated Shipment; therefore, all shipments belonging to a Consolidated Shipment will be Added.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If

            Dim numSelected As Int16 = 0
            For Each SHIP_BOL_NO As String In shipBolNoList
                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length = 0 Then
                    numSelected += 1
                    If ASCMAIN1.CLIENT = "VAN" Then
                        'no need to check previously checked SBN's
                        ASCMAIN1.sql = "Select count(1) from SOTPICK1, SOTCART1, WHTWAVE3" & vbCrLf _
                            & " Where SOTPICK1.PICK_NO =  SOTCART1.PICK_NO" & vbCrLf _
                            & " And SOTPICK1.SHIP_BOL_NO =  WHTWAVE3.SHIP_BOL_NO" & vbCrLf _
                            & " And SOTCART1.CART_PACKER is null" & vbCrLf _
                            & " And WHTWAVE3.P2L_SHIP_STATUS IS NOT NULL" & vbCrLf _
                            & " And SOTPICK1.SHIP_BOL_NO = :PARM1"
                        If ASCDATA1.GetDataValue(ASCMAIN1.sql, "V", SHIP_BOL_NO) <> "0" Then
                            MessageBox.Show($"This shipment {SHIP_BOL_NO} has P2L cartons that have not been picked yet", "Cannot Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                            Exit Sub
                        End If
                    End If
                End If
            Next

            If numSelected = 0 Then
                MessageBox.Show("There are no selected Shipment(s) to Add to the Bill of Lading.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            Else
                If MessageBox.Show("Do you want to Add the " & numSelected & " selected shipment(s) to the Bill of Lading?", "Add Shipment", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If
            End If

            Dim shipBolNoToUseList As New List(Of String)

            For Each SHIP_BOL_NO As String In shipBolNoList
                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length > 0 Then
                    'MessageBox.Show("The selected Shipment already belongs to this Bill of Lading.", "Bill of Lading", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    'Exit Sub
                    Continue For
                End If

                ASCMAIN1.Progress("Adding Shipment", SHIP_BOL_NO)

                'If MessageBox.Show("Do you want to add shipment (" & SHIP_BOL_NO & ") to this Bill of Lading?", _
                '            "Bill of Lading", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                '    Exit Sub
                'End If

                Dim rowSOTSHIP1 As DataRow = ASCDATA1.GetDataRow("SELECT * FROM SOTSHIP1 WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")

                If rowSOTSHIP1 Is Nothing Then
                    MessageBox.Show("Cannot locate shipment: " & SHIP_BOL_NO & ".", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Continue For
                End If

                If Not processingMasterBOL Then
                    If Not ASCMAIN1.Logical_Lock("SOTSHIP1", SHIP_BOL_NO, , , False, 4) Then Continue For
                    If Not ASCMAIN1.Logical_Lock("SOTORDR0", rowSOTSHIP1.Item("ORDR_GROUP_NO"), , , False, 4) Then Continue For
                End If

                rowSOTSHIP1 = ASCDATA1.GetDataRow("SELECT * FROM SOTSHIP1 WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")

                If rowSOTSHIP1.Item("FRT_TERMS") & String.Empty <> Absx1.txtFor("FRT_TERMS").Text Then
                    If MessageBox.Show("Shipment: " & SHIP_BOL_NO & " has Freight Terms " & rowSOTSHIP1.Item("FRT_TERMS") & ". Do you still want to add this shipment?", "Add Shipment", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                        Continue For
                    End If
                End If

                If rowSOTSHIP1.Item("SHIP_STATUS") & String.Empty <> "P" Then
                    MessageBox.Show("Shipment: " & SHIP_BOL_NO & " is no longer in Pick.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Continue For
                End If

                If rowSOTSHIP1.Item("WHSE_CODE") & String.Empty <> Absx1.txtFor("WHSE_CODE").Text Then
                    MessageBox.Show("Shipment: " & SHIP_BOL_NO & " does not have the proper Warehouse Code.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
                    Continue For
                End If

                If ASCMAIN1.CLIENT = "RGI" AndAlso Not InquiryMode Then
                    Dim tblSOTPICK1 As DataTable = ASCDATA1.GetDataTable("SELECT * FROM SOTPICK1 WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "' AND PICK_STATUS = 'P' AND NVL(PACK_STATUS, '*') <> 'F'")
                    If tblSOTPICK1.Rows.Count > 0 Then

                        If MessageBox.Show("Shipment: " & SHIP_BOL_NO & " has " & tblSOTPICK1.Rows.Count & " pick tickets where the Pack Status is not Finalized. Do you want to Continue?",
                                "Add Shipment", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                            Continue For
                        End If
                    End If
                End If

                shipBolNoToUseList.Add(SHIP_BOL_NO)
            Next

            If shipBolNoToUseList.Count = 0 Then
                Exit Sub
            End If

            Dim inListSHIP_BOL_NO As String = "('" & String.Join("', '", shipBolNoToUseList.ToArray) & "')"

            EnforceConstraints(False)

            ' Need to load the Shipment data 
            ASCMAIN1.sql = sqlSOTSHIPX
            ASCMAIN1.sql &= " and SHIP_BOL_NO in " & inListSHIP_BOL_NO
            Fill_Records("SOTSHIP1", String.Empty, False, ASCMAIN1.sql)

            For Each SHIP_BOL_NO As String In shipBolNoToUseList
                dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("BILL_OF_LADING_NO") = BOL_NO
            Next

            ASCMAIN1.sql = sqlSOTPICK1 & vbCrLf _
                & " where SOTORDR1.ORDR_NO = SOTPICK1.ORDR_NO" & vbCrLf _
                & " and SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                & " and SOTSHIP1.SHIP_BOL_NO in " & inListSHIP_BOL_NO
            Fill_Records("SOTPICK1", "", False, ASCMAIN1.sql)

            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                rowSOTPICK1.Item("PICK_FREIGHT_ORIG") = rowSOTPICK1.Item("PICK_FREIGHT")
            Next

            If Not processingMasterBOL Then
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                    rowSOTPICK1.Item("BILL_OF_LADING_NO") = BOL_NO
                Next
            End If

            ToggleDataTableExpressions(False)

            For Each SHIP_BOL_NO As String In shipBolNoToUseList
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'", "PICK_NO")
                    rowSOTPICK1.Item("SELECTED") = "1"

                    If Not processingMasterBOL Then
                        rowSOTPICK1.Item("BILL_OF_LADING_NO") = BOL_NO
                    End If
                Next
            Next

            ASCMAIN1.sql = sqlSOTPICK2 & vbCrLf _
                & " where SOTPICK2.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                & "   and SOTORDR1.ORDR_NO = SOTORDR2.ORDR_NO" & vbCrLf _
                & "   and SOTORDR2.ORDR_NO = SOTPICK2.ORDR_NO" & vbCrLf _
                & "   and SOTORDR2.ORDR_LNO = SOTPICK2.ORDR_LNO" & vbCrLf _
                & "   and SOTPICK1.SHIP_BOL_NO = SOTSHIP1.SHIP_BOL_NO" & vbCrLf _
                & "   and SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE" & vbCrLf _
                & "   and ICTCOLR1.COLOR_CODE (+) = SOTORDR2.COLOR_CODE" & vbCrLf _
                & "   and SOTORDR2.STYLE_CODE = ICTSTYC1.STYLE_CODE (+) AND SOTORDR2.COLOR_CODE = ICTSTYC1.COLOR_CODE (+)" _
                & " and  SOTPICK2.PICK_NO IN (SELECT PICK_NO FROM SOTPICK1 WHERE SHIP_BOL_NO IN " & inListSHIP_BOL_NO & ")"
            Fill_Records("SOTPICK2", "", False, ASCMAIN1.sql)

            ASCMAIN1.sql = "Select SOTCART1.*, SOTPICK1.SHIP_BOL_NO " _
                & " FROM SOTCART1, SOTPICK1 " _
                & " WHERE SOTCART1.PICK_NO = SOTPICK1.PICK_NO AND SOTPICK1.PICK_NO IN (SELECT PICK_NO FROM SOTPICK1 WHERE SHIP_BOL_NO IN " & inListSHIP_BOL_NO & ")"
            Fill_Records("SOTCART1", "", False, ASCMAIN1.sql)


            Dim CART_SEQ As Int32 = 0
            For Each SHIP_BOL_NO As String In shipBolNoToUseList
                CART_SEQ = 0
                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                    Dim CART_NO As String = rowSOTCART1.Item("CART_NO")

                    If Not processingMasterBOL Then
                        ' default to packaging code 31 - Our package
                        rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
                        rowSOTCART1.Item("CART_SEQ") = Val(dst.Tables("SOTCART1").Compute("MAX(CART_SEQ)", "") & String.Empty) + 1
                        'CART_SEQ += 1
                        If edi_order And edi856_customer Then
                            rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")
                        ElseIf ASCMAIN1.CLIENT = "RGI" Then

                            If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                                rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")
                            End If

                            If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                                rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = 1
                            End If

                            rowSOTCART1.Item("REFERENCE1") = Val(rowSOTCART1.Item("PICK_NO") & String.Empty)
                            rowSOTCART1.Item("REFERENCE2") = rowSOTCART1.Item("CART_NO") & String.Empty

                            ' Default 
                            If rowSOTCART1.Item("PKG_CODE") & String.Empty = String.Empty Then
                                rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE
                            End If

                            Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(rowSOTCART1.Item("PKG_CODE") & String.Empty)
                            If rowWHTPKGM1 IsNot Nothing Then
                                rowSOTCART1.Item("PKG_L") = Val(rowWHTPKGM1.Item("PKG_L") & String.Empty)
                                rowSOTCART1.Item("PKG_H") = Val(rowWHTPKGM1.Item("PKG_H") & String.Empty)
                                rowSOTCART1.Item("PKG_W") = Val(rowWHTPKGM1.Item("PKG_W") & String.Empty)
                            End If
                        End If
                    End If

                    ASCMAIN1.sql = "Select SOTCART2.*, SOTCART1.PICK_NO, SOTCART2.QTY_PACKED QTY_PACKED_ORIG" & vbCrLf _
                            & " from SOTCART1,SOTCART2" & vbCrLf _
                            & " where SOTCART1.CART_NO = SOTCART2.CART_NO" & vbCrLf _
                            & " and SOTCART2.CART_NO = '" & CART_NO & "'"
                    Fill_Records("SOTCART2", "", False, ASCMAIN1.sql)

                Next
            Next

            For Each SHIP_BOL_NO As String In shipBolNoToUseList
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                    If Val(rowSOTPICK1.Item("PICK_TOTAL_WGT") & String.Empty) = 0 Then
                        rowSOTPICK1.Item("PICK_TOTAL_WGT") = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & rowSOTPICK1.Item("PICK_NO") & "'") & String.Empty)
                    End If
                Next

                If Not select_from_3PL_list Then
                    SetPickQuantityConfirmed("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                End If
            Next

            ToggleDataTableExpressions(True)

            For Each tableName As String In processingTables
                dst.Tables(tableName).AcceptChanges()
            Next

            EnforceConstraints(True)

            RefreshBolShipments(True)

            SetupgrdSOTCART1_SHIP()

            If ASCMAIN1.CLIENT = "RGI" Then
                RGI_SORT_SOTPICK2()
            End If

            ' Hide / Display Curr Code column
            If dst.Tables("SOTPICK1").Select("CURR_CODE <> '" & ROWs("GLTPARM1").Item("GL_PARM_CURR_CODE") & "'").Length > 0 Then
                grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = False
            Else
                grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = True
            End If

            If Not processingMasterBOL Then
                MessageBox.Show("Shipment(s) Added to BOL.", "Add Shipment", MessageBoxButtons.OK, MessageBoxIcon.Information)
            End If
        Catch ex As Exception
            MessageBox.Show(ex.Message)

        Finally
            Me.Cursor = Cursors.Default
            ASCMAIN1.Progress(String.Empty, String.Empty)
        End Try

    End Sub

