    Private Sub SOFSHIPB_Shown(sender As Object, e As EventArgs) Handles Me.Shown
        If isEcommProcessing Then
            UltraExplorerBar1.Groups("Screen Control").Items("Select").Text = "Next Ecom Shipmemt"
        End If

        Dim rowASTPCTL1 As DataRow = ASCDATA1.GetDataRow("Select * from ASTPCTL1")
