    Private Sub grdSOTSHIP2_BeforeRowUpdate(sender As Object, e As Infragistics.Win.UltraWinGrid.CancelableRowEventArgs) Handles grdSOTSHIP2.BeforeRowUpdate

        EMsg = String.Empty

        e.Row.Cells("NMFC_CODE").Value = (e.Row.Cells("NMFC_CODE").Value & "").ToString.Trim.ToUpper
        e.Row.Cells("PKG_TYPE").Value = (e.Row.Cells("PKG_TYPE").Value & "").ToString.Trim.ToUpper
        e.Row.Cells("WEIGHT").Value = Val(e.Row.Cells("WEIGHT").Value & "")
        e.Row.Cells("PKG_QTY").Value = Val(e.Row.Cells("PKG_QTY").Value & "")

        If e.Row.Cells("NMFC_CODE").Value = String.Empty Then
            EMsg &= vbCr & "Missing NMFC Code."
        ElseIf dst.Tables("SOTNMFC1").Rows.Find(e.Row.Cells("NMFC_CODE").Value) Is Nothing Then
            EMsg &= vbCr & "Invalid NMFC Code."
        ElseIf e.Row.Cells("CLASS_CODE").Value & String.Empty = String.Empty Then
            Dim row As DataRow = dst.Tables("SOTNMFC1").Rows.Find(e.Row.Cells("NMFC_CODE").Value)
            e.Row.Cells("CLASS_CODE").Value = row.Item("NMFC_CLASS") & String.Empty
        End If

        If e.Row.Cells("PKG_TYPE").Value = String.Empty Then
            EMsg &= vbCr & "Invalid Package Type."
        End If

        Dim isConsolidated As Boolean = dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO_CONS IS NOT NULL").Length > 0

        If e.Row.Cells("WEIGHT").Value <= 0 AndAlso Not isConsolidated Then
            EMsg &= vbCr & "Invalid Weight."
        End If

        If e.Row.Cells("PKG_QTY").Value <= 0 AndAlso Not isConsolidated Then
            EMsg &= vbCr & "Invalid Quantity."
        End If

        If e.Row.Cells("SHIP_BOL_NO").Value & String.Empty = String.Empty Then
            Dim SHIP_BOL_NO As String = grdSOTPICK1.ActiveRow.Cells("SHIP_BOL_NO").Value & String.Empty
            e.Row.Cells("SHIP_BOL_NO").Value = SHIP_BOL_NO
            e.Row.Cells("SHIP_BOL_LNO").Value = Val(dst.Tables("SOTSHIP2").Compute("MAX(SHIP_BOL_LNO)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & String.Empty) + 1
        End If

        If EMsg.Length > 0 Then
            MessageBox.Show(EMsg, "Update Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
            e.Cancel = True
        End If

    End Sub

