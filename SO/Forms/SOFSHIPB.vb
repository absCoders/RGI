        Absx1.dteFor("SHIP_DATE_SHIPPED").Enabled = True
        Absx1.dteFor("INV_DATE").Enabled = True

        Absx1.txtFor("SHIP_BOL_NO").Visible = True
        lblORDR_NO.Visible = True

        Absx1.txtFor("ORDR_GROUP_NO").Visible = True
        lblGroupNo.Visible = True

