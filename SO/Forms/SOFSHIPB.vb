    Private Sub PrintBillOflading()

        Dim addedBOLs As New List(Of String)
        Dim MASTER_BOL_NO As String = String.Empty

        Try

            Dim isConsolidated As Boolean = dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO_CONS IS NOT NULL").Length > 0

            If isConsolidated AndAlso ASCMAIN1.CLIENT = "VAN" AndAlso CUST_CODE = "WALMART" AndAlso dst.Tables("SOTSHIP2").Select("PKG_QTY <= 0 OR WEIGHT <= 0").Length > 0 Then
                If MessageBox.Show("A Consolidated Walmart Shipment Commodity line cannot have a Qty or Weight with the value of 0. If they do, you may incur chargebacks." & Environment.NewLine & Environment.NewLine & "Do you want to print the bill of lading anyway?", "Print Bill Of Lading", MessageBoxButtons.YesNo, MessageBoxIcon.Warning) = Windows.Forms.DialogResult.No Then
                    Exit Sub
                End If
            End If

            Dim WHSE_CODE As String = dst.Tables("SOTSHIP1").Rows(0).Item("WHSE_CODE") & String.Empty
            'Fill_Records("ICTWHSE1", WHSE_CODE)
            'Fill_Records("ICTWHSE1", "NJE", False)

            Dim SHIP_BOL_NO As String = String.Empty
            Dim ORDR_CUST_PO As String = String.Empty
            Dim sql As String = String.Empty

            If Not processingMasterBOL AndAlso Not InquiryMode Then
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("", "", DataViewRowState.CurrentRows)
                    SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO") & String.Empty
                    rowSOTSHIP1.Item("BILL_OF_LADING_NO") = Absx1.txtFor("BILL_OF_LADING_NO").Text

                    If ASCMAIN1.CLIENT = "VAN" Then
                        ORDR_CUST_PO = rowSOTSHIP1.Item("ORDR_CUST_PO") & String.Empty

                        If dst.Tables("SOTSHIP2").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO & "'").Length = 0 Then
                            If ASCMAIN1.CLIENT = "VAN" AndAlso (CUST_CODE = "KMART" OrElse CUST_CODE = "SEARS") Then
                                Dim wkCustPO As String = ORDR_CUST_PO
                                If wkCustPO.Length > 5 Then
                                    wkCustPO = wkCustPO.Substring(5)

                                    For Each row As DataRow In dst.Tables("SOTSHIP2").Select("")
                                        If (row.Item("ORDR_CUST_PO") & String.Empty).ToString.EndsWith(wkCustPO) Then
                                            ORDR_CUST_PO = row.Item("ORDR_CUST_PO") & String.Empty
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If

                        rowSOTSHIP1.Item("SHIP_TOTAL_WGT") = Val(dst.Tables("SOTSHIP2").Compute("SUM(WEIGHT)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                        rowSOTSHIP1.Item("SHIP_CNT_CARTONS") = Val(dst.Tables("SOTSHIP2").Compute("SUM(PKG_QTY)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                    Else
                        rowSOTSHIP1.Item("SHIP_TOTAL_WGT") = Val(dst.Tables("SOTPICK1").Compute("SUM(PICK_TOTAL_WGT)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & "")
                        rowSOTSHIP1.Item("SHIP_CNT_CARTONS") = Val(dst.Tables("SOTPICK1").Compute("SUM(PICK_CNT_CARTONS)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & "")
                    End If
                Next
            End If

            If processingMasterBOL Then
                MASTER_BOL_NO = dst.Tables("SOTSHIPB").Select("MASTER_BOL = '1'")(0).Item("BOL_NO") & String.Empty
                For Each row As DataRow In dst.Tables("SOTSHIPS").Select("MASTER_BOL_NO = '" & MASTER_BOL_NO & "'")
                    Fill_Records("SOTSHIPB", row.Item("BOL_NO"), False, String.Empty)
                Next
            End If

            For Each rowSOTSHIPB As DataRow In dst.Tables("SOTSHIPB").Select("", "", DataViewRowState.CurrentRows)
                rowSOTSHIPB.Item("FRT_3PY_PHONE") = Absx1.medFor("FRT_3PY_PHONE").Text
                rowSOTSHIPB.Item("FRT_3PY_CODE") = Absx1.txtFor("FRT_3PY_CODE").Text()
                rowSOTSHIPB.Item("FRT_3PY_NAME") = Absx1.txtFor("FRT_3PY_NAME").Text()
                rowSOTSHIPB.Item("FRT_3PY_ADDR1") = Absx1.txtFor("FRT_3PY_ADDR1").Text()
                rowSOTSHIPB.Item("FRT_3PY_ADDR2") = Absx1.txtFor("FRT_3PY_ADDR2").Text()
                rowSOTSHIPB.Item("FRT_3PY_CITY") = Absx1.txtFor("FRT_3PY_CITY").Text()
                rowSOTSHIPB.Item("FRT_3PY_STATE") = Absx1.txtFor("FRT_3PY_STATE").Text()
                rowSOTSHIPB.Item("FRT_3PY_ZIP_CODE") = Absx1.txtFor("FRT_3PY_ZIP_CODE").Text()
                rowSOTSHIPB.Item("FRT_3PY_COUNTRY") = Absx1.txtFor("FRT_3PY_COUNTRY").Text()
                rowSOTSHIPB.Item("FRT_3PY_CONTACT") = Absx1.txtFor("FRT_3PY_CONTACT").Text()

                rowSOTSHIPB.Item("EDI_LOAD_ID") = Absx1.txtFor("EDI_LOAD_ID").Text

                If ASCMAIN1.CLIENT = "RGI" Then
                    rowSOTSHIPB.Item("SHIP_REF") = Absx1.txtFor("SHIP_REF").Text
                End If

                rowSOTSHIPB.Item("BTB_BOL_NO") = Absx1.txtFor("BTB_BOL_NO").Text
                If ASCMAIN1.CLIENT = "VAN" Then
                    rowSOTSHIPB.Item("SHIP_LOAD_NO") = rowSOTSHIPB.Item("EDI_LOAD_ID")
                End If
            Next

            Dim printThridPartyBillingAddress As Int16 = 0
            ' Fill in the third party freight invoice
            If ASCMAIN1.CLIENT = "VAN" Then
                For Each rowSOTSHIPB As DataRow In dst.Tables("SOTSHIPB").Select("")
                    If Absx1.txtFor("FRT_3PY_NAME").Text = String.Empty _
                            AndAlso Not Absx1.chkFor("THIRD_PARTY").Checked Then

                        ' See if the user wants to print the 3rd party Address
                        If printThridPartyBillingAddress = 0 Then
                            If MessageBox.Show("Do you want to print the 3rd Party Billing Address", "Print", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.Yes Then
                                printThridPartyBillingAddress = 1
                            Else
                                printThridPartyBillingAddress = 2
                            End If
                        End If

                        If printThridPartyBillingAddress = 1 Then

                            If Absx1.txtFor("FRT_TERMS").Text = "COL" Then
                                rowSOTSHIPB.Item("FRT_3PY_NAME") = rowSOTSHIPB.Item("SHIP_TO_NAME")
                                rowSOTSHIPB.Item("FRT_3PY_ADDR1") = rowSOTSHIPB.Item("SHIP_TO_ADDR1")
                                rowSOTSHIPB.Item("FRT_3PY_ADDR2") = rowSOTSHIPB.Item("SHIP_TO_ADDR2")
                                rowSOTSHIPB.Item("FRT_3PY_ADDR3") = rowSOTSHIPB.Item("SHIP_TO_ADDR3")
                                rowSOTSHIPB.Item("FRT_3PY_CITY") = rowSOTSHIPB.Item("SHIP_TO_CITY")
                                rowSOTSHIPB.Item("FRT_3PY_STATE") = rowSOTSHIPB.Item("SHIP_TO_STATE")
                                rowSOTSHIPB.Item("FRT_3PY_ZIP_CODE") = rowSOTSHIPB.Item("SHIP_TO_ZIP_CODE")
                                rowSOTSHIPB.Item("FRT_3PY_COUNTRY") = rowSOTSHIPB.Item("SHIP_TO_COUNTRY")
                                rowSOTSHIPB.Item("FRT_3PY_CONTACT") = rowSOTSHIPB.Item("SHIP_TO_CONTACT")
                                rowSOTSHIPB.Item("FRT_3PY_PHONE") = rowSOTSHIPB.Item("SHIP_TO_PHONE")
                            Else
                                If ROWs("ASTPARM1") IsNot Nothing Then
                                    rowSOTSHIPB.Item("FRT_3PY_NAME") = ROWs("ASTPARM1").Item("AS_PARM_INST_NAME")
                                    rowSOTSHIPB.Item("FRT_3PY_ADDR1") = ROWs("ASTPARM1").Item("AS_PARM_INST_ADDR1")
                                    rowSOTSHIPB.Item("FRT_3PY_ADDR2") = ROWs("ASTPARM1").Item("AS_PARM_INST_ADDR2")
                                    rowSOTSHIPB.Item("FRT_3PY_ADDR3") = ROWs("ASTPARM1").Item("AS_PARM_INST_ADDR3")
                                    rowSOTSHIPB.Item("FRT_3PY_CITY") = ROWs("ASTPARM1").Item("AS_PARM_INST_CITY")
                                    rowSOTSHIPB.Item("FRT_3PY_STATE") = ROWs("ASTPARM1").Item("AS_PARM_INST_STATE")
                                    rowSOTSHIPB.Item("FRT_3PY_ZIP_CODE") = ROWs("ASTPARM1").Item("AS_PARM_INST_ZIP_CODE")
                                    rowSOTSHIPB.Item("FRT_3PY_COUNTRY") = ROWs("ASTPARM1").Item("AS_PARM_INST_COUNTRY")
                                    rowSOTSHIPB.Item("FRT_3PY_CONTACT") = "Shiping Dept"
                                    rowSOTSHIPB.Item("FRT_3PY_PHONE") = ROWs("ASTPARM1").Item("AS_PARM_INST_PHONE")
                                End If
                            End If
                        End If
                    End If
                Next
            End If

            dst.Tables("SOTSHIP3_RPT").Rows.Clear()
            Dim NMFC_CODE As String = String.Empty
            Dim BOL_NO As String = String.Empty
            SHIP_BOL_NO = String.Empty
            Dim sqlSelect As String = String.Empty

            Dim rowSOTSHIP3_RPT As DataRow = Nothing
            Dim rowSOTSHIP2 As DataRow = Nothing
            Dim rowSOTNMFC1 As DataRow = Nothing

            Dim tbl As DataTable = ASCDATA1.SelectDistinct(dst.Tables("SOTSHIP2"), New String() {"SHIP_BOL_NO", "NMFC_CODE"})

            For Each rowSOTSHIP2x As DataRow In tbl.Select("", "SHIP_BOL_NO, NMFC_CODE")
                SHIP_BOL_NO = (rowSOTSHIP2x.Item("SHIP_BOL_NO") & String.Empty).ToString.Trim
                NMFC_CODE = (rowSOTSHIP2x.Item("NMFC_CODE") & String.Empty).ToString.Trim
                If NMFC_CODE.Length = 0 Then
                    Continue For
                End If

                sqlSelect = "SHIP_BOL_NO = '" & SHIP_BOL_NO & "' and NMFC_CODE = '" & NMFC_CODE & "'"

                If dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length = 0 Then
                    Continue For
                End If

                BOL_NO = dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("BILL_OF_LADING_NO")

                rowSOTSHIP3_RPT = dst.Tables("SOTSHIP3_RPT").NewRow

                rowSOTSHIP3_RPT.Item("BOL_NO") = BOL_NO

                Dim HANDLING_UNITS As Int16 = 0
                If ASCMAIN1.CLIENT = "RGI" Then
                    HANDLING_UNITS = Val(dst.Tables("SOTSHIP1").Compute("SUM(HANDLING_UNITS)", "HANDLING_TYPE = 'P' AND MASTER_SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & String.Empty)
                    rowSOTSHIP3_RPT.Item("HANDLING_UNITS") = HANDLING_UNITS
                End If

                If HANDLING_UNITS = 0 Then
                    rowSOTSHIP3_RPT.Item("HANDLING_UNITS") = Val(dst.Tables("SOTSHIP1").Compute("SUM(HANDLING_UNITS)", "HANDLING_TYPE = 'P' AND SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & String.Empty)
                End If

                If HANDLING_UNITS = 0 AndAlso tbl.Rows.Count = 1 Then
                    rowSOTSHIP3_RPT.Item("HANDLING_UNITS") = Val(dst.Tables("SOTSHIP1").Compute("SUM(HANDLING_UNITS)", "HANDLING_TYPE = 'P'") & String.Empty)
                End If

                rowSOTSHIP3_RPT.Item("HANDLING_TYPE") = "PLTS"
                rowSOTSHIP3_RPT.Item("PKG_QTY") = Val(dst.Tables("SOTSHIP2").Compute("SUM(PKG_QTY)", sqlSelect) & String.Empty)

                If ASCMAIN1.CLIENT = "NYA" OrElse ASCMAIN1.CLIENT = "RGI" Then
                    Dim PKG_TYPE As String = dst.Tables("SOTSHIP2").Compute("MAX(PKG_TYPE)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "' AND NMFC_CODE = '" & NMFC_CODE & "'") & String.Empty
                    If PKG_TYPE = String.Empty Then
                        PKG_TYPE = "CTNS"
                    End If
                    rowSOTSHIP3_RPT.Item("PKG_DESC") = PKG_TYPE
                Else
                    rowSOTSHIP3_RPT.Item("PKG_DESC") = "CTNS"
                End If

                rowSOTSHIP3_RPT.Item("WEIGHT") = Val(dst.Tables("SOTSHIP2").Compute("SUM(WEIGHT)", sqlSelect) & String.Empty)

                rowSOTSHIP3_RPT.Item("CUBE_TOTAL") = Val(dst.Tables("SOTSHIP2").Compute("SUM(CUBE)", sqlSelect) & String.Empty)
                rowSOTSHIP3_RPT.Item("NMFC_CODE") = NMFC_CODE

                rowSOTSHIP3_RPT.Item("NMFC_DESC") = String.Empty
                rowSOTSHIP3_RPT.Item("CLASS_CODE") = String.Empty

                If dst.Tables("SOTSHIP2").Select(sqlSelect).Length > 0 Then
                    rowSOTSHIP2 = dst.Tables("SOTSHIP2").Select(sqlSelect)(0)
                    rowSOTSHIP3_RPT.Item("NMFC_DESC") = LookUp("SOTNMFC1", NMFC_CODE, True).Item("NMFC_DESC") & String.Empty
                    rowSOTSHIP3_RPT.Item("CLASS_CODE") = rowSOTSHIP2.Item("CLASS_CODE")
                End If

                dst.Tables("SOTSHIP3_RPT").Rows.Add(rowSOTSHIP3_RPT)
            Next

            If dst.Tables("SOTSHIP3_RPT").Rows.Count = 0 Then
                Dim rowSOTSHIP3_RPTx As DataRow = dst.Tables("SOTSHIP3_RPT").NewRow
                rowSOTSHIP3_RPTx.Item("BOL_NO") = dst.Tables("SOTSHIP1").Rows(0).Item("BILL_OF_LADING_NO")
            End If

            Print_Report_Begin()
            CR_params.Add("SUBT", "")
            Dim RPT As String = "SORSHIPB"

            Select Case ASCMAIN1.CLIENT
                Case "VAN"
                    RPT = "SORSHIPV"
                Case "NYA"
                    RPT = "SORSHIPN"
                Case "RGI"
                    RPT = "SORSHIPR"
            End Select

            Generate_Report(RPT, "Bill of Lading")

            CR_params.Add("SUBT", "")
            RPT = "SORSHIPM"
            Generate_Report(RPT, "Manifest")

            If processingMasterBOL Then
                CR_params.Add("SUBT", "")
                RPT = "SORSHIPA"
                If ASCMAIN1.CLIENT = "RGI" Then
                    RPT = "SORSHIPG"
                End If
                Generate_Report(RPT, "Master Bill of Lading")
            End If

            Print_Report_End()
        Catch ex As Exception
            MessageBox.Show("The following error occurred when printind Bill of lading: " & ex.Message, "Print Error", MessageBoxButtons.OK, MessageBoxIcon.Error)

        Finally
            If processingMasterBOL AndAlso MASTER_BOL_NO.Length > 0 Then
                For Each row As DataRow In dst.Tables("SOTSHIPB").Select("MASTER_BOL_NO = '" & MASTER_BOL_NO & "'")
                    row.Delete()
                Next
                dst.Tables("SOTSHIPB").AcceptChanges()
            End If
        End Try
    End Sub

