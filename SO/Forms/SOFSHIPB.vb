    Private Sub Add_To_Master()

        Dim processedData As Boolean = False

        Try

            If dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '1'").Length <> 1 Then
                MessageBox.Show("You must select 1 and only one Master BOL.", "Add To Master", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If
            Dim MASTER_BOL_NO As String = dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '1'")(0).Item("BOL_NO")

            If dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '0' AND ISNULL(MASTER_BOL_NO, '*') <> '" & MASTER_BOL_NO & "'").Length = 0 Then
                MessageBox.Show("You must select at least 1 shipment to attach to the selected Master BOL that is not already assigned to the Master BOL.", "Add To Master", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            Dim MASTER_CUST_CODE As String = dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '1'")(0).Item("CUST_CODE")
            Dim MASTER_WHSE_CODE As String = dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '1'")(0).Item("WHSE_CODE")

            Dim lstBolNos As New List(Of String)

            For Each row As DataRow In dst.Tables("SOTSHIPS_M").Select("SEL = '1' AND ISNULL(MASTER_BOL, '0') = '0' AND ISNULL(MASTER_BOL_NO, '*') <> '" & MASTER_BOL_NO & "'")
                Dim BOL_NO As String = row.Item("BOL_NO")
                Dim CUST_CODE As String = row.Item("CUST_CODE") & String.Empty
                Dim WHSE_CODE As String = row.Item("WHSE_CODE") & String.Empty

                If dst.Tables("SOTSHIPS_M").Select("BOL_NO = '" & BOL_NO & "'").Length = 0 Then
                    MessageBox.Show("Cannot locate the selected Bill of Lading: " & BOL_NO, "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Continue For
                End If

                If dst.Tables("SOTSHIPS_M").Select("BOL_NO = '" & BOL_NO & "' and MASTER_BOL = '1'").Length > 0 Then
                    MessageBox.Show("Bill of Lading  " & BOL_NO & " is a Master BOL.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Continue For
                End If

                If WHSE_CODE <> MASTER_WHSE_CODE Then
                    MessageBox.Show("Bill of Lading  " & BOL_NO & " does not have the same warehouse as the selected Master.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Continue For
                End If

                If CUST_CODE <> MASTER_CUST_CODE Then
                    MessageBox.Show("Bill of Lading  " & BOL_NO & " does not have the same Customer as the selected Master.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
                    Continue For
                End If

                Dim thisMasterBolNo As String = dst.Tables("SOTSHIPS_M").Select("BOL_NO = '" & BOL_NO & "'")(0).Item("MASTER_BOL_NO") & String.Empty
                thisMasterBolNo = thisMasterBolNo.Trim

                If thisMasterBolNo.Length > 0 AndAlso thisMasterBolNo <> MASTER_BOL_NO Then
                    If MessageBox.Show("The selected BOL (" & BOL_NO & ") belongs to Master BOL (" & thisMasterBolNo & ")." _
                                       & Environment.NewLine & Environment.NewLine & "Do you want to add it to this Master Bill of Lading?",
                            "Add BOL", MessageBoxButtons.YesNo, MessageBoxIcon.Question Or MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                        Continue For
                    End If
                End If

                lstBolNos.Add(BOL_NO)
            Next

            If lstBolNos.Count = 0 Then
                Exit Sub
            End If

            Dim userMsg As String = "Do you want to assign the following BOLs:" & Environment.NewLine _
                                        & String.Join(Environment.NewLine, lstBolNos.ToArray) _
                                        & Environment.NewLine & "to Master BOL: " & MASTER_BOL_NO & "?"

            If MessageBox.Show(userMsg, "", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                Exit Sub
            End If

            Me.Cursor = Cursors.WaitCursor

            If Not ASCMAIN1.Logical_Lock("SOTSHIPB", MASTER_BOL_NO, , , , 4) Then Exit Sub
            For Each bol_no_m As String In lstBolNos
                If Not ASCMAIN1.Logical_Lock("SOTSHIPB", bol_no_m, , , , 4) Then Exit Sub
            Next

            Dim tblSOTSHIP1 As DataTable = ASCDATA1.GetDataTable("Select * from sotship1 where BILL_OF_LADING_NO = '" & MASTER_BOL_NO & "' or MASTER_BILL_OF_LADING_NO = '" & MASTER_BOL_NO & "'" _
                                                                 & " Union " _
                                                                 & " Select * from sotship1 where BILL_OF_LADING_NO in ('" & String.Join("', '", lstBolNos.ToArray) & "')")

            For Each rowSOTSHIP1 As DataRow In tblSOTSHIP1.Rows
                If Not ASCMAIN1.Logical_Lock("SOTSHIP1", rowSOTSHIP1.Item("SHIP_BOL_NO"), , , , 4) Then Exit Sub
                If Not ASCMAIN1.Logical_Lock("SOTORDR0", rowSOTSHIP1.Item("ORDR_GROUP_NO"), , , , 4) Then Exit Sub
            Next

            Try
                BeginTrans()

                For Each BOL_NO As String In lstBolNos
                    ASCMAIN1.sql = "UPDATE SOTSHIPB SET MASTER_BOL_NO = :PARM1, MASTER_BOL = 0 WHERE BOL_NO = :PARM2"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {MASTER_BOL_NO, BOL_NO})

                    ASCMAIN1.sql = "UPDATE SOTSHIP1 SET MASTER_BILL_OF_LADING_NO = :PARM1 WHERE BILL_OF_LADING_NO = :PARM2"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {MASTER_BOL_NO, BOL_NO})

                    'ASCMAIN1.sql = "DELETE FROM SOTSHIP2 WHERE SHIP_BOL_NO IN (SELECT SHIP_BOL_NO FROM SOTSHIP1 WHERE BILL_OF_LADING_NO = :PARM1)"
                    'ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "V", New Object() {BOL_NO})

                    For Each fieldName As String In bolHeaderFieldsToUpdate.Split(",")
                        fieldName = fieldName.Trim
                        If fieldName.Length = 0 Then Continue For

                        ASCMAIN1.sql = "UPDATE SOTSHIPB SET " & fieldName & " = (SELECT " & fieldName & " FROM SOTSHIPB WHERE BOL_NO = :PARM1) WHERE BOL_NO = :PARM2"
                        If Not (fieldName = "EDI_LOAD_ID" AndAlso ASCMAIN1.CLIENT = "RGI") Then
                            ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {MASTER_BOL_NO, BOL_NO})
                        End If

                        If dst.Tables("SOTSHIP1").Columns.Contains(fieldName) Then
                            ASCMAIN1.sql = String.Empty

                            If fieldName = "SHIP_REF" Then
                                ' Added on 5/24/2019 - Nassema and Walter
                                If ASCMAIN1.CLIENT = "VAN" Then
                                    'If rowSOTSHIP1.Item(fieldName) & String.Empty = String.Empty Then
                                    '    rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                    'End If
                                    ASCMAIN1.sql = "UPDATE SOTSHIP1 SET " & fieldName & " = (SELECT " & fieldName & " FROM SOTSHIPB WHERE BOL_NO = :PARM1) WHERE BILL_OF_LADING_NO = :PARM2 AND " & fieldName & " IS NULL"
                                Else
                                    'rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                    ASCMAIN1.sql = "UPDATE SOTSHIP1 SET " & fieldName & " = (SELECT " & fieldName & " FROM SOTSHIPB WHERE BOL_NO = :PARM1) WHERE BILL_OF_LADING_NO = :PARM2"
                                End If
                            Else
                                'rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                ASCMAIN1.sql = "UPDATE SOTSHIP1 SET " & fieldName & " = (SELECT " & fieldName & " FROM SOTSHIPB WHERE BOL_NO = :PARM1) WHERE BILL_OF_LADING_NO = :PARM2"
                            End If

                            ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VV", New Object() {MASTER_BOL_NO, BOL_NO})
                        End If
                    Next

                Next

                CommitTrans("Merge Successful")
                processedData = True

            Catch ex As Exception
                Rollback(ex.Message)
            End Try
        Catch ex As Exception

        Finally
            ASCMAIN1.MultiTask_Release(, , 4)
            If processedData Then
                Load_SOTSHIPS()
                Clear_All_Filters(grdMasterBols)
                Clear_All_Filters(grdNonMasterBols)
            End If
            Me.Cursor = Cursors.Default
        End Try

    End Sub

    Private Sub AddBOLtoMaster(ByVal BOL_NO As String)

        If dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "'").Length = 0 Then
            MessageBox.Show("Cannot locate the selected Bill of Lading.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        If dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "' and SEL = '1'").Length > 0 Then
            MessageBox.Show("The selected Bill of Lading already belongs to the Master BOL.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        If dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "' and MASTER_BOL = '1'").Length > 0 Then
            MessageBox.Show("The selected Bill of Lading is a Master BOL.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Error)
            Exit Sub
        End If

        Dim thisMasterBolNo As String = dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "'")(0).Item("MASTER_BOL_NO") & String.Empty
        thisMasterBolNo = thisMasterBolNo.Trim

        If thisMasterBolNo.Length > 0 AndAlso thisMasterBolNo <> MASTER_BOL_NO Then
            If MessageBox.Show("The selected BOL (" & BOL_NO & ") belongs to Master BOL (" & thisMasterBolNo & ")." _
                               & Environment.NewLine & Environment.NewLine & "Do you want to add it to this Master Bill of Lading?",
                    "Add BOL", MessageBoxButtons.YesNo, MessageBoxIcon.Question Or MessageBoxIcon.Warning, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                Exit Sub
            End If

        Else
            If MessageBox.Show("Do you want to add Bill of Lading NO (" & BOL_NO & ") to this Master Bill of Lading?",
                                "Add BOL", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.No Then
                Exit Sub
            End If
        End If


        If dst.Tables("SOTSHIPB").Select("BOL_NO = '" & BOL_NO & "'").Length = 0 Then

            Dim rowSOTSHIPB As DataRow = ASCDATA1.GetDataRow("SELECT * FROM SOTSHIPB WHERE BOL_NO = '" & BOL_NO & "'")

            If rowSOTSHIPB Is Nothing Then
                MessageBox.Show("Cannot locate selected Bill of Lading.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If

            If rowSOTSHIPB.Item("BOL_STATUS") <> "O" Then
                MessageBox.Show("Selected BOL is no longer Open.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Information)
                Exit Sub
            End If

            If Not ASCMAIN1.Logical_Lock("SOTSHIPB", BOL_NO, , , , 4) Then Exit Sub
            Dim tblSOTSHIP1 As DataTable = ASCDATA1.GetDataTable("Select * from sotship1 where BILL_OF_LADING_NO = '" & BOL_NO & "' AND SHIP_STATUS = 'P'")

            For Each rowSOTSHIP1 As DataRow In tblSOTSHIP1.Rows
                If Not ASCMAIN1.Logical_Lock("SOTSHIP1", rowSOTSHIP1.Item("SHIP_BOL_NO"), , , , 4) Then Exit Sub
                If Not ASCMAIN1.Logical_Lock("SOTORDR0", rowSOTSHIP1.Item("ORDR_GROUP_NO"), , , , 4) Then Exit Sub
            Next

            EnforceConstraints(False)

            Me.Cursor = Cursors.WaitCursor
            ToggleDataTableExpressions(False)

            Dim shipBolNoList As New List(Of String)
            For Each rowSOTSHIP1 As DataRow In tblSOTSHIP1.Rows
                shipBolNoList.Add(rowSOTSHIP1.Item("SHIP_BOL_NO"))
            Next

            Dim inListshipBolNo As String = "('" & String.Join("', '", shipBolNoList.ToArray) & "')"

            ' Need to load the Shipment data 
            ASCMAIN1.sql = sqlSOTSHIPX
            ASCMAIN1.sql &= " and SHIP_BOL_NO in " & inListshipBolNo
            Fill_Records("SOTSHIP1", String.Empty, False, ASCMAIN1.sql)

            ASCMAIN1.sql = sqlSOTPICK1 & vbCrLf _
                & " where SOTORDR1.ORDR_NO = SOTPICK1.ORDR_NO" & vbCrLf _
                & " and SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                & " and SOTSHIP1.SHIP_BOL_NO in " & inListshipBolNo
            Fill_Records("SOTPICK1", "", False, ASCMAIN1.sql)

            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                rowSOTPICK1.Item("BILL_OF_LADING_NO") = BOL_NO
                rowSOTPICK1.Item("PICK_FREIGHT_ORIG") = rowSOTPICK1.Item("PICK_FREIGHT")
            Next

            If ASCMAIN1.CLIENT = "VAN" Then
                ASCMAIN1.sql = sqlSOTPICK2 & vbCrLf _
                                & " where SOTPICK2.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                                & "   and SOTORDR1.ORDR_NO = SOTORDR2.ORDR_NO" & vbCrLf _
                                & "   and SOTORDR2.ORDR_NO = SOTPICK2.ORDR_NO" & vbCrLf _
                                & "   and SOTORDR2.ORDR_LNO = SOTPICK2.ORDR_LNO" & vbCrLf _
                                & "   and SOTPICK1.SHIP_BOL_NO = SOTSHIP1.SHIP_BOL_NO" & vbCrLf _
                                & "   and SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE" & vbCrLf _
                                & "   and ICTCOLR1.COLOR_CODE (+) = SOTORDR2.COLOR_CODE" & vbCrLf _
                                & "   and SOTORDR2.STYLE_CODE = ICTSTYC1.STYLE_CODE (+) AND SOTORDR2.COLOR_CODE = ICTSTYC1.COLOR_CODE (+)" _
                                & " and  SOTPICK1.SHIP_BOL_NO in " & inListshipBolNo
                Fill_Records("SOTPICK2", "", False, ASCMAIN1.sql)
            Else
                ASCMAIN1.sql = sqlSOTPICK2 & vbCrLf _
                            & " where SOTPICK2.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                            & "   and SOTORDR1.ORDR_NO = SOTORDR2.ORDR_NO" & vbCrLf _
                            & "   and SOTORDR2.ORDR_NO = SOTPICK2.ORDR_NO" & vbCrLf _
                            & "   and SOTORDR2.ORDR_LNO = SOTPICK2.ORDR_LNO" & vbCrLf _
                            & "   and SOTPICK1.SHIP_BOL_NO = SOTSHIP1.SHIP_BOL_NO" & vbCrLf _
                            & "   and SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE" & vbCrLf _
                            & "   and ICTCOLR1.COLOR_CODE (+) = SOTORDR2.COLOR_CODE" & vbCrLf _
                            & "   and SOTORDR2.STYLE_CODE = ICTSTYC1.STYLE_CODE (+) AND SOTORDR2.COLOR_CODE = ICTSTYC1.COLOR_CODE (+)" _
                            & " and  SOTPICK1.SHIP_BOL_NO in " & inListshipBolNo
                Fill_Records("SOTPICK2", "", False, ASCMAIN1.sql)
            End If

            For Each SHIP_BOL_NO As String In shipBolNoList
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                    rowSOTPICK1.Item("SELECTED") = "1"
                    rowSOTPICK1.Item("BILL_OF_LADING_NO") = BOL_NO
                    Dim PICK_NO As String = rowSOTPICK1.Item("PICK_NO")
                    If ASCMAIN1.CLIENT <> "VAN" Then
                        If Not select_from_3PL_list Then
                            SetPickQuantityConfirmed("PICK_NO = '" & PICK_NO & "'")
                        End If
                    Else
                        If Not select_from_3PL_list Then
                            For Each row As DataRow In ASCDATA1.SelectDistinct(dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "'"), New String() {"PICK_NO", "ORDR_NO", "ORDR_LNO"}).Rows
                                dst.Tables("SOTCARTX").Rows.Add(New Object() {row.Item("PICK_NO"), row.Item("ORDR_NO"), row.Item("ORDR_LNO")})
                            Next
                        End If
                    End If
                Next
            Next

            ASCMAIN1.sql = "Select * FROM SOTCART1 WHERE PICK_NO IN (SELECT PICK_NO FROM SOTPICK1 WHERE SHIP_BOL_NO IN " & inListshipBolNo & ")"
            Fill_Records("SOTCART1", "", False, ASCMAIN1.sql)

            ASCMAIN1.sql = "Select SOTCART2.*, SOTCART1.PICK_NO, SOTCART2.QTY_PACKED QTY_PACKED_ORIG" & vbCrLf _
            & " from SOTCART1,SOTCART2" & vbCrLf _
            & " where SOTCART1.CART_NO = SOTCART2.CART_NO" & vbCrLf _
            & " and SOTCART1.PICK_NO IN (SELECT PICK_NO FROM SOTPICK1 WHERE SHIP_BOL_NO IN " & inListshipBolNo & ")"
            Fill_Records("SOTCART2", "", False, ASCMAIN1.sql)

            For Each SHIP_BOL_NO As String In shipBolNoList
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")

                    Dim PICK_NO As String = rowSOTPICK1.Item("PICK_NO")
                    Dim CART_SEQ As Int32 = 1
                    For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'")
                        'Dim CART_NO As String = rowSOTCART1.Item("CART_NO")

                        ' default to packaging code 31 - Our package
                        rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
                        rowSOTCART1.Item("CART_SEQ") = CART_SEQ
                        CART_SEQ += 1

                        If edi_order And edi856_customer Then
                            rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")
                        ElseIf ASCMAIN1.CLIENT = "RGI" Then
                            ' For RGI set weight and carton type
                            If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                                rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")
                            End If

                            If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                                rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = 1
                            End If

                            rowSOTCART1.Item("REFERENCE1") = Val(rowSOTCART1.Item("PICK_NO") & String.Empty)
                            rowSOTCART1.Item("REFERENCE2") = rowSOTCART1.Item("CART_NO") & String.Empty

                            ' Default 
                            If rowSOTCART1.Item("PKG_CODE") & String.Empty = String.Empty Then
                                rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE
                            End If

                            Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(rowSOTCART1.Item("PKG_CODE") & String.Empty)
                            If rowWHTPKGM1 IsNot Nothing Then
                                rowSOTCART1.Item("PKG_L") = Val(rowWHTPKGM1.Item("PKG_L") & String.Empty)
                                rowSOTCART1.Item("PKG_H") = Val(rowWHTPKGM1.Item("PKG_H") & String.Empty)
                                rowSOTCART1.Item("PKG_W") = Val(rowWHTPKGM1.Item("PKG_W") & String.Empty)
                            End If
                        End If
                    Next
                Next
            Next

            If ASCMAIN1.CLIENT = "VAN" And Not select_from_3PL_list Then
                load_pick2_van("")
            End If

            ToggleDataTableExpressions(True)
        End If

        dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "'")(0).Item("SEL") = "1"
        dst.Tables("SOTSHIPS").Select("BOL_NO = '" & BOL_NO & "'")(0).Item("MASTER_BOL_NO") = txtMASTER_BOL_NO.Text

        For Each tableName As String In processingTables
            dst.Tables(tableName).AcceptChanges()
        Next

        EnforceConstraints(True)

        RefreshBolShipments(True)

        SetupgrdSOTCART1_SHIP()

        If ASCMAIN1.CLIENT = "RGI" Then
            RGI_SORT_SOTPICK2()
        End If

        ' Hide / Display Curr Code column
        If dst.Tables("SOTPICK1").Select("CURR_CODE <> '" & ROWs("GLTPARM1").Item("GL_PARM_CURR_CODE") & "'").Length > 0 Then
            grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = False
        Else
            grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = True
        End If

        Me.Cursor = Cursors.Default
        MessageBox.Show("BOL Added to Master BOL.", "Add BOL", MessageBoxButtons.OK, MessageBoxIcon.Information)

    End Sub

    Private Sub load_pick2_van(ByVal SHIP_BOL_NO As String)

        ' 02/27/2020
        ' this is only called when creating Master Bols. This should not be necessary
        ' It is called after each BOL is added; therefore, all Pickets are loped through each time

        numInsureValue.Value = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_AMT_CONF)", "") & String.Empty)

        If 1 = 1 Then Exit Sub

        Dim tblSOTPICK2 As DataTable = dst.Tables("SOTPICK2").Copy

        For Each rowSOTPICK2 As DataRow In tblSOTPICK2.Select("", "PICK_NO, PICK_LNO")
            rowSOTPICK2.Item("ORDR_UNIT_PRICE") = Val(rowSOTPICK2.Item("ORDR_UNIT_PRICE") & String.Empty)
            rowSOTPICK2.Item("PICK_UNIT_PRICE") = rowSOTPICK2.Item("ORDR_UNIT_PRICE")
            ASCMAIN1.Progress("-", Val(rowSOTPICK2.Item("PICK_NO")) & "/" & rowSOTPICK2.Item("PICK_LNO"))

            If Not select_from_3PL_list Then
                If Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) = 0 AndAlso Val(rowSOTPICK2.Item("PICK_QTY_CANC") & String.Empty) = 0 Then
                    rowSOTPICK2.Item("PICK_QTY_CONF") = Val(rowSOTPICK2.Item("PICK_QTY") & String.Empty) - Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty)
                    rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                    rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                End If
            Else
                ' If 3PL then cancel unshipped items from the pick ticket
                If Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) < rowSOTPICK2.Item("PICK_QTY") Then
                    rowSOTPICK2.Item("PICK_QTY_CANC") = rowSOTPICK2.Item("PICK_QTY") - Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty)
                End If
            End If
        Next

        dst.Tables("SOTPICK2").Rows.Clear()
        dst.Tables("SOTPICK2").Merge(tblSOTPICK2)

        numInsureValue.Value = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_AMT_CONF)", "") & String.Empty)
    End Sub

    Private Sub CreateSotship2Entry(ByVal ORDR_CUST_PO As String)

        ORDR_CUST_PO = ORDR_CUST_PO.Trim
        If ORDR_CUST_PO.Length = 0 Then Exit Sub

        ' Need to handle Single quote in PO Number
        If dst.Tables("SOTSHIP2").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO.Replace("'", "''") & "'").Length > 0 Then
            UpdateMultiPOShipment(ORDR_CUST_PO)
            Exit Sub
        End If

        Dim rowSOTSHIP2 As DataRow = dst.Tables("SOTSHIP2").NewRow
        rowSOTSHIP2.Item("SHIP_BOL_NO") = MASTER_SHIP_BOL_NO
        rowSOTSHIP2.Item("SHIP_BOL_LNO") = Val(dst.Tables("SOTSHIP2").Compute("MAX(SHIP_BOL_LNO)", "") & String.Empty) + 1
        rowSOTSHIP2.Item("ORDR_CUST_PO") = ORDR_CUST_PO
        rowSOTSHIP2.Item("NMFC_CODE") = NMFC_CODE
        rowSOTSHIP2.Item("CLASS_CODE") = CLASS_CODE
        rowSOTSHIP2.Item("RATE") = 0
        rowSOTSHIP2.Item("PKG_TYPE") = "CTN"
        rowSOTSHIP2.Item("PKG_QTY") = 0
        rowSOTSHIP2.Item("WEIGHT") = 0

        Dim SHIP_DEPT As String = String.Empty
        For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO.Replace("'", "''") & "'")
            Dim ORDR_DEPT As String = rowSOTSHIP1.Item("ORDR_DEPT") & String.Empty
            If ORDR_DEPT.Length > 0 Then
                SHIP_DEPT = ORDR_DEPT
                Exit For
            End If
        Next

        If SHIP_DEPT.Length = 0 Then
            SHIP_DEPT = dst.Tables("SOTSHIP1").Compute("MAX(ORDR_DEPT)", "SHIP_BOL_NO = '" & MASTER_SHIP_BOL_NO & "'") & String.Empty
        End If

        rowSOTSHIP2.Item("SHIP_DEPT") = SHIP_DEPT
        rowSOTSHIP2.Item("CUBE") = 0

        dst.Tables("SOTSHIP2").Rows.Add(rowSOTSHIP2)
        UpdateMultiPOShipment(ORDR_CUST_PO)
    End Sub

    Private Sub UpdateMultiPOShipment(ByVal ORDR_CUST_PO As String)

        If Not ASCMAIN1.CLIENT = "VAN" Then
            Exit Sub
        End If

        Dim SHIP_BOL_NO_CONS As String = ""
        Dim SHIP_BOL_NO_1 As String = ""
        For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO.Replace("'", "''") & "'")
            SHIP_BOL_NO_CONS = rowSOTSHIP1("SHIP_BOL_NO_CONS") & ""
            SHIP_BOL_NO_1 = rowSOTSHIP1("SHIP_BOL_NO") & ""
        Next

        If SHIP_BOL_NO_CONS <> "" Then

            For Each rowSOTSHIP2 As DataRow In dst.Tables("SOTSHIP2").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO.Replace("'", "''") & "'")

                Dim MULTI_PO As String = ""
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO_CONS & "'")
                    MULTI_PO = rowSOTSHIP1("ORDR_CUST_PO") & ""
                    rowSOTSHIP2.Item("MULTI_PO") = MULTI_PO
                    Exit For
                Next
                ASCMAIN1.sql = "SELECT SUM(THIS_PO) THIS_PO, sum(TTL - THIS_PO) OTHER_PO, SUM(TTL) TTL FROM (
                            SELECT  SUM(CASE WHEN P1.ORDR_NO = M2.ORDR_NO and S1.SHIP_BOL_NO_CONS = S1.SHIP_BOL_NO THEN 1 ELSE 0 END) THIS_PO
                            , 0 TTL
                            FROM SOTSHIP1 S1
                            JOIN SOTPICK1 P1 ON (S1.SHIP_BOL_NO = P1.SHIP_BOL_NO)
                            JOIN SOTCARM1 M1 ON (P1.PICK_NO_CONS = M1.PICK_NO)
                            JOIN (SELECT DISTINCT CART_NO, ORDR_NO FROM SOTCARM2) M2 ON (M1.CART_NO = M2.CART_NO)
                            WHERE S1.SHIP_BOL_NO_CONS = :PARM1
                            UNION
                            SELECT   0 THIS_PO, COUNT(1) TTL
                            FROM SOTSHIP1 S1
                            JOIN SOTPICK1 P1 ON (S1.SHIP_BOL_NO = P1.SHIP_BOL_NO)
                            JOIN SOTCARM1 M1 ON (P1.PICK_NO = M1.PICK_NO)
                            WHERE SHIP_BOL_NO_CONS = :PARM1)"
                Dim row As DataRow = ASCDATA1.GetDataRow(ASCMAIN1.sql, "V", SHIP_BOL_NO_CONS)
                If Not IsDBNull(row) Then
                    rowSOTSHIP2.Item("MULTIPO_TTL") = Val(row("TTL") & "")
                    If Val(rowSOTSHIP2.Item("PKG_QTY") & "") = 0 Then
                        'removed as per melvin 11/28/23
                        'rowSOTSHIP2.Item("PKG_QTY") = IIf(SHIP_BOL_NO_CONS = SHIP_BOL_NO_1, Val(row("THIS_PO") & ""), Val(row("OTHER_PO") & ""))
                    End If
                End If
                If SHIP_BOL_NO_CONS = SHIP_BOL_NO_1 Then
                    ASCMAIN1.sql = "select  PALLET_NO, count(1) CTNS
                            from SOTSHIP1 S1
                            join SOTPICK1 P1 on (S1.SHIP_BOL_NO = P1.SHIP_BOL_NO)
                            join SOTCARM1 M1 on (P1.PICK_NO = M1.PICK_NO and CART_PACKED is not null and CART_TOTAL_UNITS > 0)
                            where SHIP_BOL_NO_CONS = :PARM1
                            group by PALLET_NO"
                    Dim tblPALLETS As DataTable = ASCDATA1.GetDataTable(ASCMAIN1.sql, "PALLETS", "V", SHIP_BOL_NO_CONS)
                    rowSOTSHIP2.Item("PALLETS") = tblPALLETS.Rows.Count
                    Dim pltCtns As String = ""
                    For Each rowPALLET As DataRow In tblPALLETS.Select("")
                        pltCtns += "+" + rowPALLET("CTNS").ToString
                    Next
                    rowSOTSHIP2.Item("PALLETS_CTNS") = pltCtns.Substring(1)
                End If
            Next
        End If
    End Sub

    Private Sub SetupCartonProduct(Optional bypassIsLoading As Boolean = False)

        Select Case ASCMAIN1.CLIENT
            Case "RGI"
                ' Good to Go
            Case "NYA"
                Exit Sub
            Case "VAN"
                If MENU_ITEM_OBJECT <> "SOFSHIPB" Then
                    Exit Sub
                End If
            Case Else
                Exit Sub
        End Select


        If Not ScreenMode Then
            If Not bypassIsLoading Then
                Exit Sub
            End If
        End If

        ' Expresson query max length issue.
        If dst.Tables("SOTCART1").Rows.Count > 100 Then
            dst.Tables("SOTCARTPACK").Rows.Clear()
            Exit Sub
        End If

        dst.Tables("SOTCARTPACK").Rows.Clear()
        Dim removeCPROD As Boolean = True
        Dim COLUMN_NAME As String = "CPROD_TOTAL"

        ASCMAIN1.Progress("Setup Cartons", "")

        If dst.Tables("SOTCARTPACK").Columns.Contains(COLUMN_NAME) Then
            RemoveColumns(dst.Tables("SOTCARTPACK").Columns(COLUMN_NAME))
        End If

        While removeCPROD
            removeCPROD = False
            For Each column As DataColumn In dst.Tables("SOTCARTPACK").Columns
                If column.ColumnName.StartsWith("CPROD") Then
                    RemoveColumns(column)
                    removeCPROD = True
                    Exit For
                End If
            Next
        End While

        ' Need to consolidate same item in a carton to one cartoN detail.
        ' regency uses scanners and there may be sevaeral detail lines for one item in a carton.
        If edi_order AndAlso ASCMAIN1.CLIENT = "RGI" AndAlso Not isEcommProcessing Then
            Dim tbl As DataTable = ASCDATA1.SelectDistinct(dst.Tables("SOTCART2"), New String() {"CART_NO", "ORDR_NO", "ORDR_LNO", "STYLE_CODE", "COLOR_CODE"})
            For Each row As DataRow In tbl.Select("", "CART_NO, STYLE_CODE, COLOR_CODE")
                Dim ORDR_NO As String = row.Item("ORDR_NO") & String.Empty
                Dim ORDR_LNO As String = row.Item("ORDR_LNO") & String.Empty
                Dim CART_NO As String = row.Item("CART_NO") & String.Empty
                Dim STYLE_CODE As String = row.Item("STYLE_CODE") & String.Empty
                Dim COLOR_CODE As String = row.Item("COLOR_CODE") & String.Empty

                Dim sql As String = "ORDR_NO = '" & ORDR_NO & "' and ORDR_LNO = " & ORDR_LNO & " AND CART_NO = '" & CART_NO & "' and STYLE_CODE = '" & STYLE_CODE & "' and COLOR_CODE = '" & COLOR_CODE & "'"
                If dst.Tables("SOTCART2").Select(sql).Length > 1 Then
                    Dim QTY_PACKED As Int32 = Val(dst.Tables("SOTCART2").Compute("SUM(QTY_PACKED)", sql) & String.Empty)
                    For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select(sql)
                        rowSOTCART2.Item("QTY_PACKED") = 0
                    Next
                    For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select(sql, "CART_LNO")
                        rowSOTCART2.Item("QTY_PACKED") = QTY_PACKED
                        Exit For
                    Next

                    sql &= " AND QTY_PACKED = 0"
                    For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select(sql, "CART_LNO")
                        QTY_PACKED = Val(rowSOTCART2.Item("QTY_PACKED") & String.Empty)
                        rowSOTCART2.Delete()
                    Next
                End If
            Next
        End If

        For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("", "CART_NO")
            Dim CART_NO As String = rowSOTCART1.Item("CART_NO")
            Dim PICK_NO As String = rowSOTCART1.Item("PICK_NO")

            Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)
            If rowSOTPICK1 IsNot Nothing AndAlso rowSOTPICK1.Item("PICK_STATUS") & String.Empty = "C" Then
                Continue For
            End If

            COLUMN_NAME = "CPROD" & CART_NO
            Dim PKG_CODE As String = rowSOTCART1.Item("PKG_CODE") & String.Empty
            If PKG_CODE.Length = 0 Then PKG_CODE = "Cart"

            ASCMAIN1.Progress("-", CART_NO)

            dst.Tables("SOTCARTPACK").Columns.Add(COLUMN_NAME, GetType(System.Int32))
            With grdSOTCARTPACK.DisplayLayout.Bands(0).Columns(COLUMN_NAME)
                .Hidden = False
                .CellActivation = UltraWinGrid.Activation.AllowEdit
                .Header.Caption = PKG_CODE & " " & CART_NO.Substring(CART_NO.Length - 4)
                .Format = "#,##0"
                .DefaultCellValue = 0
            End With

            For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select("CART_NO = '" & CART_NO & "'", "CART_LNO")
                Dim ORDR_NO As String = rowSOTCART2.Item("ORDR_NO")
                Dim ORDR_LNO As Int16 = rowSOTCART2.Item("ORDR_LNO")

                If dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "' AND ORDR_NO = '" & ORDR_NO & "' AND ORDR_LNO = " & ORDR_LNO).Length = 0 Then
                    Continue For
                End If

                Dim rowSOTPICK2 As DataRow = dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "' AND ORDR_NO = '" & ORDR_NO & "' AND ORDR_LNO = " & ORDR_LNO)(0)
                Dim PICK_LNO As Int16 = rowSOTPICK2.Item("PICK_LNO")

                Dim rowAdd As DataRow = Nothing

                If dst.Tables("SOTCARTPACK").Select("PICK_NO = '" & PICK_NO & "' AND PICK_LNO = " & PICK_LNO).Length = 0 Then
                    rowAdd = dst.Tables("SOTCARTPACK").NewRow
                    rowAdd.Item("PICK_NO") = PICK_NO
                    rowAdd.Item("PICK_LNO") = PICK_LNO
                    rowAdd.Item("STYLE_CODE") = rowSOTCART2.Item("STYLE_CODE")
                    rowAdd.Item("COLOR_CODE") = rowSOTCART2.Item("COLOR_CODE")
                    rowAdd.Item("PICK_QTY") = rowSOTPICK2.Item("PICK_QTY_CONF")
                    dst.Tables("SOTCARTPACK").Rows.Add(rowAdd)
                Else
                    rowAdd = dst.Tables("SOTCARTPACK").Select("PICK_NO = '" & PICK_NO & "' AND PICK_LNO = " & PICK_LNO)(0)
                End If

                rowAdd.Item(COLUMN_NAME) = Val(rowAdd.Item(COLUMN_NAME) & String.Empty) + Val(rowSOTCART2.Item("QTY_PACKED") & String.Empty)
            Next
        Next

        For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("")
            Dim PICK_NO As String = rowSOTPICK2.Item("PICK_NO")
            Dim PICK_LNO As Int16 = rowSOTPICK2.Item("PICK_LNO")

            Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)
            If rowSOTPICK1 IsNot Nothing AndAlso rowSOTPICK1.Item("PICK_STATUS") & String.Empty = "C" Then
                Continue For
            End If

            If dst.Tables("SOTCARTPACK").Select("PICK_NO = '" & PICK_NO & "' AND PICK_LNO = " & PICK_LNO).Length = 0 Then
                Dim rowAdd As DataRow = dst.Tables("SOTCARTPACK").NewRow
                rowAdd.Item("PICK_NO") = PICK_NO
                rowAdd.Item("PICK_LNO") = PICK_LNO
                rowAdd.Item("STYLE_CODE") = rowSOTPICK2.Item("STYLE_CODE")
                rowAdd.Item("COLOR_CODE") = rowSOTPICK2.Item("COLOR_CODE")
                rowAdd.Item("PICK_QTY") = rowSOTPICK2.Item("PICK_QTY_CONF")
                dst.Tables("SOTCARTPACK").Rows.Add(rowAdd)
            End If
        Next

        Dim expression As String = String.Empty
        For Each column As DataColumn In dst.Tables("SOTCARTPACK").Columns
            If column.ColumnName.StartsWith("CPROD") Then
                expression &= " + isnull(" & column.ColumnName & ", 0)"
            End If
        Next

        expression = expression.Trim
        If expression.Length > 0 Then
            expression = expression.Substring(1).Trim
        End If

        COLUMN_NAME = "CPROD_TOTAL"
        dst.Tables("SOTCARTPACK").Columns.Add(COLUMN_NAME, GetType(System.Int32), expression)
        With grdSOTCARTPACK.DisplayLayout.Bands(0).Columns(COLUMN_NAME)
            .Hidden = False
            .CellActivation = UltraWinGrid.Activation.NoEdit
            .Header.Caption = "Total Pieces"
            .Format = "#,##0"
            .CellAppearance.BackColor = Drawing.Color.LightGreen
            .Header.VisiblePosition = 5
        End With

        ASCMAIN1.Progress("", "")
    End Sub

    Private Sub RemoveColumns(ByVal colToRemove As DataColumn)
        ' Get the DataColumnCollection from a DataTable in a DataSet.
        Dim columns As DataColumnCollection = dst.Tables("SOTCARTPACK").Columns

        If columns.Contains(colToRemove.ColumnName) Then
            columns.Remove(colToRemove)
        End If
    End Sub

    Private Sub ReCartonize()

        For Each column As DataColumn In dst.Tables("SOTCARTPACK").Columns
            If column.ColumnName.StartsWith("CPROD") AndAlso column.ColumnName <> "CPROD_TOTAL" Then
                Dim CART_NO As String = column.ColumnName.Replace("CPROD", "")

                For Each rowSOTCART2x As DataRow In dst.Tables("SOTCART2").Select("CART_NO = '" & CART_NO & "'")
                    rowSOTCART2x.Delete()
                Next
                dst.Tables("SOTCART2").AcceptChanges()

                Dim CART_LNO As Int16 = 0

                For Each rowSOTCARTPACK As DataRow In dst.Tables("SOTCARTPACK").Select(column.ColumnName & " > 0")
                    Dim rowSOTCART2 As DataRow = dst.Tables("SOTCART2").NewRow
                    rowSOTCART2.Item("CART_NO") = CART_NO
                    CART_LNO += 1
                    rowSOTCART2.Item("CART_LNO") = CART_LNO

                    Dim PICK_NO As String = rowSOTCARTPACK.Item("PICK_NO")
                    Dim PICK_LNO As Int16 = rowSOTCARTPACK.Item("PICK_LNO")
                    Dim rowSOTPICK2 As DataRow = dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "' AND PICK_LNO = " & PICK_LNO)(0)

                    rowSOTCART2.Item("ORDR_NO") = rowSOTPICK2.Item("ORDR_NO")
                    rowSOTCART2.Item("ORDR_LNO") = rowSOTPICK2.Item("ORDR_LNO")
                    rowSOTCART2.Item("QTY_PACKED") = rowSOTCARTPACK.Item(column.ColumnName)
                    rowSOTCART2.Item("STYLE_CODE") = rowSOTCARTPACK.Item("STYLE_CODE")
                    rowSOTCART2.Item("COLOR_CODE") = rowSOTCARTPACK.Item("COLOR_CODE")

                    rowSOTCART2.Item("QTY_PACKED_ORIG") = rowSOTCART2.Item("QTY_PACKED")
                    rowSOTCART2.Item("PICK_NO") = PICK_NO

                    dst.Tables("SOTCART2").Rows.Add(rowSOTCART2)
                Next

            End If
        Next

    End Sub

