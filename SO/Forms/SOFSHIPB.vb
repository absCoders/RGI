                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & tempTable & ")))"
            Fill_Records("EDT850T8", String.Empty, ClearBeforeFilling, ASCMAIN1.sql)
