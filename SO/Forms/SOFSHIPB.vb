    Private Sub PrintQVCPackingList()

        Try

            If ASCMAIN1.CLIENT <> "RGI" Then
                Exit Sub
            End If

            If CUST_CODE <> RegencyQVCCustCode Then
                Exit Sub
            End If

            ' Prints for only EDI orders
            If dst.Tables("SOTORDR1").Select("ISNULL(EDI_DOC_SEQ_NO, '*') = '*'").Length > 0 Then
                Exit Sub
            End If

            ' Prints for only Ecom orders
            If dst.Tables("SOTORDR1").Select("ISNULL(ECOM_CODE, '*') = '*'").Length > 0 Then
                Exit Sub
            End If

            Dim DISPLAY_RTN_LABEL As Boolean = True
            Dim rowEDT850T1 As DataRow = Nothing
            Dim EDI_DOC_SEQ_NO As String = String.Empty
            Dim EDI_DTL_SEQ As String = String.Empty

            Dim numCartons As Int32 = dst.Tables("SOTCART1").Rows.Count
            Dim lstReturnLabels As New List(Of String)

            For Each row As DataRow In dst.Tables("EDT850TC").Select("EDI_CMT_REF_QUAL = 'OD' AND EDI_CMMNT = 'NEWGISTICS PREPAID LABEL' AND EDI_CMT_REF IS NOT NULL")
                Dim key As String = row.Item("EDI_DTL_SEQ") & ";" & row.Item("EDI_CMT_SEQ")
                If Not lstReturnLabels.Contains(key) Then
                    lstReturnLabels.Add(key)
                End If
            Next

            Dim numPackSlipsToPrint As Int32 = 0
            If numCartons > lstReturnLabels.Count Then
                numPackSlipsToPrint = numCartons
            Else
                numPackSlipsToPrint = lstReturnLabels.Count
            End If

            ' QVC should have only one EDT850T1 and Pick Ticket
            ' Check to see if any items were short shipped. For QVC the entire line must be cancelled, cannot short ship an Item - All or Nothing.
            For Each rowEDT850T1 In dst.Tables("EDT850T1").Select("", "EDI_DOC_SEQ_NO")
                EDI_DOC_SEQ_NO = rowEDT850T1.Item("EDI_DOC_SEQ_NO") & String.Empty

                For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("(ISNULL(PICK_QTY, 0) <> ISNULL(PICK_QTY_CONF, 0)) OR (ISNULL(PICK_QTY, 0) = 0)")
                    Dim ORDR_NO As String = rowSOTPICK2.Item("ORDR_NO") & String.Empty
                    Dim ORDR_LNO As String = Val(rowSOTPICK2.Item("ORDR_LNO") & String.Empty)

                    Dim rowSOTORDR2 As DataRow = dst.Tables("SOTORDR2").Rows.Find(New Object() {ORDR_NO, ORDR_LNO})
                    If rowSOTORDR2 Is Nothing Then
                        MessageBox.Show("Unable to locate sales order details.", "QVC Pack Slip Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Sub
                    End If

                    EDI_DTL_SEQ = Val(rowSOTORDR2.Item("EDI_DTL_SEQ") & String.Empty)
                    Dim rowEDT850T2 As DataRow = dst.Tables("EDT850T2").Rows.Find(New Object() {EDI_DOC_SEQ_NO, EDI_DTL_SEQ})

                    If rowEDT850T2 Is Nothing Then
                        MessageBox.Show("Unable to locate sales order EDI details.", "QVC Pack Slip Error", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Sub
                    End If

                    ' Adjust the header totals - There are formulas that use these values for header totals.
                    rowEDT850T2.Item("EDI_TOTAL_QTY") = 0
                    rowEDT850T2.Item("SHIP_HANDLE") = 0
                    rowEDT850T2.Item("TAX") = 0
                    rowEDT850T2.Item("TOTAL_PRICE") = 0
                Next
            Next

            EDI_DOC_SEQ_NO = String.Empty
            EDI_DTL_SEQ = String.Empty
            Dim lstUsedEDI_CMT_SEQ As New List(Of Int32)
            Dim lstUsedLabelFee As New List(Of Int32)

            ' 6/10/2019 - Number of pack slips should be the number of cartons not the number of TC records. Decided my Maria and Jen since the customer can print the labels online.
            For iLoop As Int32 = 1 To numCartons 'numPackSlipsToPrint

                DISPLAY_RTN_LABEL = False
                Print_Report_Begin()
                CR_params.Add("SUBT", "")

                rowEDT850T1 = Nothing
                If dst.Tables("EDT850T1").Rows.Count > 0 Then
                    rowEDT850T1 = dst.Tables("EDT850T1").Rows(0)
                End If

                If lstReturnLabels.Count > 0 Then

                    ' Some of the entries in EDT850TC use the same EDI_DOC_SEQ_NO, EDI_DTL_SEQ
                    If EDI_DTL_SEQ <> lstReturnLabels(0).ToString.Split(";")(0) Then
                        lstUsedEDI_CMT_SEQ.Clear()
                        lstUsedLabelFee.Clear()
                    End If

                    EDI_DOC_SEQ_NO = rowEDT850T1.Item("EDI_DOC_SEQ_NO") & String.Empty
                    EDI_DTL_SEQ = lstReturnLabels(0).ToString.Split(";")(0)

                    Dim sql As String = "EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "' AND EDI_DTL_SEQ = " & EDI_DTL_SEQ

                    DISPLAY_RTN_LABEL = True

                    rowEDT850T1.Item("RETURN_LABEL_FEE") = 0
                    For Each row As DataRow In dst.Tables("EDT850T8").Select(sql & " and SAH_ALLOW_CODE = 'G500'", "SAH_SEQ_NO")
                        If lstUsedLabelFee.Contains(row.Item("SAH_SEQ_NO")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("RETURN_LABEL_FEE") = Val(row.Item("SAH_AMOUNT") & String.Empty)
                        lstUsedLabelFee.Add(row.Item("SAH_SEQ_NO"))
                        Exit For
                    Next

                    rowEDT850T1.Item("LABEL_TRACKING_NO") = String.Empty
                    For Each row As DataRow In dst.Tables("EDT850TC").Select(sql & " AND EDI_CMT_REF_QUAL = 'OD' AND EDI_CMMNT = 'NEWGISTICS PREPAID LABEL' AND EDI_CMT_REF IS NOT NULL", "EDI_CMT_SEQ")
                        If lstUsedEDI_CMT_SEQ.Contains(row.Item("EDI_CMT_SEQ")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("LABEL_TRACKING_NO") = row.Item("EDI_CMT_REF") & String.Empty
                        lstUsedEDI_CMT_SEQ.Add(row.Item("EDI_CMT_SEQ"))
                        Exit For
                    Next

                    rowEDT850T1.Item("LABEL_CONF_NO") = String.Empty
                    For Each row As DataRow In dst.Tables("EDT850TC").Select(sql & " AND EDI_CMT_REF_QUAL = 'KK' AND EDI_CMT_REF IS NOT NULL", "EDI_CMT_SEQ")
                        If lstUsedEDI_CMT_SEQ.Contains(row.Item("EDI_CMT_SEQ")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("LABEL_CONF_NO") = row.Item("EDI_CMT_REF") & String.Empty
                        lstUsedEDI_CMT_SEQ.Add(row.Item("EDI_CMT_SEQ"))
                        Exit For
                    Next

                    rowEDT850T1.Item("RETURN_SERVICE_POSTAL_CODE") = String.Empty
                    For Each row As DataRow In dst.Tables("EDT850TC").Select(sql & " AND EDI_CMT_REF_QUAL = '4C' AND EDI_CMT_REF IS NOT NULL", "EDI_CMT_SEQ")
                        If lstUsedEDI_CMT_SEQ.Contains(row.Item("EDI_CMT_SEQ")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("RETURN_SERVICE_POSTAL_CODE") = row.Item("EDI_CMT_REF") & String.Empty
                        lstUsedEDI_CMT_SEQ.Add(row.Item("EDI_CMT_SEQ"))
                        Exit For
                    Next

                    rowEDT850T1.Item("RETURN_PERMIT_NO") = String.Empty
                    For Each row As DataRow In dst.Tables("EDT850TC").Select(sql & " AND EDI_CMT_REF_QUAL = 'PN' AND EDI_CMT_REF IS NOT NULL", "EDI_CMT_SEQ")
                        If lstUsedEDI_CMT_SEQ.Contains(row.Item("EDI_CMT_SEQ")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("RETURN_PERMIT_NO") = row.Item("EDI_CMT_REF") & String.Empty
                        lstUsedEDI_CMT_SEQ.Add(row.Item("EDI_CMT_SEQ"))
                        Exit For
                    Next

                    rowEDT850T1.Item("PARTNER_SORT_CODE") = String.Empty
                    For Each row As DataRow In dst.Tables("EDT850TC").Select(sql & " AND EDI_CMT_REF_QUAL = 'RU' AND EDI_CMT_REF IS NOT NULL", "EDI_CMT_SEQ")
                        If lstUsedEDI_CMT_SEQ.Contains(row.Item("EDI_CMT_SEQ")) Then
                            Continue For
                        End If

                        rowEDT850T1.Item("PARTNER_SORT_CODE") = row.Item("EDI_CMT_REF") & String.Empty
                        lstUsedEDI_CMT_SEQ.Add(row.Item("EDI_CMT_SEQ"))
                        Exit For
                    Next

                    lstReturnLabels.RemoveAt(0)
                End If

                If DISPLAY_RTN_LABEL Then
                    CR_params.Add("DISPLAY_RTN_LABEL", "1")
                Else
                    CR_params.Add("DISPLAY_RTN_LABEL", "0")
                End If

                Dim RPT As String = "SORPICKQ"
                Generate_Report(RPT, "QVC Pack Slip", String.Empty, String.Empty, "RPT", String.Empty, False)

                ' QVC prints on the alternate printer. Should be crack and peel paper.
                If AltLaserPrinterIpAddress.Length > 0 OrElse AltLaserPrinterName.Length > 0 Then
                    Print_Report_End(True, False, AltLaserPrinterName, , AltLaserPrinterIpAddress)
                ElseIf LaserPrinterIpAddress.Length > 0 OrElse LaserPrinterName.Length > 0 Then
                    Print_Report_End(True, False, LaserPrinterName, , LaserPrinterIpAddress)
                Else
                    Print_Report_End()
                End If
            Next

            ' Set the invoice as printed
            Try
                For Each row As DataRow In dst.Tables("SOTINVH1").Rows
                    ASCMAIN1.sql = "Update SOTINVH1 Set INV_PRINTED = SYSDATE where INV_NO = '" & row.Item("INV_NO") & "' AND INV_PRINTED IS NULL"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
                Next
            Catch ex As Exception

            End Try

        Catch ex As Exception
            MessageBox.Show("Error generating QVC Packing List: " & ex.Message, "", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            ASCMAIN1.Progress(String.Empty, String.Empty)
        End Try
    End Sub

