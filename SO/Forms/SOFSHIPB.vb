    Sub Load_Record()

        Save_Header_Fields(UltraGroupBox1)
        EnforceConstraints(False)

        Me.Cursor = Cursors.WaitCursor
        ASCMAIN1.Progress("Now Loading Data")

        ToggleDataTableExpressions(False)

        If EntryMode = "N" Then
        Else
            ASCMAIN1.Progress("Now Loading Data", "ARTCUST1")
            rowARTCUST1 = LookUp("ARTCUST1", CUST_CODE)

            Dim GL_PARM_CURR_CODE As String = ROWs("GLTPARM1").Item("GL_PARM_CURR_CODE") & ""
            CURR_CODE = rowARTCUST1.Item("CURR_CODE") & ""
            If CURR_CODE = "" OrElse CURR_CODE = GL_PARM_CURR_CODE Then
                CURR_CODE = GL_PARM_CURR_CODE
                CURR_EXCH_RATE = 1
            Else
                Dim rowTATCURR1 As DataRow = LookUp("TATCURR1", rowARTCUST1.Item("CURR_CODE"))
                CURR_CODE = rowTATCURR1.Item("CURR_CODE")
                CURR_EXCH_RATE = rowTATCURR1.Item("CURR_EXCH_CUR")
            End If

            lblCurrencyCode.Text = CURR_CODE & " Currency"
            lblCurrencyCode.Visible = CURR_CODE <> GL_PARM_CURR_CODE

            ASCMAIN1.Progress("Now Loading Data", "EDTTRPMC")
            Fill_Records("EDTTRPMC", CUST_CODE)
            edi_customer = (dst.Tables("EDTTRPMC").Rows.Count <> 0)
            Dim rowEDTTRPMC As DataRow = dst.Tables("EDTTRPMC").Rows.Find(New Object() {CUST_CODE, "856"})
            edi856_customer = rowEDTTRPMC IsNot Nothing AndAlso rowEDTTRPMC.Item("EDI_STATUS") & "" = "P"
            lblASN.Visible = (edi856_customer And edi_order)

            ASCMAIN1.Progress("-", "SOTORDR0")
            Dim rowSOTORDR0 As DataRow = LookUp("SOTORDR0", ORDR_GROUP_NO)
            If Not processingMasterBOL Then
                ORDR_SHIP_DATE = rowSOTORDR0.Item("ORDR_SHIP_DATE")
                ORDR_CANCEL_DATE = rowSOTORDR0.Item("ORDR_CANCEL_DATE")
                dteORDR_SHIP_DATE.Value = ORDR_SHIP_DATE
                dteORDR_CANCEL_DATE.Value = ORDR_CANCEL_DATE
            Else
                If MASTER_BOL_NO.Length = 0 Then
                    ASCMAIN1.Progress("Now Loading Data", "SOTSHIPS")
                    For Each rowSOTSHIPS As DataRow In dst.Tables("SOTSHIPS").Select("SEL = '1'")
                        If dst.Tables("SOTSHIPX").Select("BILL_OF_LADING_NO = '" & rowSOTSHIPS.Item("BOL_NO") & "'").Length > 0 Then
                            ORDR_GROUP_NO = dst.Tables("SOTSHIPX").Select("BILL_OF_LADING_NO = '" & rowSOTSHIPS.Item("BOL_NO") & "'")(0).Item("ORDR_GROUP_NO") & String.Empty
                        End If
                        If ORDR_GROUP_NO.Length > 0 Then
                            rowSOTORDR0 = LookUp("SOTORDR0", ORDR_GROUP_NO)
                            ORDR_SHIP_DATE = rowSOTORDR0.Item("ORDR_SHIP_DATE")
                            ORDR_CANCEL_DATE = rowSOTORDR0.Item("ORDR_CANCEL_DATE")
                            dteORDR_SHIP_DATE.Value = ORDR_SHIP_DATE
                            dteORDR_CANCEL_DATE.Value = ORDR_CANCEL_DATE
                            Exit For
                        End If
                    Next
                End If
            End If
            txtReason.Text = ""

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR1")
            ASCMAIN1.sql = "Select Count (*) from SOTORDR1 where ORDR_GROUP_NO = '" & ORDR_GROUP_NO & "' and ORDR_SOURCE = 'E'"
            edi_order = (Val(ASCDATA1.GetDataValue) <> 0)
            If edi_order Then
                lblSource.Text = "EDI"
            Else
                lblSource.Text = "Manual"
            End If

            If MASTER_BOL_NO.Length = 0 Then
                ASCMAIN1.sql = "Select Distinct ORDR_SOURCE from SOTORDR1 where ORDR_GROUP_NO = '" & ORDR_GROUP_NO & "'"
                Dim rowORDR_SOURCE As DataRow = ASCDATA1.GetDataRow
                ORDR_SOURCE = rowORDR_SOURCE.Item("ORDR_SOURCE")
            Else
                ORDR_SOURCE = String.Empty
            End If

            isLpCodeWarehouse = False

            If isEcommProcessing Then
                Dim tbl As DataTable = ASCDATA1.GetDataTable("select * from ictwhse1 where whse_code = (select whse_code from sotship1 where ship_bol_no in (select ship_bol_no from " & SOTSHIP0 & ")) and lp_code is null")
                If tbl.Rows.Count = 0 Then
                    isLpCodeWarehouse = True
                End If
            End If

            Dim sqlwhere_SOTSHIP1 As String = "" _
                & "   and SOTSHIP1.SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & ")" & vbCrLf _
                & IIf(InquiryMode,
                      "",
                      "" _
                        & "   and SOTSHIP1.SHIP_STATUS = 'P'" & vbCrLf _
                        & IIf((isLpCodeWarehouse OrElse isEcommProcessing) AndAlso Not InquiryMode, "", "   and SOTSHIP1.SHIP_PICK_PRINTED is Not Null"))

            ASCMAIN1.sql = sqlSOTSHIPX & vbCrLf _
                & sqlwhere_SOTSHIP1
            ' this is hokey
            If ASCMAIN1.CLIENT = "RGI" AndAlso processing_select_from_3PL_list AndAlso isEcommProcessing Then
                ASCMAIN1.sql = ASCMAIN1.sql.ToUpper.Replace("ICTWHSE1.LP_CODE IS NULL", "ICTWHSE1.LP_CODE IS NOT NULL")
                ASCMAIN1.sql = ASCMAIN1.sql.ToUpper.Replace("AND ICTWHSE1.WHSE_CODE <> 'CG'", "")
            End If

            ASCMAIN1.Progress("Now Loading Data", "SOTSHIP1")
            Fill_Records("SOTSHIP1", "", True, ASCMAIN1.sql)
            If dst.Tables("SOTSHIP1").Rows.Count <> SHIP_BOL_NOs.Count Then ' NEED AN ABORT LOAD FEATURE IN STDS
                If ASCMAIN1.CLIENT = "VAN" AndAlso MENU_ITEM_OBJECT = "SOFSHIPB" Then
                    ' Vandale wants to merge Consolidated and Non Consolidate shipments in a delivery
                    Dim tbl As DataTable = ASCDATA1.GetDataTable("SELECT SHIP_BOL_NO, SHIP_BOL_NO_CONS FROM SOTSHIP1 WHERE SHIP_BOL_NO IN (SELECT SHIP_BOL_NO FROM " & SOTSHIP0 & ")")
                    If tbl.Select("ISNULL(SHIP_BOL_NO_CONS, '') <> ''").Length > 0 Then
                        ASCMAIN1.sql = ASCMAIN1.sql.Replace(sqlEDI_CONS_NO, "")
                        Fill_Records("SOTSHIP1", "", True, ASCMAIN1.sql)
                    End If
                End If
            End If

            If dst.Tables("SOTSHIP1").Rows.Count <> SHIP_BOL_NOs.Count Then
                Stop ' NEED AN ABORT LOAD FEATURE IN STDS
            End If

            Dim rowICTWHSE1 As DataRow = dst.Tables("ICTWHSE1").Rows.Find(dst.Tables("SOTSHIP1").Rows(0).Item("WHSE_CODE") & String.Empty)
            isLpCodeWarehouse = rowICTWHSE1.Item("LP_CODE") & String.Empty <> String.Empty

            If ASCMAIN1.CLIENT = "RGI" AndAlso isEcommProcessing AndAlso isLpCodeWarehouse AndAlso Not processing_select_from_3PL_list Then
                For Each roSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("")
                    roSOTSHIP1.Item("FRT_TERMS") = "PPD"
                Next
            End If

            MASTER_SHIP_BOL_NO = dst.Tables("SOTSHIP1").Compute("MAX(MASTER_SHIP_BOL_NO)", "") & String.Empty
            If MASTER_SHIP_BOL_NO.Length = 0 Then
                MASTER_SHIP_BOL_NO = dst.Tables("SOTSHIP1").Rows(0).Item("SHIP_BOL_NO")
            End If

            Dim fillPickBol As Boolean = False
            If Not InquiryMode AndAlso Not MaintenanceMode AndAlso Not select_from_3PL_list Then
                If BOL_NO.Length = 0 AndAlso Not processingMasterBOL Then

                    If ASCMAIN1.CLIENT = "VAN" Then
                        BOL_NO = TAC.SOCMAIN1.UPC(Me, dst.Tables("SOTSHIP1").Rows(0).Item("SHIP_BOL_NO").ToString.Substring(1), "0" & ROWs("SOTPARM1").Item("SO_PARM_UPC_VENDOR_ID"))
                    Else
                        BOL_NO = TAC.SOCMAIN1.UPC(Me, ASCMAIN1.Next_Control_No("SOTSHIPB.BOL_NO"), "0" & ROWs("SOTPARM1").Item("SO_PARM_UPC_VENDOR_ID"))
                    End If

                    For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("")
                        rowSOTSHIP1.Item("BILL_OF_LADING_NO") = BOL_NO
                        If SHIP_BOL_NO_CONS.Length > 0 Then
                            rowSOTSHIP1.Item("MASTER_SHIP_BOL_NO") = SHIP_BOL_NO_CONS
                        Else
                            rowSOTSHIP1.Item("MASTER_SHIP_BOL_NO") = MASTER_SHIP_BOL_NO
                        End If
                    Next

                    fillPickBol = True

                    Absx1.txtFor("BILL_OF_LADING_NO").Text = BOL_NO
                    Absx1.txtFor("BILL_OF_LADING_NO").Appearance.BackColorDisabled = Drawing.Color.White
                    Absx1.txtFor("BILL_OF_LADING_NO").Appearance.ForeColorDisabled = Drawing.Color.Black
                    ' DON'T DO THIS - THERE IS CODE IN UPDATE THAT WILL DELETE ALL SOTSHIP1 BASED ON BILL_OF_LADING_NO - THIS IS A CONTROL NUMBER, NOT SUPPOSED TO NE KEYED IN
                    'If ASCMAIN1.CLIENT = "VAN" Then
                    '    Absx1.txtFor("BILL_OF_LADING_NO").Enabled = True
                    'Else
                    Absx1.txtFor("BILL_OF_LADING_NO").Enabled = False
                    'End If
                End If
            End If

            ASCMAIN1.Progress("Now Loading Data", "SOTPICK1")
            ASCMAIN1.sql = sqlSOTPICK1 & vbCrLf _
                & " where SOTORDR1.ORDR_NO = SOTPICK1.ORDR_NO" & vbCrLf _
                & "   and SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                & sqlwhere_SOTSHIP1
            Fill_Records("SOTPICK1", "", True, ASCMAIN1.sql)

            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                rowSOTPICK1.Item("PICK_FREIGHT_ORIG") = rowSOTPICK1.Item("PICK_FREIGHT")
            Next

            If fillPickBol Then
                For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                    rowSOTPICK1.Item("BILL_OF_LADING_NO") = BOL_NO
                Next
            End If

            ASCMAIN1.Progress("Now Loading Data", "SOTPICK5")
            Fill_Records("SOTPICK5")
            ASCMAIN1.Progress("Now Loading Data", "WHTCARTX")
            Fill_Records("WHTCARTX")

            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                rowSOTPICK1.Item("SELECTED") = "1"
                rowSOTPICK1.Item("PICKED") = ASCDATA1.GetDataValue("SELECT MIN(TO_CHAR(INIT_DATE,'yyyy-mm-dd hh24:mi:ss')) PICKED FROM SOTPICK5 WHERE PICK_NO = '" & rowSOTPICK1.Item("PICK_NO") & "'")
            Next

            ' Hide / Display Curr Code column
            If dst.Tables("SOTPICK1").Select("CURR_CODE <> '" & ROWs("GLTPARM1").Item("GL_PARM_CURR_CODE") & "'").Length > 0 Then
                grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = False
            Else
                grdSOTPICK1.DisplayLayout.Bands(0).Columns("CURR_CODE").Hidden = True
            End If

            dst.Tables("SOTSHIP2").Rows.Clear()
            dst.Tables("WHTSHPC1").Rows.Clear()
            ASCMAIN1.Progress("Now Loading Data", "SOTSHIP2 - WHTSHPC1")
            For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("")
                ASCMAIN1.Progress("Now Loading Data", "SOTSHIP2")
                Fill_Records("SOTSHIP2", String.Empty, False, "SELECT * FROM SOTSHIP2 WHERE SHIP_BOL_NO = '" & rowSOTSHIP1.Item("SHIP_BOL_NO") & "'")
                ASCMAIN1.Progress("Now Loading Data", "WHTSHPC1")
                Fill_Records("WHTSHPC1", String.Empty, False, "SELECT * FROM WHTSHPC1 WHERE SHIP_BOL_NO = '" & rowSOTSHIP1.Item("SHIP_BOL_NO") & "' AND SHIP_CNTL_NO = (SELECT MAX(SHIP_CNTL_NO) FROM WHTSHPC1 WHERE SHIP_BOL_NO = '" & rowSOTSHIP1.Item("SHIP_BOL_NO") & "')")
            Next
            If ASCMAIN1.CLIENT = "VAN" And dst.Tables("SOTSHIP2").Rows.Count = 0 Then
                'for when Master ship bol no is replaced by new ship bol
                Fill_Records("SOTSHIP2", String.Empty, False, "SELECT * FROM SOTSHIP2 WHERE SHIP_BOL_NO = '" & MASTER_SHIP_BOL_NO & "'")
            End If

            Try
                For Each rowWHTSHPC1 As DataRow In dst.Tables("WHTSHPC1").Select("")
                    Dim SHIP_CNTL_NO As String = rowWHTSHPC1.Item("SHIP_CNTL_NO")
                    For Each tableName As String In New String() {"WHTSHPC1", "WHTSHPC2", "WHTSHPC3", "WHTSHPC4", "WHTSHPC5", "WHTSHPCG", "WHTSHPCA", "WHTSHPCC", "WHTSHPCS", "WHTSHPCP"}
                        ASCMAIN1.Progress("Now Loading Data", tableName)
                        If InquiryMode Then
                            Fill_Records(tableName, SHIP_CNTL_NO, False)
                        Else
                            ' Always require new rates
                            ASCDATA1.ExecuteSQL("Delete from " & tableName & " where SHIP_CNTL_NO = '" & SHIP_CNTL_NO & "'")
                        End If
                    Next
                Next
            Catch ex As Exception

            Finally
                If Not InquiryMode Then
                    dst.Tables("WHTSHPC1").Rows.Clear()
                End If
            End Try

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR1")
            ASCMAIN1.sql = "Select * from SOTORDR1 where ORDR_NO in" & vbCrLf _
               & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))"
            Fill_Records("SOTORDR1", String.Empty, True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR2")
            ASCMAIN1.sql = "Select SOTORDR2.*, SOTORDR2.ORDR_UNIT_PRICE ORDR_UNIT_PRICE_ORIG from SOTORDR2 where ORDR_NO in" & vbCrLf _
              & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))"
            Fill_Records("SOTORDR2", String.Empty, True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR2_DUTY")
            ASCMAIN1.sql = sqlDuty.Replace("'**'", "(Select Distinct PICK_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))")
            Fill_Records("SOTORDR2_DUTY", String.Empty, True, ASCMAIN1.sql)
            Fill_Summary_Hts()

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR5")
            ASCMAIN1.sql = "Select * from SOTORDR5 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))" & vbCrLf _
                & " and CUST_ADDR_TYPE = 'ST'"
            Fill_Records("SOTORDR5", "", True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR5_BT")
            ASCMAIN1.sql = "Select * from SOTORDR5 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))" & vbCrLf _
                & " and CUST_ADDR_TYPE = 'BT'"
            Fill_Records("SOTORDR5_BT", "", True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "FillEDT850Tables")
            FillEDT850Tables(SOTSHIP0, True)

            ASCMAIN1.Progress("Now Loading Data", "ICTSTYLD")
            ASCMAIN1.sql = "SELECT * FROM ICTSTYLD WHERE STYLE_CODE IN (Select STYLE_CODE from SOTORDR2 where ORDR_NO in" & vbCrLf _
              & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & ")))"
            Fill_Records("ICTSTYLD", "", True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "ICTSTYC1")
            ASCMAIN1.sql = "SELECT * FROM ICTSTYC1 WHERE (STYLE_CODE, COLOR_CODE) IN (Select STYLE_CODE, COLOR_CODE from SOTORDR2 where ORDR_NO in" & vbCrLf _
                & "(Select Distinct ORDR_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & ")))"
            Fill_Records("ICTSTYC1", "", True, ASCMAIN1.sql)

            If dst.Tables("SOTORDR5_BT").Rows.Count = 0 AndAlso MASTER_BOL_NO.Length = 0 Then
                Dim rowSOTORDR5_BT As DataRow = dst.Tables("SOTORDR5_BT").NewRow
                rowSOTORDR5_BT.Item("ORDR_NO") = "XXX"
                rowSOTORDR5_BT.Item("CUST_ADDR_TYPE") = "BT"
                rowSOTORDR5_BT.Item("CUST_ADDR_CODE") = rowARTCUST1.Item("CUST_CODE")
                rowSOTORDR5_BT.Item("CUST_NAME") = rowARTCUST1.Item("CUST_NAME")
                rowSOTORDR5_BT.Item("CUST_ADDR1") = rowARTCUST1.Item("CUST_ADDR1")
                rowSOTORDR5_BT.Item("CUST_ADDR2") = rowARTCUST1.Item("CUST_ADDR2")
                rowSOTORDR5_BT.Item("CUST_CITY") = rowARTCUST1.Item("CUST_CITY")
                rowSOTORDR5_BT.Item("CUST_STATE") = rowARTCUST1.Item("CUST_STATE")
                rowSOTORDR5_BT.Item("CUST_ZIP_CODE") = rowARTCUST1.Item("CUST_ZIP_CODE")
                rowSOTORDR5_BT.Item("CUST_COUNTRY") = rowARTCUST1.Item("CUST_COUNTRY")
                rowSOTORDR5_BT.Item("CUST_CONTACT") = rowARTCUST1.Item("CUST_CONTACT")
                rowSOTORDR5_BT.Item("CUST_PHONE") = rowARTCUST1.Item("CUST_PHONE")
                rowSOTORDR5_BT.Item("CUST_EXT") = rowARTCUST1.Item("CUST_EXT")
                rowSOTORDR5_BT.Item("CUST_FAX") = rowARTCUST1.Item("CUST_FAX")
                rowSOTORDR5_BT.Item("CUST_EMAIL") = rowARTCUST1.Item("CUST_EMAIL")
                rowSOTORDR5_BT.Item("CUST_ADDR3") = rowARTCUST1.Item("CUST_ADDR3")
                dst.Tables("SOTORDR5_BT").Rows.Add(rowSOTORDR5_BT)
            End If

            ASCMAIN1.Progress("Now Loading Data", "ARTCUSTS")
            Fill_Records("ARTCUSTS", CUST_CODE)

            ASCMAIN1.Progress("Now Loading Data", "SOTINVHM")
            ASCMAIN1.sql = "Select * from SOTINVHM where INV_NO in" & vbCrLf _
                & "(Select Distinct INV_NO from SOTPICK1 where SHIP_BOL_NO in (Select SHIP_BOL_NO from " & SOTSHIP0 & "))"
            Fill_Records("SOTINVHM", String.Empty, True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "WHTWAVEP2L")
            Fill_Records("WHTWAVEP2L")

            If Not InquiryMode AndAlso Not processingMasterBOL Then
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("")
                    For Each COLUMN_NAME As String In New String() _
                        {"FRT_TERMS", "SHIP_VIA_CODE"}
                        If rowSOTSHIP1.Item(COLUMN_NAME) & "" = "" Then rowSOTSHIP1.Item(COLUMN_NAME) = rowARTCUST1.Item(COLUMN_NAME)
                    Next
                    If rowSOTSHIP1.Item("TERM_CODE") & "" = "" Then
                        If rowARTCUST1.Item("TERM_CODE") & "" <> "" Then
                            rowSOTSHIP1.Item("TERM_CODE") = rowARTCUST1.Item("TERM_CODE")
                            For Each rowSOTPICK1 As DataRow In rowSOTSHIP1.GetChildRows("SOTSHIP1_SOTPICK1")
                                rowSOTPICK1.Item("TERM_CODE") = rowARTCUST1.Item("TERM_CODE")
                            Next
                        End If
                    End If
                Next

                Dim rowSOTPICK1_0 As DataRow = dst.Tables("SOTPICK1").Rows(0)
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("")
                    ' 09/20/2019 - do not overwrite ORDR_DEPT on the shipment records
                    For Each COLUMN_NAME As String In New String() {"SREP_CODE", "SREP2_CODE", "TERM_CODE"} ' "ORDR_DEPT"
                        If rowSOTSHIP1.Item(COLUMN_NAME) & "" = "" Then rowSOTSHIP1.Item(COLUMN_NAME) = rowSOTPICK1_0.Item(COLUMN_NAME)
                    Next
                Next
            End If

            Dim row As DataRow = dst.Tables("SOTSHIP1").Rows(0)
            If isEcommProcessing Then
                Dim SHIP_BOL_NO As String = row.Item("SHIP_BOL_NO") & String.Empty
                For Each rowDel As DataRow In dst.Tables("SOTSHIP0").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                    rowDel.Delete()
                Next
                dst.Tables("SOTSHIP0").AcceptChanges()
            End If

            rowSOTSHIP0 = dst.Tables("SOTSHIP0").NewRow
            For i As Integer = 0 To dst.Tables("SOTSHIP0").Columns.Count - 1
                rowSOTSHIP0.Item(i) = row.Item(i)
            Next
            dst.Tables("SOTSHIP0").Rows.Add(rowSOTSHIP0)

            rowSOTSHIP0_ORIG = dst.Tables("SOTSHIP0").NewRow
            rowSOTSHIP0_ORIG.ItemArray = rowSOTSHIP0.ItemArray

            chkFactored.Checked = (dst.Tables("SOTPICK1").Select("CUST_FACTOR_IND = '1'").Length > 0)

            ASCMAIN1.Progress("Now Loading Data", "SOTPICK2")
            ASCMAIN1.sql = sqlSOTPICK2 & vbCrLf _
                & " where SOTPICK2.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                & "   and SOTORDR1.ORDR_NO = SOTORDR2.ORDR_NO" & vbCrLf _
                & "   and SOTORDR2.ORDR_NO = SOTPICK2.ORDR_NO" & vbCrLf _
                & "   and SOTORDR2.ORDR_LNO = SOTPICK2.ORDR_LNO" & vbCrLf _
                & "   and SOTPICK1.SHIP_BOL_NO = SOTSHIP1.SHIP_BOL_NO" & vbCrLf _
                & "   and SOTORDR2.STYLE_CODE = ICTSTYL1.STYLE_CODE" & vbCrLf _
                & "   and ICTCOLR1.COLOR_CODE (+) = SOTORDR2.COLOR_CODE" & vbCrLf _
                & "   and SOTORDR2.STYLE_CODE = ICTSTYC1.STYLE_CODE (+) AND SOTORDR2.COLOR_CODE = ICTSTYC1.COLOR_CODE (+)" _
                & sqlwhere_SOTSHIP1
            Fill_Records("SOTPICK2", "", True, ASCMAIN1.sql)

            ASCMAIN1.Progress("Now Loading Data", "SOTORDR9")
            Fill_Records("SOTORDR9", ORDR_GROUP_NO)

            ASCMAIN1.Progress("Now Loading Data", "SOTCART1")
            ASCMAIN1.sql = "Select SOTCART1.*, SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                & " from SOTCART1,SOTPICK1,SOTSHIP1" & vbCrLf _
                & " where SOTCART1.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                & "   and SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                & sqlwhere_SOTSHIP1
            Fill_Records("SOTCART1", "", True, ASCMAIN1.sql)

            ' Verify the Packing code is valid for Packaging Type - Our Package
            If Not InquiryMode Then
                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("ISNULL(PACKAGING_TYPE, '" & defaultPACKAGING_TYPE & "') = '" & defaultPACKAGING_TYPE & "'")
                    Dim PKG_CODE As String = rowSOTCART1.Item("PKG_CODE") & String.Empty
                    rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
                    Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(PKG_CODE)
                    If rowWHTPKGM1 Is Nothing Then
                        rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE
                    End If
                Next
            End If

            If Not InquiryMode AndAlso isEcommProcessing Then
                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("")
                    ASCDATA1.ExecuteSQL("DELETE FROM SOTCART1 WHERE CART_NO = '" & rowSOTCART1.Item("CART_NO") & "'")
                    ASCDATA1.ExecuteSQL("DELETE FROM SOTCART2 WHERE CART_NO = '" & rowSOTCART1.Item("CART_NO") & "'")
                Next

                ' Create new cartons for each item as the user scans the product
                dst.Tables("SOTCART1").Rows.Clear()
                dst.Tables("SOTCART2").Rows.Clear()
            End If

            Dim CART_SEQ As Int32 = 1
            Dim cartPickNo As String = String.Empty
            Dim listCartNo As New List(Of String)

            For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("", "PICK_NO")

                listCartNo.Add(rowSOTCART1.Item("CART_NO"))

                If cartPickNo <> rowSOTCART1.Item("PICK_NO") & String.Empty Then
                    CART_SEQ = 1
                    cartPickNo = rowSOTCART1.Item("PICK_NO") & String.Empty
                End If

                ' default to packaging code 31 - Our package
                rowSOTCART1.Item("PACKAGING_TYPE") = defaultPACKAGING_TYPE
                If Val(rowSOTCART1.Item("CART_SEQ") & String.Empty) = 0 Then
                    rowSOTCART1.Item("CART_SEQ") = CART_SEQ
                End If
                CART_SEQ += 1
                If edi_order And edi856_customer Then
                    rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")

                ElseIf ASCMAIN1.CLIENT = "RGI" Then
                    ' For RGI set weight and carton type
                    If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                        rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = rowSOTCART1.Item("CART_TOTAL_WGT_CALC")
                    End If
                    If Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty) = 0 Then
                        rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") = 1
                    End If

                    If rowSOTCART1.Item("REFERENCE1") & String.Empty = String.Empty Then
                        rowSOTCART1.Item("REFERENCE1") = Val(rowSOTCART1.Item("PICK_NO") & String.Empty)
                    End If

                    If rowSOTCART1.Item("REFERENCE2") & String.Empty = String.Empty Then
                        rowSOTCART1.Item("REFERENCE2") = rowSOTCART1.Item("CART_NO") & String.Empty
                    End If

                    ' Default - If OTHER then dimensions may have been saved.
                    If rowSOTCART1.Item("PKG_CODE") & String.Empty = String.Empty OrElse rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE Then
                        rowSOTCART1.Item("PKG_CODE") = defaultPKG_CODE
                    Else
                        Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(rowSOTCART1.Item("PKG_CODE") & String.Empty)
                        If rowWHTPKGM1 IsNot Nothing Then
                            rowSOTCART1.Item("PKG_L") = Val(rowWHTPKGM1.Item("PKG_L") & String.Empty)
                            rowSOTCART1.Item("PKG_H") = Val(rowWHTPKGM1.Item("PKG_H") & String.Empty)
                            rowSOTCART1.Item("PKG_W") = Val(rowWHTPKGM1.Item("PKG_W") & String.Empty)
                        End If
                    End If
                End If
            Next

            ' Sync the weights between the cartons and pick tickets. Total carton weight cannot be less than pick ticket total weight
            For Each rowSOTPICK1 As DataRow In dst.Tables("SOTPICK1").Select("")
                Dim PICK_NO As String = rowSOTPICK1.Item("PICK_NO")

                Dim pickWeight As Decimal = Val(rowSOTPICK1.Item("PICK_TOTAL_WGT") & String.Empty)
                Dim totalCartWeight As Decimal = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "PICK_NO = '" & PICK_NO & "'") & String.Empty)

                If pickWeight < totalCartWeight Then
                    rowSOTPICK1.Item("PICK_TOTAL_WGT") = totalCartWeight
                End If
            Next

            If InquiryMode OrElse Not isEcommProcessing Then
                ASCMAIN1.sql = "Select SOTCART2.*, SOTCART1.PICK_NO, SOTCART2.QTY_PACKED QTY_PACKED_ORIG" & vbCrLf _
                        & " from SOTCART2, SOTCART1, SOTPICK1, SOTSHIP1" & vbCrLf _
                    & " where SOTCART1.PICK_NO = SOTPICK1.PICK_NO" & vbCrLf _
                    & "   and SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO" & vbCrLf _
                    & "   and SOTCART2.CART_NO = SOTCART1.CART_NO" & vbCrLf _
                    & sqlwhere_SOTSHIP1
                ASCMAIN1.Progress("Now Loading Data", "SOTCART2")
                Fill_Records("SOTCART2", "", True, ASCMAIN1.sql)
            End If

            ASCMAIN1.Progress("Now Loading Data", "SetPickQuantityConfirmed")
            SetPickQuantityConfirmed()

            If BillOfLadingMode Then
                If dst.Tables("SOTSHIP1").Rows.Count > 0 Then
                    BOL_NO = dst.Tables("SOTSHIP1").Rows(0).Item("BILL_OF_LADING_NO") & String.Empty
                    If MASTER_BOL_NO.Length > 0 Then
                        BOL_NO = MASTER_BOL_NO
                    End If

                    ASCMAIN1.Progress("Now Loading Data", "SOTSHIPB")
                    Fill_Records("SOTSHIPB", BOL_NO)

                    If dst.Tables("SOTSHIPB").Select("SHIP_BOL_NO_CONS IS NOT NULL").Length > 0 Then
                        SHIP_BOL_NO_CONS = dst.Tables("SOTSHIPB").Select("SHIP_BOL_NO_CONS IS NOT NULL")(0).Item("SHIP_BOL_NO_CONS") & String.Empty
                    End If

                    If Not InquiryMode Then
                        If dst.Tables("SOTSHIPB").Rows.Count = 0 Then
                            ASCMAIN1.Progress("Now Loading Data", "CreateSOTSHIPB")
                            CreateSOTSHIPB(dst.Tables("SOTSHIP1").Rows(0))
                        ElseIf processingMasterBOL Then
                            ASCMAIN1.Progress("Now Loading Data", "CreateMasterSOTSHIPB")
                            CreateMasterSOTSHIPB()
                        End If
                    ElseIf processingMasterBOL Then
                        ASCMAIN1.Progress("Now Loading Data", "CreateMasterSOTSHIPB")
                        CreateMasterSOTSHIPB()
                    End If
                End If

                If Not InquiryMode Or ASCMAIN1.CLIENT = "VAN" Then
                    If dst.Tables("SOTSHIP2").Rows.Count = 0 Or ASCMAIN1.CLIENT = "VAN" Then
                        For Each rowSOTSHIP2X As DataRow In ASCDATA1.SelectDistinct("SOTORDR1", New String() {"ORDR_CUST_PO"}).Select("", "ORDR_CUST_PO")
                            rowSOTSHIP2X.Item("ORDR_CUST_PO") = (rowSOTSHIP2X.Item("ORDR_CUST_PO") & String.Empty).ToString.Trim
                            If rowSOTSHIP2X.Item("ORDR_CUST_PO").ToString.Length = 0 Then
                                Continue For
                            End If
                            ASCMAIN1.Progress("Now Loading Data", "CreateSotship2Entry")
                            CreateSotship2Entry(rowSOTSHIP2X.Item("ORDR_CUST_PO"))
                        Next
                    End If
                End If
            End If

            If dst.Tables("SOTSHIPB").Rows.Count > 0 Then
                Dim rowSOTSHIPB As DataRow = dst.Tables("SOTSHIPB").Rows(0)
                Absx1.medFor("FRT_3PY_PHONE").Text = rowSOTSHIPB.Item("FRT_3PY_PHONE") & String.Empty
                Absx1.txtFor("FRT_3PY_CODE").Text = rowSOTSHIPB.Item("FRT_3PY_CODE") & String.Empty
                Absx1.txtFor("FRT_3PY_NAME").Text = rowSOTSHIPB.Item("FRT_3PY_NAME") & String.Empty
                Absx1.txtFor("FRT_3PY_ADDR1").Text = rowSOTSHIPB.Item("FRT_3PY_ADDR1") & String.Empty
                Absx1.txtFor("FRT_3PY_ADDR2").Text = rowSOTSHIPB.Item("FRT_3PY_ADDR2") & String.Empty
                Absx1.txtFor("FRT_3PY_CITY").Text = rowSOTSHIPB.Item("FRT_3PY_CITY") & String.Empty
                Absx1.txtFor("FRT_3PY_STATE").Text = rowSOTSHIPB.Item("FRT_3PY_STATE") & String.Empty
                Absx1.txtFor("FRT_3PY_ZIP_CODE").Text = rowSOTSHIPB.Item("FRT_3PY_ZIP_CODE") & String.Empty
                Absx1.txtFor("FRT_3PY_COUNTRY").Text = rowSOTSHIPB.Item("FRT_3PY_COUNTRY") & String.Empty
                Absx1.txtFor("FRT_3PY_CONTACT").Text = rowSOTSHIPB.Item("FRT_3PY_CONTACT") & String.Empty
                lblINIT_DATE.Text = "Entered on " & Format(rowSOTSHIPB.Item("INIT_DATE"), "MM/dd/yyyy")

                Select Case rowSOTSHIPB.Item("BOL_STATUS")
                    Case "O"
                        lblStatus.Text = "Open"
                    Case "F"
                        lblStatus.Text = "Shipped"
                    Case "C"
                        lblStatus.Text = "Cancelled"
                    Case Else
                        lblStatus.Text = "Status Unknown"
                End Select
            End If
        End If

        If dst.Tables("SOTSHIP0").Rows.Count = 1 AndAlso processingMasterBOL Then
            Dim rowSOTSHIP0 As DataRow = dst.Tables("SOTSHIP0").Rows(0)
            Dim rowSOTSHIPB As DataRow = dst.Tables("SOTSHIPB").Rows(0)
            rowSOTSHIP0.Item("SHIP_REF") = rowSOTSHIPB.Item("SHIP_REF")
            rowSOTSHIP0.Item("EDI_LOAD_ID") = rowSOTSHIPB.Item("EDI_LOAD_ID")
            rowSOTSHIP0.Item("BTB_BOL_NO") = rowSOTSHIPB.Item("BTB_BOL_NO")
            rowSOTSHIP0.Item("SHIP_VIA_CODE") = rowSOTSHIPB.Item("SHIP_VIA_CODE")
            rowSOTSHIP0.Item("FRT_TERMS") = rowSOTSHIPB.Item("FRT_TERMS")

            If ASCMAIN1.CLIENT = "VAN" Then
                rowSOTSHIP0.Item("SHIP_LOAD_NO") = rowSOTSHIPB.Item("EDI_LOAD_ID")
            End If
            dst.Tables("SOTSHIP0").AcceptChanges()
        End If

        If BillOfLadingMode AndAlso Not select_from_3PL_list Then
            ASCMAIN1.Progress("Now Loading Data", "RefreshBolShipments")
            RefreshBolShipments(True)
        End If

        Sort_grdColumns(grdSOTINVHM, "INV_NO,INV_MNO")
        Populate_Controls_with_Parents("SREP_CODE", Absx1.txtFor("SREP_CODE"))
        Populate_Controls_with_Parents("SREP2_CODE", Absx1.txtFor("SREP2_CODE"))
        Populate_Controls_with_Parents("TERM_CODE", Absx1.txtFor("TERM_CODE"))

        ' Show Only for NYA and Warehouse 52
        lblFCR.Visible = ASCMAIN1.CLIENT = "NYA" AndAlso dst.Tables("SOTSHIP1").Select("WHSE_CODE = '52'").Length > 0
        txtBTB_BOL_NO.Visible = ASCMAIN1.CLIENT = "NYA" AndAlso dst.Tables("SOTSHIP1").Select("WHSE_CODE = '52'").Length > 0

        ASCMAIN1.Progress("Now Loading Data", "SetupgrdSOTCART1_SHIP")
        SetupgrdSOTCART1_SHIP()

        If dst.Tables("WHTSHPC4").Rows.Count > 0 Then

            Dim CARRIER_PPA_TYPE As String = "L"

            For Each rowWHTSHPC4 As DataRow In dst.Tables("WHTSHPC4").Select("")
                Dim CARRIER_CODE As String = rowWHTSHPC4.Item("CARRIER_CODE") & String.Empty
                Dim ServiceType As String = rowWHTSHPC4.Item("SERVICE_TYPE") & String.Empty

                ' Display only those services that are mapped to ship vias
                If dst.Tables("SOTSVIA1").Select("CARRIER_CODE = '" & CARRIER_CODE & "' AND CARRIER_PROD_CODE = '" & ServiceType & "'").Length = 0 Then
                    Continue For
                End If

                Dim rowSOTCARR1 As DataRow = dst.Tables("SOTCARR1").Rows.Find(CARRIER_CODE)

                If rowSOTCARR1.Table.Columns.Contains("CARRIER_PPA_TYPE") Then
                    CARRIER_PPA_TYPE = rowSOTCARR1.Item("CARRIER_PPA_TYPE") & String.Empty
                    ' If not set then set tp list
                    If CARRIER_PPA_TYPE.Length = 0 Then
                        CARRIER_PPA_TYPE = "L"
                    End If
                End If

                Select Case CARRIER_PPA_TYPE
                    Case "F" ' None
                        rowWHTSHPC4.Item("CUSTOMER_BASE_CHARGE") = 0
                    Case "N" ' Negotiated
                        rowWHTSHPC4.Item("CUSTOMER_BASE_CHARGE") = rowWHTSHPC4.Item("ACCT_NET_CHARGE")
                    Case "L" ' List
                        rowWHTSHPC4.Item("CUSTOMER_BASE_CHARGE") = rowWHTSHPC4.Item("LIST_NET_CHARGE")
                    Case Else
                        ' If not set then use  List
                        rowWHTSHPC4.Item("CUSTOMER_BASE_CHARGE") = rowWHTSHPC4.Item("LIST_NET_CHARGE")
                End Select

            Next

            Sort_grdColumns(grdWHTSHPC4, "TOTAL_CHARGE")

        End If

        If ASCMAIN1.CLIENT = "RGI" Then
            RGI_SORT_SOTPICK2()
        End If

        ' default Houzz address to residental
        If ASCMAIN1.CLIENT = "RGI" AndAlso isEcommProcessing Then
            optAddressType.Value = "R"
        End If

        ASCMAIN1.Progress("Now Loading Data", "Before SetupCartonProduct")
        SetupCartonProduct(True)
        ASCMAIN1.Progress("Now Loading Data", "After SetupCartonProduct")

        If Not InquiryMode Then
            With grdSOTPICK2.DisplayLayout.Bands(0)
                For Each COLUMN_NAME As String In New String() {"PICK_QTY", "PICK_QTY_CONF", "PICK_QTY_CANC", "PICK_QTY_BACK"}
                    .Columns(COLUMN_NAME).CellActivation = IIf(isEcommProcessing, UltraWinGrid.Activation.NoEdit, UltraWinGrid.Activation.AllowEdit)
                Next
            End With

            With grdSOTPICK2_SC.DisplayLayout.Bands(0)
                For Each COLUMN_NAME As String In New String() {"PICK_QTY", "PICK_QTY_CONF", "PICK_QTY_CANC", "PICK_QTY_BACK"}
                    .Columns(COLUMN_NAME).CellActivation = IIf(isEcommProcessing, UltraWinGrid.Activation.NoEdit, UltraWinGrid.Activation.AllowEdit)
                Next
            End With
        End If

        If ASCMAIN1.CLIENT = "RGI" AndAlso isEcommProcessing AndAlso Not select_from_3PL_list AndAlso Not InquiryMode Then
            chkReturnFreightPrices.Checked = False
            PrintEcommercePickSlip()

            If CannotProcessEcommOrder Then
                Exit Sub
            End If

            For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("")
                rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                rowSOTPICK2.Item("PICK_QTY_CANC") = 0

                ' Prevents scanning UPC Codes
                'If ASCMAIN1.Running_in_VS AndAlso ASCMAIN1.USER_ID = "edz" Then
                '    rowSOTPICK2.Item("PICK_QTY_CONF") = rowSOTPICK2.Item("PICK_QTY")
                'End If
            Next
            Fill_Records("ECTECOM1", dst.Tables("SOTORDR1").Rows(0).Item("ECOM_CODE") & String.Empty)
        End If

        chkReturnFreightPrices.Checked = False
        If ASCMAIN1.CLIENT = "RGI" AndAlso Not InquiryMode AndAlso Not isEcommProcessing AndAlso dst.Tables("WHTSHPCG").Rows.Count = 0 Then
            If cmbFreightClass.Text = String.Empty Then
                cmbFreightClass.Text = "100"
            End If

            If Absx1.txtFor("FRSCOMMODITYFREIGHTNMFC").TextLength = 0 Then
                Absx1.txtFor("FRSCOMMODITYFREIGHTNMFC").Text = NMFC_CODE
            End If

            If Absx1.txtFor("FRSPAYMENTDESCRIPTION").TextLength = 0 Then
                Absx1.txtFor("FRSPAYMENTDESCRIPTION").Text = NMFC_DESC
            End If

            If optUGFPayor.CheckedIndex < 0 Then
                optUGFPayor.CheckedIndex = 0
            End If

            chkReturnFreightPrices.Checked = False

            Dim CART_TOTAL_WGT_ACTUAL As Int64 = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "") & String.Empty)

            If CART_TOTAL_WGT_ACTUAL <= numFRSTOTALWEIGHT.MaxValue Then
                numFRSTOTALWEIGHT.Value = Val(dst.Tables("SOTCART1").Compute("SUM(CART_TOTAL_WGT_ACTUAL)", "") & String.Empty)
            Else
                numFRSTOTALWEIGHT.Value = numFRSTOTALWEIGHT.MaxValue
            End If
            numFRSTOTALCARTONS.Value = dst.Tables("SOTCART1").Rows.Count
        End If

        tabSOTPICK1.Tabs("QVC Suggested Packing").Visible = ASCMAIN1.CLIENT = "RGI" AndAlso CUST_CODE = RegencyQVCCustCode


        ' Requested for Vandale on 5/23/2019 by David Ashear 
        If Not InquiryMode AndAlso ASCMAIN1.CLIENT = "VAN" AndAlso CUST_CODE = "WALMART" AndAlso Not txtBOL_INST.Text.Contains("MABD") Then
            Dim SHIP_BOL_NO As String = Absx1.txtFor("SHIP_BOL_NO").Text
            Dim MABD As String = String.Empty
            Dim tblOGN As DataTable = Nothing
            Dim Sql As String = " SELECT DISTINCT E1.EDI_SHIP_DATE" _
                & " FROM SOTORDR1 O1, EDT850T1 E1" _
                & " WHERE O1.EDI_DOC_SEQ_NO = E1.EDI_DOC_SEQ_NO" _
                & " AND O1.EDI_JRNL_NO = E1.EDI_JRNL_NO" _
                & " AND O1.ORDR_GROUP_NO IN (SELECT ORDR_GROUP_NO FROM SOTSHIP1 WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "')" _
                & " AND E1.EDI_SHIP_DATE IS NOT NULL"

            tblOGN = ASCDATA1.GetDataTable(Sql)
            If tblOGN.Rows.Count > 0 Then
                MABD = tblOGN.Compute("MIN(EDI_SHIP_DATE)", "") & String.Empty
                If IsDate(MABD) Then
                    MABD = "MABD " & CDate(MABD).ToString("MM-dd-yyyy")
                    If txtBOL_INST.Text = String.Empty Then
                        txtBOL_INST.Text = MABD
                    Else
                        txtBOL_INST.Text &= Environment.NewLine & MABD
                    End If

                    ' Stuff it into the datatable - it gets lost sometimes
                    If dst.Tables("SOTSHIPB").Rows.Count = 1 Then
                        dst.Tables("SOTSHIPB").Rows(0).Item("BOL_INST") = txtBOL_INST.Text
                    End If
                End If
            End If
        End If

        If ASCMAIN1.CLIENT = "RGI" And CUST_CODE = RegencyHomeDepotCustCode Then
            chkSignature.Checked = requiresSignature
        End If

        If EntryMode = "E" And ASCMAIN1.CLIENT = "VAN" And UpdateOnlyMode = True Then
            ASCMAIN1.Progress("Now Loading Data", "WHTSCSEQ")
            Fill_Records("WHTSCSEQ", CUST_CODE)
        End If

        Me.Cursor = Cursors.Default
        ASCMAIN1.Progress("")
    End Sub

    ''' <summary>
    ''' This is here so Non 3PL and 3PL can do their work then have this done
    ''' </summary>
    ''' <remarks></remarks>
    Private Sub SetPickQuantityConfirmed(Optional sqlPickNo As String = "")

        If Not InquiryMode Then

            ' 6/7/2017 - Use SOTCART1/2 for non 3PL list processing
            Dim tblSOTPICK2 As DataTable = dst.Tables("SOTPICK2").Copy
            Dim PICK_NO As String = String.Empty
            Dim PICK_LNO As Int16 = 0
            Dim ORDR_NO As String = String.Empty
            Dim ORDR_LNO As Int16 = 0

            If select_from_3PL_list Then
                '  Nothing to do at this time 
            ElseIf isEcommProcessing Then
                For Each rowSOTPICK2 As DataRow In tblSOTPICK2.Select(sqlPickNo, "PICK_NO, PICK_LNO")
                    rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                    rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                    rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                Next
            Else
                ' Only do this if we have new Shipping Records. Most likely the value of sqlPickNo will not be null
                If dst.Tables("SOTSHIP1").Select("ISNULL(BILL_OF_LADING_NO, '') = ''", "", DataViewRowState.OriginalRows).Length > 0 OrElse sqlPickNo.Length > 0 OrElse ASCMAIN1.CLIENT = "RGI" Then
                    For Each rowSOTPICK2 As DataRow In tblSOTPICK2.Select(sqlPickNo, "PICK_NO, PICK_LNO")

                        If Val(rowSOTPICK2.Item("PICK_QTY") & String.Empty) = 0 Then
                            rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                            rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                            rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                            Continue For
                        End If

                        PICK_NO = rowSOTPICK2.Item("PICK_NO")
                        PICK_LNO = rowSOTPICK2.Item("PICK_LNO")
                        ORDR_NO = rowSOTPICK2.Item("ORDR_NO")
                        ORDR_LNO = rowSOTPICK2.Item("ORDR_LNO")

                        rowSOTPICK2.Item("ORDR_UNIT_PRICE") = Val(rowSOTPICK2.Item("ORDR_UNIT_PRICE") & String.Empty)
                        rowSOTPICK2.Item("PICK_UNIT_PRICE") = rowSOTPICK2.Item("ORDR_UNIT_PRICE")

                        ASCMAIN1.Progress("-", Val(rowSOTPICK2.Item("PICK_NO")) & "/" & rowSOTPICK2.Item("PICK_LNO"))

                        If Not select_from_3PL_list Then
                            rowSOTPICK2.Item("PICK_QTY_CONF") = 0
                            rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                            rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                            For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NO & "'")
                                Dim CART_NO As String = rowSOTCART1.Item("CART_NO")
                                For Each rowSOTCART2 As DataRow In dst.Tables("SOTCART2").Select("CART_NO = '" & CART_NO & "' AND ORDR_NO = '" & ORDR_NO & "' AND ORDR_LNO = " & ORDR_LNO)
                                    rowSOTPICK2.Item("PICK_QTY_CONF") = Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) + Val(rowSOTCART2.Item("QTY_PACKED") & String.Empty)
                                Next
                            Next

                            If ASCMAIN1.CLIENT = "RGI" Then
                                rowSOTPICK2.Item("PICK_QTY_BACK") = rowSOTPICK2.Item("PICK_QTY") - rowSOTPICK2.Item("PICK_QTY_CONF")
                                If rowSOTPICK2.Item("PICK_QTY_BACK") < 0 Then
                                    rowSOTPICK2.Item("PICK_QTY_BACK") = 0
                                End If
                            Else
                                rowSOTPICK2.Item("PICK_QTY_CANC") = rowSOTPICK2.Item("PICK_QTY") - rowSOTPICK2.Item("PICK_QTY_CONF")
                                If rowSOTPICK2.Item("PICK_QTY_CANC") < 0 Then
                                    rowSOTPICK2.Item("PICK_QTY_CANC") = 0
                                End If
                            End If

                        Else
                            ' If 3PL then cancel unshipped items from the pick ticket
                            If Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) < rowSOTPICK2.Item("PICK_QTY") Then
                                rowSOTPICK2.Item("PICK_QTY_CANC") = rowSOTPICK2.Item("PICK_QTY") - Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty)
                            End If
                        End If
                    Next

                    ASCMAIN1.Progress("Merge Updated Detail Lines", String.Empty)
                    dst.Tables("SOTPICK2").Rows.Clear()
                    dst.Tables("SOTPICK2").Merge(tblSOTPICK2)
                End If

                If sqlPickNo.Length > 0 Then
                    For Each row As DataRow In ASCDATA1.SelectDistinct(dst.Tables("SOTPICK2").Select(sqlPickNo), New String() {"PICK_NO", "ORDR_NO", "ORDR_LNO"}).Rows
                        dst.Tables("SOTCARTX").Rows.Add(New Object() {row.Item("PICK_NO"), row.Item("ORDR_NO"), row.Item("ORDR_LNO")})
                    Next
                    numInsureValue.Value = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_AMT_CONF)", "") & String.Empty)
                    Exit Sub
                End If
            End If
        End If

        ASCMAIN1.Progress(String.Empty, String.Empty)

        If Not select_from_3PL_list Then
            If dst.Tables("SOTSHIP1").Rows.Count > 0 Then
                Dim rowSOTSHIP1 As DataRow = dst.Tables("SOTSHIP1").Rows(0)
                If IsDate(rowSOTSHIP1.Item("SHIP_DATE_SHIPPED")) Then
                    dteSHIP_DATE_SHIPPED.DateTime = rowSOTSHIP1.Item("SHIP_DATE_SHIPPED")
                ElseIf Not InquiryMode Then
                    dteSHIP_DATE_SHIPPED.DateTime = DateTime.Now
                End If

                If IsDate(rowSOTSHIP1.Item("INV_DATE")) Then
                    dteINV_DATE.DateTime = rowSOTSHIP1.Item("INV_DATE")
                ElseIf Not InquiryMode Then
                    dteINV_DATE.DateTime = DateTime.Now
                End If
            ElseIf Not InquiryMode Then
                dteINV_DATE.DateTime = DateTime.Now
                dteSHIP_DATE_SHIPPED.DateTime = DateTime.Now
            End If
        End If

        ToggleDataTableExpressions(True)

        numInsureValue.Value = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_AMT_CONF)", "") & String.Empty)

        dst.Tables("SOTPICK1").AcceptChanges()
        dst.Tables("SOTPICK2").AcceptChanges()

        Sort_grdColumns(grdSOTPICK1, "PICK_NO")
        Setup_SOTPICK1()

        clsPrice_Change = Nothing

        Select Case rowSOTSHIP0.Item("SHIP_STATUS")
            Case "P"
                lblStatus.Text = "In Pick"
            Case "F"
                lblStatus.Text = "Shipped"
            Case "C"
                lblStatus.Text = "Cancelled"
            Case Else
                lblStatus.Text = "Status Unknown"
        End Select

        If EntryMode = "L" Then
            lblINIT_DATE.Text = "Confirmed by " & rowSOTSHIP0.Item("LAST_OPER") & " on " & Format(rowSOTSHIP0.Item("LAST_DATE"), "MM/dd/yy HH:mm")
        Else
            lblINIT_DATE.Text = "Confirmed by " & ASCMAIN1.USER_ID & " on " & Format(DateTime.Now, "MM/dd/yy HH:mm")
        End If

        Display_Totals()

        Dim GL_PARM_CURR_CODE As String = ROWs("GLTPARM1").Item("GL_PARM_CURR_CODE") & ""
        CURR_CODE = rowARTCUST1.Item("CURR_CODE") & ""
        If CURR_CODE = "" OrElse CURR_CODE = GL_PARM_CURR_CODE Then
            CURR_CODE = GL_PARM_CURR_CODE
            CURR_EXCH_RATE = 1
        Else
            Dim rowTATCURR1 As DataRow = LookUp("TATCURR1", rowARTCUST1.Item("CURR_CODE"))
            CURR_CODE = rowTATCURR1.Item("CURR_CODE")
            CURR_EXCH_RATE = rowTATCURR1.Item("CURR_EXCH_CUR")
        End If

        EnforceConstraints(False)
        dst.Tables("SOTCARTX").Rows.Clear()
        For Each row As DataRow In ASCDATA1.SelectDistinct(dst.Tables("SOTPICK2"), New String() {"PICK_NO", "ORDR_NO", "ORDR_LNO"}).Rows
            dst.Tables("SOTCARTX").Rows.Add(New Object() {row.Item("PICK_NO"), row.Item("ORDR_NO"), row.Item("ORDR_LNO")})
        Next

        For Each row As DataRow In ASCDATA1.SelectDistinct(dst.Tables("SOTCART2"), New String() {"PICK_NO", "ORDR_NO", "ORDR_LNO"}).Rows
            Dim PICK_NO As String = row.Item("PICK_NO")
            Dim ORDR_NO As String = row.Item("ORDR_NO")
            Dim ORDR_LNO As Int32 = row.Item("ORDR_LNO")
            ASCMAIN1.sql = $"PICK_NO = '{PICK_NO}' and ORDR_NO = '{ORDR_NO}' and ORDR_LNO = {ORDR_LNO}"

            If dst.Tables("SOTCARTX").Select(ASCMAIN1.sql).Length = 0 Then
                dst.Tables("SOTCARTX").Rows.Add(New Object() {PICK_NO, ORDR_NO, ORDR_LNO})
            End If

        Next

        grdSOTPICK1.DisplayLayout.Bands(0).Summaries.Clear()
        If dst.Tables("SOTPICK1").Rows.Count = 1 Then
            splSOTPICK1.SplitterDistance = 80 + grdSOTPICK1.Rows(0).Height * 1
            txtStore.Visible = False
        Else
            'CANT WE JUST CREATE THE SUMMARIES ONCE AND THEN HIDE THEM?
            Create_Summary(grdSOTPICK1, "PICK_NO", "Count")
            Create_Summary(grdSOTPICK1, New String() {"SELECTED", "PICK_CNT_CARTONS", "PICK_TOTAL_WGT", "PICK_FREIGHT", "TOTAL_CARTONS", "TOTAL_CUBE"})
            Create_Summary(grdSOTPICK1, New String() {"PICK_QTY", "PICK_QTY_CONF", "PICK_QTY_CANC", "PICK_QTY_BACK"})
            Create_Summary(grdSOTPICK1, New String() {"PICK_AMT", "PICK_AMT_CONF", "PICK_AMT_CANC", "PICK_AMT_BACK"})
            splSOTPICK1.SplitterDistance = 80 + grdSOTPICK1.Rows(0).Height * 4
            txtStore.Visible = True
        End If

        If MaintenanceMode Then
            txtemail.Text = ASCMAIN1.USER_EMAIL
            txtContact.Text = ASCMAIN1.USER_NAME
        End If

        If ASCMAIN1.CLIENT = "NYA" Then
            For Each col As String In New String() {"PICK_QTY_CONF", "PICK_QTY_CANC", "PICK_QTY_BACK"}
                grdSOTPICK2.DisplayLayout.Bands(0).Columns(col).CellActivation = UltraWinGrid.Activation.NoEdit
                grdSOTPICK2_SC.DisplayLayout.Bands(0).Columns(col).CellActivation = UltraWinGrid.Activation.NoEdit
            Next
        End If

        Display_Totals()
        EnforceConstraints(True)
        Me.Cursor = Cursors.Default
        ASCMAIN1.Progress("")
    End Sub

    Sub Update_Record()

        Me.Cursor = Cursors.WaitCursor
        Dim inTransaction As Boolean = False
        Dim shipLabels As List(Of String) = New List(Of String)
        Dim ErrorMessage As String = String.Empty
        Dim rowSOTPICK1 As DataRow = Nothing
        Dim rowSOTORDR1 As DataRow = Nothing
        Dim tableNameSOTSHIPB As String = "SOTSHIPB"
        Dim SHIP_BOL_NO As String = String.Empty
        Dim ORDR_CUST_PO As String = String.Empty
        Dim invCommentMaxLength As Int16 = dst.Tables("SOTINVH1").Columns("INV_COMMENT").MaxLength
        Dim lstCanceledPickTickets As New List(Of String)

        ' These tables are deleted from oracle and then bulk copied to Oracle by setting the row status to Added
        Dim tablesToReset As String() = New String() {"SOTSHIP1", "SOTSHIP2", "SOTPICK1", "SOTPICK2", "SOTCART1", "SOTCART2", "SOTCART3", "SOTSHIPP"}

        Try
            refreshScreen = True

            ' Going To Accept chnages for canceled pick ticket so they are not updated to Oracle
            ' and let the code in 'CancelPickTicket' update the records.
            For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("PICK_STATUS = 'C' and PICK_STATUS_ORIG = 'P'")
                Dim PICK_NO As String = rowSOTPICK1.Item("PICK_NO")
                lstCanceledPickTickets.Add(PICK_NO)
                rowSOTPICK1.RejectChanges()
                For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "'")
                    rowSOTPICK2.RejectChanges()
                Next
            Next

            Dim rowSOTSHIPB As DataRow = dst.Tables("SOTSHIPB").Rows(0)
            Dim rowSOTSVIA1 As DataRow = LookUp("SOTSVIA1", rowSOTSHIPB.Item("SHIP_VIA_CODE") & String.Empty)
            If rowSOTSHIPB.Item("BOL_STATUS") = "O" AndAlso rowSOTSVIA1 IsNot Nothing Then
                rowSOTSHIPB.Item("SHIP_VIA_DESC") = rowSOTSVIA1.Item("SHIP_VIA_DESC")
                rowSOTSHIPB.Item("SHIP_VIA_SCAC") = rowSOTSVIA1.Item("SHIP_VIA_SCAC")
            End If

            If ASCMAIN1.CLIENT = "VAN" Then
                rowSOTSHIPB.Item("SHIP_LOAD_NO") = rowSOTSHIPB.Item("EDI_LOAD_ID")
            End If

            ' Clean up data
            Dim sqlSOTSHIP1 As String = String.Empty
            Dim sqlSOTPICK1 As String = String.Empty
            SHIP_BOL_NO = String.Empty
            dst.Tables("SOTSHIPP").Rows.Clear()

            ' Update Shipment weights/cartons incase they print a Bill of Lading
            If Not processingMasterBOL Then
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("", "", DataViewRowState.CurrentRows)
                    SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO") & String.Empty

                    If ASCMAIN1.CLIENT = "VAN" Then
                        ORDR_CUST_PO = rowSOTSHIP1.Item("ORDR_CUST_PO") & String.Empty

                        If dst.Tables("SOTSHIP2").Select("ORDR_CUST_PO = '" & ORDR_CUST_PO & "'").Length = 0 Then
                            If ASCMAIN1.CLIENT = "VAN" AndAlso (CUST_CODE = "KMART" OrElse CUST_CODE = "SEARS") Then
                                Dim wkCustPO As String = ORDR_CUST_PO
                                If wkCustPO.Length > 5 Then
                                    wkCustPO = wkCustPO.Substring(5)

                                    For Each row As DataRow In dst.Tables("SOTSHIP2").Select("")
                                        If (row.Item("ORDR_CUST_PO") & String.Empty).ToString.EndsWith(wkCustPO) Then
                                            ORDR_CUST_PO = row.Item("ORDR_CUST_PO") & String.Empty
                                            Exit For
                                        End If
                                    Next
                                End If
                            End If
                        End If

                        rowSOTSHIP1.Item("SHIP_TOTAL_WGT") = Val(dst.Tables("SOTSHIP2").Compute("SUM(WEIGHT)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                        rowSOTSHIP1.Item("SHIP_CNT_CARTONS") = Val(dst.Tables("SOTSHIP2").Compute("SUM(PKG_QTY)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                    Else
                        rowSOTSHIP1.Item("SHIP_TOTAL_WGT") = Val(dst.Tables("SOTPICK1").Compute("SUM(PICK_TOTAL_WGT)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & "")
                        rowSOTSHIP1.Item("SHIP_CNT_CARTONS") = Val(dst.Tables("SOTPICK1").Compute("SUM(PICK_CNT_CARTONS)", "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'") & "")
                    End If

                    ' 01/23/2019
                    If ASCMAIN1.CLIENT = "RGI" Then
                        rowSOTSHIP1.Item("SHIP_APPT_NO") = Absx1.txtFor("SHIP_APPT_NO").Text
                    End If

                    rowSOTSHIP1.Item("MASTER_SHIP_BOL_NO") = MASTER_SHIP_BOL_NO
                Next
            Else
                tableNameSOTSHIPB = "SOTSHIPM"
                MASTER_BOL_NO = rowSOTSHIPB.Item("BOL_NO")

                dst.Tables("SOTSHIPM").Rows.Clear()
                For Each row As DataRow In dst.Tables("SOTSHIPS").Select("SEL = '1'")
                    Fill_Records("SOTSHIPM", row.Item("BOL_NO"), False)
                Next

                For Each rowSOTSHIPM As DataRow In dst.Tables("SOTSHIPM").Select("")
                    rowSOTSHIPM.Item("MASTER_BOL_NO") = MASTER_BOL_NO
                    rowSOTSHIPM.Item("MASTER_BOL") = "0"

                    For Each fieldName As String In bolHeaderFieldsToUpdate.Split(",")
                        fieldName = fieldName.Trim

                        Select Case fieldName
                            Case "EDI_LOAD_ID"
                                If ASCMAIN1.CLIENT <> "RGI" Then
                                    rowSOTSHIPM.Item(fieldName) = rowSOTSHIPB.Item(fieldName)
                                End If

                            Case Else
                                rowSOTSHIPM.Item(fieldName) = rowSOTSHIPB.Item(fieldName)
                        End Select
                    Next
                Next
            End If

            For Each tableName As String In processingTables
                dst.Tables(tableName).AcceptChanges()
            Next

            'If Not finalizeShipment AndAlso BillOfLadingMode Then
            BeginTrans()
            inTransaction = True
            'End If

            INIT_LAST("SOTSHIPB", False, , True)
            INIT_LAST("SOTSHIPM", False, , True)
            Dim sqldelete As String = "BOL_NO = '" & BOL_NO & "'"

            If processingMasterBOL Then
                ASCMAIN1.sql = "UPDATE SOTSHIPB SET MASTER_BOL_NO = NULL WHERE MASTER_BOL_NO = '" & MASTER_BOL_NO & "'"
                ASCDATA1.ExecuteSQL(ASCMAIN1.sql)

                ASCMAIN1.sql = "UPDATE SOTSHIP1 SET MASTER_BILL_OF_LADING_NO = NULL WHERE MASTER_BILL_OF_LADING_NO = '" & MASTER_BOL_NO & "'"
                ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
            Else
                ASCMAIN1.sql = "UPDATE SOTSHIP1 SET BILL_OF_LADING_NO = NULL, MASTER_SHIP_BOL_NO = NULL WHERE BILL_OF_LADING_NO = '" & Absx1.txtFor("BILL_OF_LADING_NO").Text & "'"
                ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
            End If

            Update_Record_TDA("SOTSHIPB", sqldelete)
            Update_Record_TDA("SOTSHIPM")

            INIT_LAST("SOTSHIP1", False, , True)
            Dim sql As String = String.Empty

            SHIP_BOL_NO = String.Empty
            For Each rowSOTSHIPBx As DataRow In dst.Tables(tableNameSOTSHIPB).Select("")
                sql = "BILL_OF_LADING_NO = '" & rowSOTSHIPBx.Item("BOL_NO") & "'"

                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select(sql, "", DataViewRowState.CurrentRows)
                    SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")
                    ASCMAIN1.Progress("Updating Shipment " & SHIP_BOL_NO, "")

                    ' Added on 5/24/2019 - Nassema and Walter
                    If ASCMAIN1.CLIENT = "VAN" Then
                        If rowSOTSHIP1.Item("SHIP_REF") & String.Empty = String.Empty Then
                            rowSOTSHIP1.Item("SHIP_REF") = Absx1.txtFor("EDI_LOAD_ID").Text
                        End If
                    End If

                    If Not processingMasterBOL Then
                        Delete_Records(SHIP_BOL_NO, False)

                        Dim rowSOTSHIPP As DataRow = Nothing
                        rowSOTSHIPP = dst.Tables("SOTSHIPP").NewRow
                        rowSOTSHIPP.Item("SHIP_BOL_NO") = SHIP_BOL_NO
                        rowSOTSHIPP.Item("CUST_NAME") = rowSOTSHIPB.Item("SHIP_TO_NAME")
                        rowSOTSHIPP.Item("CUST_ADDR1") = rowSOTSHIPB.Item("SHIP_TO_ADDR1")
                        rowSOTSHIPP.Item("CUST_ADDR2") = rowSOTSHIPB.Item("SHIP_TO_ADDR2")
                        rowSOTSHIPP.Item("CUST_ADDR3") = rowSOTSHIPB.Item("SHIP_TO_ADDR3")
                        rowSOTSHIPP.Item("CUST_CITY") = rowSOTSHIPB.Item("SHIP_TO_CITY")
                        rowSOTSHIPP.Item("CUST_STATE") = rowSOTSHIPB.Item("SHIP_TO_STATE")
                        rowSOTSHIPP.Item("CUST_ZIP_CODE") = rowSOTSHIPB.Item("SHIP_TO_ZIP_CODE")
                        rowSOTSHIPP.Item("CUST_COUNTRY") = rowSOTSHIPB.Item("SHIP_TO_COUNTRY")
                        dst.Tables("SOTSHIPP").Rows.Add(rowSOTSHIPP)
                    End If

                    rowSOTSHIP1.Item("INV_DATE") = CDate(Absx1.dteFor("INV_DATE").Value & String.Empty).ToShortDateString
                    rowSOTSHIP1.Item("SHIP_DATE_SHIPPED") = CDate(Absx1.dteFor("SHIP_DATE_SHIPPED").Value & String.Empty).ToShortDateString
                    If Not IsDate(rowSOTSHIP1.Item("SHIPPED_ACTUAL") & String.Empty) Then
                        rowSOTSHIP1.Item("SHIPPED_ACTUAL") = rowSOTSHIP1.Item("SHIP_DATE_SHIPPED")
                    End If

                    rowSOTSHIP1.Item("MASTER_BILL_OF_LADING_NO") = MASTER_BOL_NO

                    If Not processingMasterBOL Then
                        rowSOTSHIP1.Item("MASTER_SHIP_BOL_NO") = MASTER_SHIP_BOL_NO
                    Else
                        For Each fieldName As String In bolHeaderFieldsToUpdate.Split(",")
                            fieldName = fieldName.Trim
                            If rowSOTSHIP1.Table.Columns.Contains(fieldName) Then

                                If fieldName = "SHIP_REF" Then
                                    ' Added on 5/24/2019 - Nassema and Walter
                                    If ASCMAIN1.CLIENT = "VAN" Then
                                        If rowSOTSHIP1.Item(fieldName) & String.Empty = String.Empty Then
                                            rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                        End If
                                    Else
                                        rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                    End If
                                Else
                                    rowSOTSHIP1.Item(fieldName) = rowSOTSHIPBx.Item(fieldName)
                                End If

                            End If
                        Next
                    End If
                Next
            Next

            If Not processingMasterBOL Then

                For Each TABLE_NAME As String In tablesToReset

                    If dst.Tables(TABLE_NAME).Rows.Count = 0 Then
                        Continue For
                    End If

                    dst.Tables(TABLE_NAME).AcceptChanges()
                    For Each row As DataRow In dst.Tables(TABLE_NAME).Select("")
                        row.SetAdded()
                    Next
                    Create_BAs(TABLE_NAME, True)
                    Update_BAs(TABLE_NAME, True)
                Next

                For Each PICK_NO As String In lstCanceledPickTickets
                    CancelPickTicket(PICK_NO)
                Next

            Else
                For Each TABLE_NAME As String In New String() {"SOTSHIP1"}
                    Update_Record_TDA(TABLE_NAME)
                Next

                For Each rowSOTSHIP2 As DataRow In dst.Tables("SOTSHIP2").Select("")
                    ASCMAIN1.sql = "DELETE FROM SOTSHIP2 WHERE SHIP_BOL_NO = '" & rowSOTSHIP2.Item("SHIP_BOL_NO") & "'"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
                Next

                dst.Tables("SOTSHIP2").AcceptChanges()
                For Each row As DataRow In dst.Tables("SOTSHIP2").Select("")
                    row.SetAdded()
                Next
                Update_Record_TDA("SOTSHIP2")
            End If

            Try
                CommitTrans("")
                inTransaction = False
            Catch ex As Exception
                Rollback(ex.Message)
                Exit Sub
            End Try

            If Not finalizeShipment AndAlso BillOfLadingMode Then
                If Not UpdateOnlyMode Then
                    If Not RecreateLabel Then
                        Exit Sub
                    End If
                End If
            End If

            ' Placed here so the data on the screen is saved.
            If finalizeShipment Then
                If Not FreightHold() Then
                    Exit Sub
                End If
            End If

            ' Need to see if we needs to get labels from carrier.
            ' This is done first since some Freight Terms require the Customer Absorbs the Freight Cost
            ' As per Doug never print labels from this screen - 12/16/2014
            If commonCarrier AndAlso Not processingMasterBOL AndAlso Not select_from_3PL_list AndAlso Not UpdateOnlyMode AndAlso ASCMAIN1.CLIENT <> "VAN" Then
                Dim generateShippingLabel As Boolean = True
                If isEcommProcessing AndAlso isLpCodeWarehouse Then
                    generateShippingLabel = False
                End If

                If generateShippingLabel Then
                    ASCMAIN1.Progress("Generating Shipping label(s)", "")
                    If RequestShippingLabel(shipLabels, ErrorMessage, False) Then
                        ' May want to print these later - we will see
                        ' Moved below incase of error create invoice the user does not ship shipment without billing 
                    Else
                        ' ErrorMessage should have the error text available
                        ' What to do if an error occurs in the requesting of a label??
                        If ErrorMessage.Length > 0 Then
                            MessageBox.Show("Update Aborted! The following error occurred when processing the shipping label: " & Environment.NewLine & Environment.NewLine & ErrorMessage, "Ship Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Else
                            MessageBox.Show("Update Aborted! An error occurred when processing the shipping label.", "Ship Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End If
                        refreshScreen = False
                        Exit Sub
                    End If
                End If
            End If

            If RecreateLabel Then
                Try
                    For Each row As DataRow In dst.Tables("SOTSHIP1").Rows
                        ASCMAIN1.sql = "UPDATE SOTSHIP1 SET SHIP_VIA_CODE = '" & txtSHIP_VIA_CODE.Text & "', FRT_TERMS = '" & txtFRT_TERMS.Text & "'" _
                             & " WHERE SHIP_BOL_NO = '" & row.Item("SHIP_BOL_NO") & "'"
                        ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
                    Next

                Catch ex As Exception

                End Try

                For Each shippingLabel As String In shipLabels
                    If shippingLabel.Trim.Length > 0 Then PrintLabel(shippingLabel)
                Next
                Me.Cursor = Cursors.Default
                Exit Sub
            End If

            If UpdateOnlyMode Then
                ' Vandale does not print shipping labels in this screen
                If commonCarrier AndAlso ASCMAIN1.CLIENT <> "VAN" Then
                    For Each shippingLabel As String In shipLabels
                        If shippingLabel.Trim.Length > 0 Then PrintLabel(shippingLabel)
                    Next
                    Try
                        BeginTrans()
                        Update_Record_TDA("SOTPICK1")
                        Update_Record_TDA("SOTCART1")
                        CommitTrans()
                    Catch ex As Exception
                        Rollback("Error updating tracking numbers on cartons: " & ex.Message)
                    End Try
                End If
                ASCMAIN1.Progress(String.Empty, String.Empty)
                Exit Sub
            End If

            ASCMAIN1.Progress("Now Updating ...")

            ' Place the freight on one Pick Ticket if the user provided a freight
            Dim shippingFreight As Decimal = Val(numSHIP_FREIGHT.Value & String.Empty)

            ' 02/15/2019 - Regenecy wants the UPS / Fedex total freight cost on one invoice
            ' Customers are confused when they see a multi - Pick Ticket shipment with the freight spread evenly across each invoice
            If commonCarrier AndAlso Not processingMasterBOL AndAlso Not select_from_3PL_list Then
                If ASCMAIN1.CLIENT = "RGI" AndAlso shippingFreight = 0 Then
                    If dst.Tables("SOTPICK1").Rows.Count > 1 Then
                        shippingFreight = Val(dst.Tables("SOTPICK1").Compute("SUM(PICK_FREIGHT)", "") & String.Empty)
                    End If
                End If
            End If

            If shippingFreight > 0 Then
                For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("SELECTED = '1'", "SHIP_BOL_NO")
                    rowSOTPICK1.Item("PICK_FREIGHT") = 0
                    rowSOTPICK1.Item("ORDR_FOB") = 0
                Next

                If ASCMAIN1.CLIENT = "RGI" Then
                    ' Place freight on invoice with the greatest $$
                    dst.Tables("SOTPICK1").Select("SELECTED = '1'", "PICK_AMT_CONF DESC")(0).Item("PICK_FREIGHT") = shippingFreight
                Else
                    ' Spread the freight evenly across the pick tickets
                    Dim numSpread As Int16 = dst.Tables("SOTPICK1").Select("SELECTED = '1'").Length
                    For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("SELECTED = '1'", "SHIP_BOL_NO")
                        rowSOTPICK1.Item("PICK_FREIGHT") = Math.Round(shippingFreight / numSpread, 2)
                    Next

                    Dim diff As Decimal = shippingFreight - dst.Tables("SOTPICK1").Compute("SUM(PICK_FREIGHT)", "SELECTED = '1'")
                    If diff <> 0 Then
                        dst.Tables("SOTPICK1").Select("SELECTED = '1'", "PICK_AMT_CONF DESC")(0).Item("PICK_FREIGHT") =
                            dst.Tables("SOTPICK1").Select("SELECTED = '1'", "PICK_AMT_CONF DESC")(0).Item("PICK_FREIGHT") + diff
                    End If
                End If
            End If

            Dim freightAllowance As Decimal = 0
            If commonCarrier Then
                For Each row As DataRow In dst.Tables("SOTPICK1").Rows
                    freightAllowance += Val(row.Item("PICK_FREIGHT") & String.Empty) + Val(row.Item("ORDR_FOB") & String.Empty)
                Next
            Else
                freightAllowance = shippingFreight
            End If

            CalculateFreightDiscount(freightAllowance, rowSOTSVIA1)
            CalculateAdditionalMiscCharges()

            ASCMAIN1.Progress("Now Updating ...", "")

            Dim RFIXMSG As Boolean = False
            Dim clsSOCINVH1 As New TAC.SOCINVH1(dst)
            ' Update the Sales Order records with the Pick Ticket data

            If ASCMAIN1.CLIENT <> "VAN" Then
                clsSOCINVH1.ProcessPickTicketsAndUpdateSalesDetails(Absx1.dteFor("INV_DATE").Value)
            End If

            ' Record event where the Ship via was changed
            For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("SELECTED = '1'", "PICK_AMT_CONF DESC", DataViewRowState.CurrentRows)
                Dim ORDR_NO As String = rowSOTPICK1.Item("ORDR_NO")
                rowSOTORDR1 = dst.Tables("SOTORDR1").Rows.Find(ORDR_NO)

                If rowSOTORDR1.Item("SHIP_VIA_CODE") & String.Empty <> Absx1.txtFor("SHIP_VIA_CODE").Text Then
                    Dim rowTATEVNT1 As DataRow = dst.Tables("TATEVNT1").Rows.Add
                    rowTATEVNT1.Item("TABLE_NAME") = "SOTORDR1"
                    rowTATEVNT1.Item("TABLE_KEY") = ORDR_NO
                    rowTATEVNT1.Item("INIT_DATE") = DATETIME_STAMP
                    rowTATEVNT1.Item("INIT_OPER") = ASCMAIN1.USER_ID
                    rowTATEVNT1.Item("EVENT_TYPE") = "SHPMTC"
                    rowTATEVNT1.Item("EVENT_DESC") = "Ship Via was changed from " _
                        & rowSOTORDR1.Item("SHIP_VIA_CODE") & " to " & Absx1.txtFor("SHIP_VIA_CODE").Text
                    rowTATEVNT1.Item("EVENT_KEY") = ""
                    rowTATEVNT1.Item("FORM_NAME") = "SOFSHIPB"
                End If
            Next

            ' 04/17/2019 - Event for ecommerce short ship
            If ASCMAIN1.CLIENT = "RGI" AndAlso isEcommProcessing Then
                If dst.Tables("SOTPICK2").Select("PICK_QTY > 0 AND PICK_QTY_CONF < PICK_QTY", "").Length > 0 Then
                    Dim ORDR_NO As String = dst.Tables("SOTORDR1").Rows(0).Item("ORDR_NO")
                    Dim rowTATEVNT1 As DataRow = dst.Tables("TATEVNT1").Rows.Add
                    rowTATEVNT1.Item("TABLE_NAME") = "SOTORDR1"
                    rowTATEVNT1.Item("TABLE_KEY") = ORDR_NO
                    rowTATEVNT1.Item("INIT_DATE") = DATETIME_STAMP
                    rowTATEVNT1.Item("INIT_OPER") = ASCMAIN1.USER_ID
                    rowTATEVNT1.Item("EVENT_TYPE") = "SHSHP"
                    rowTATEVNT1.Item("EVENT_DESC") = "User chose to short ship Ecommerce order."
                    rowTATEVNT1.Item("EVENT_KEY") = ""
                    rowTATEVNT1.Item("FORM_NAME") = "SOFSHIPB"
                End If
            End If

            ' Create Invoice Records
            Dim CUST_FACTOR_TRANS_IND As String = String.Empty
            If chkFactored.Checked Then
                CUST_FACTOR_TRANS_IND = "1"
            Else
                CUST_FACTOR_TRANS_IND = "0"
            End If

            ' Put all MISC charges on ONE PICK TICKET
            ' Added 07/18/2022 - This got broken
            If ASCMAIN1.CLIENT = "RGI" Then
                For Each rowSOTPICK1m As DataRow In dst.Tables("SOTPICK1").Select("SELECTED = '1'")
                    Dim PICK_NO As String = rowSOTPICK1m.Item("PICK_NO") & String.Empty

                    For Each rowSOTINVHM As DataRow In dst.Tables("SOTINVHM").Select($"INV_NO = 'XXX'")
                        rowSOTINVHM.Item("INV_NO") = PICK_NO
                        rowSOTPICK1m.Item("INV_MISC_CHG") = Val(rowSOTPICK1m.Item("INV_MISC_CHG") & String.Empty) + Val(rowSOTINVHM.Item("INV_MISC_CHG") & String.Empty)
                    Next

                    Exit For
                Next
            End If

            SHIP_BOL_NO = String.Empty

            For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'", "", DataViewRowState.CurrentRows)
                SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")

                ' Log factoring change
                If Val(rowSOTSHIP1.Item("CUST_FACTOR_TRANS_IND") & String.Empty) <> Val(CUST_FACTOR_TRANS_IND) Then
                    Dim rowTATEVNT1 As DataRow = dst.Tables("TATEVNT1").Rows.Add
                    rowTATEVNT1.Item("TABLE_NAME") = "SOTSHIP1"
                    rowTATEVNT1.Item("TABLE_KEY") = SHIP_BOL_NO
                    rowTATEVNT1.Item("INIT_DATE") = DATETIME_STAMP
                    rowTATEVNT1.Item("INIT_OPER") = ASCMAIN1.USER_ID
                    rowTATEVNT1.Item("EVENT_TYPE") = "SHPFAC"
                    rowTATEVNT1.Item("EVENT_DESC") = "Factor Setting was changed from " _
                        & IIf(Val(rowSOTSHIP1.Item("CUST_FACTOR_TRANS_IND") & String.Empty) = 1, "True", "False") & " to " & IIf(Val(CUST_FACTOR_TRANS_IND) = 1, "True", "False")
                    rowTATEVNT1.Item("EVENT_KEY") = ""
                    rowTATEVNT1.Item("FORM_NAME") = "SOFSHIP0"
                End If

                rowSOTSHIP1.Item("CUST_FACTOR_TRANS_IND") = CUST_FACTOR_TRANS_IND
                rowSOTSHIP1.Item("INV_DATE") = CDate(Absx1.dteFor("INV_DATE").Value & String.Empty).ToShortDateString
                rowSOTSHIP1.Item("SHIP_DATE_SHIPPED") = CDate(Absx1.dteFor("SHIP_DATE_SHIPPED").Value & String.Empty).ToShortDateString
                If Not IsDate(rowSOTSHIP1.Item("SHIPPED_ACTUAL") & String.Empty) Then
                    rowSOTSHIP1.Item("SHIPPED_ACTUAL") = rowSOTSHIP1.Item("SHIP_DATE_SHIPPED")
                End If
                clsSOCINVH1.CreateInvoices(SHIP_BOL_NO, RFIXMSG)
            Next

            Dim CreditCardProcessed As Boolean = True
            CaptureCreditCard(CreditCardProcessed)
            If CreditCardProcessed = False Then
                MessageBox.Show("Update aborted! Credit card could not be processed.", "Credit Card", MessageBoxButtons.OK, MessageBoxIcon.Error)

                Dim EVENT_DESC_LEN As Int16 = dst.Tables("TATEVNT1").Columns("EVENT_DESC").MaxLength
                For Each rowTATEVNT1 As DataRow In dst.Tables("TATEVNT1").Select()
                    If (rowTATEVNT1.Item("EVENT_DESC") & String.Empty).ToString.Length > EVENT_DESC_LEN Then
                        rowTATEVNT1.Item("EVENT_DESC") = (rowTATEVNT1.Item("EVENT_DESC") & String.Empty).ToString.Substring(0, EVENT_DESC_LEN)
                    End If
                Next

                Try
                    BeginTrans()
                    Update_Record_TDA("TATEVNT1")
                    CommitTrans()
                Catch ex As Exception
                    Rollback()
                End Try
                Exit Sub
            End If

            Dim ship_ref As String = String.Empty
            ' ORDR_INV_COMMENT
            If ASCMAIN1.CLIENT = "RGI" AndAlso Not isEcommProcessing Then
                If dst.Tables("SOTINVH1").Rows.Count > 0 Then
                    Dim invoicesWithFreight As Int16 = dst.Tables("SOTINVH1").Select("INV_FREIGHT > 0").Length
                    Dim invoicesWithOutFreight As Int16 = dst.Tables("SOTINVH1").Select("INV_FREIGHT = 0").Length
                    Dim totalFreight As Double = Val(dst.Tables("SOTINVH1").Compute("SUM(INV_FREIGHT)", "") & String.Empty)

                    If invoicesWithFreight > 0 AndAlso invoicesWithOutFreight > 0 Then
                        Dim freightMessage As String = "Freight (" & totalFreight.ToString("#,##0.00") & ") shared across the following invoices: "
                        For Each rowFreight As DataRow In dst.Tables("SOTINVH1").Select("", "INV_FREIGHT DESC, INV_NO")
                            freightMessage &= rowFreight.Item("INV_NO") & ", "
                        Next
                        freightMessage = freightMessage.Trim
                        If freightMessage.Length > 0 Then
                            freightMessage = freightMessage.Substring(0, freightMessage.Length - 1)
                        End If

                        For Each rowFreight As DataRow In dst.Tables("SOTINVH1").Select("")
                            Dim INV_COMMENT As String = rowFreight.Item("INV_COMMENT") & " " & freightMessage
                            INV_COMMENT = INV_COMMENT.Trim
                            INV_COMMENT = INV_COMMENT.Replace("  ", " ")
                            If INV_COMMENT.Length > invCommentMaxLength Then
                                INV_COMMENT = INV_COMMENT.Substring(0, invCommentMaxLength).Trim
                            End If
                            rowFreight.Item("INV_COMMENT") = INV_COMMENT
                        Next
                    End If
                End If
            End If

            ' Record Invoice information in SOTORDC2 records
            For Each row As DataRow In dst.Tables("SOTORDC2").Select("ISNULL(PICK_NO, '*') <> '*'")
                Dim PICK_NO As String = row.Item("PICK_NO") & String.Empty
                PICK_NO = PICK_NO.Trim
                If PICK_NO.Length = 0 Then
                    Continue For
                End If
                Dim rowSOTPICK1X As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)
                If rowSOTPICK1X IsNot Nothing Then
                    row.Item("INV_NO") = rowSOTPICK1X.Item("INV_NO")
                    Dim INV_NO As String = row.Item("INV_NO") & String.Empty
                    If INV_NO.Length = 0 Then
                        Continue For
                    End If
                    Dim rowSOTINVH1 As DataRow = dst.Tables("SOTINVH1").Rows.Find(New Object() {"I", INV_NO})
                    If rowSOTINVH1 Is Nothing Then
                        Continue For
                    End If
                    row.Item("INV_NO") = rowSOTINVH1.Item("INV_NO")
                    row.Item("INV_DATE") = rowSOTINVH1.Item("INV_DATE")
                    row.Item("INV_AMOUNT") = rowSOTINVH1.Item("INV_TOTAL_AMOUNT")
                End If
            Next

            For Each rowSOTPICK1m As DataRow In dst.Tables("SOTPICK1").Select("")
                Dim INV_NO As String = rowSOTPICK1m.Item("INV_NO") & String.Empty
                Dim PICK_NO As String = rowSOTPICK1m.Item("PICK_NO") & String.Empty

                If INV_NO.Length = 0 Then Continue For

                For Each rowSOTINVHM As DataRow In dst.Tables("SOTINVHM").Select($"INV_NO = '{PICK_NO}'")
                    rowSOTINVHM.Item("INV_MNO") = Val(dst.Tables("SOTINVHM").Compute("MAX(INV_MNO)", $"INV_NO = '{INV_NO}'") & String.Empty) + 1
                    rowSOTINVHM.Item("INV_NO") = INV_NO
                Next
            Next

            ' Update comments.
            If ASCMAIN1.CLIENT = "RGI" AndAlso Not isEcommProcessing Then

                Dim invList As String = String.Empty
                For Each rowSOTINVH1 As DataRow In dst.Tables("SOTINVH1").Select("")
                    invList &= "," & rowSOTINVH1.Item("INV_NO") & String.Empty
                Next
                invList = invList.Substring(1)

                For Each rowSOTINVH1 As DataRow In dst.Tables("SOTINVH1").Select("")
                    Dim INV_NO As String = rowSOTINVH1.Item("INV_NO") & String.Empty
                    If dst.Tables("SOTPICK1").Select($"INV_NO = '{INV_NO}'").Length > 0 Then
                        Dim rowSOTPICK1x As DataRow = dst.Tables("SOTPICK1").Select($"INV_NO = '{INV_NO}'")(0)
                        If (rowSOTPICK1x.Item("INV_COMMENT") & String.Empty).ToString.StartsWith("Freight Allowance of") Then
                            Dim INV_COMMENT As String = rowSOTINVH1.Item("INV_COMMENT") & " " & rowSOTPICK1x.Item("INV_COMMENT") & invList
                            INV_COMMENT = INV_COMMENT.Trim
                            If INV_COMMENT.Length > invCommentMaxLength Then
                                INV_COMMENT = INV_COMMENT.Substring(0, invCommentMaxLength)
                            End If
                            rowSOTINVH1.Item("INV_COMMENT") = INV_COMMENT
                        End If
                    End If
                Next
            End If

            ' Cancel all Pick tickets where nothing was picked. - What happens with In Pick Qtys
            For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("SELECTED = '1'")
                rowSOTPICK1.Item("PICK_STATUS") = "F"
                Dim pickConf As Int32 = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_QTY_CONF)", "PICK_NO = '" & rowSOTPICK1.Item("PICK_NO") & "'") & String.Empty)
                If pickConf = 0 Then
                    rowSOTPICK1.Item("PICK_STATUS") = "C"
                    rowSOTPICK1.Item("LAST_OPER") = ASCMAIN1.USER_ID
                    rowSOTPICK1.Item("LAST_DATE") = DATETIME_STAMP
                Else
                    If dst.Tables("SOTINVH1").Select("PICK_NO = '" & rowSOTPICK1.Item("PICK_NO") & "'").Length = 0 Then
                        Throw New Exception("Not all Pick tickets created an Invoice.")
                    End If
                End If
            Next

            inTransaction = True
            BeginTrans()

            Update_SOTORDR5()

            Dim WHSE_CODE As String = Absx1.txtFor("WHSE_CODE").Text
            Dim rowICTWHSE1 As DataRow = dst.Tables("ICTWHSE1").Rows.Find(WHSE_CODE)
            Dim WHSE_PHYS_STATUS As String = rowICTWHSE1.Item("WHSE_PHYS_STATUS") & ""
            Dim WHSE_LOCATOR As Boolean = rowICTWHSE1.Item("WHSE_LOCATOR") & "" = "1"

            ' Calculate and Update Total Cartons & Weight by BOL
            ' Create New BOL's for Pick Tickets excluded from this Shipment

            ' Fetch FIFO costs for all Styles on this Group

            If edi_order AndAlso edi856_customer Then
                For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select()
                    rowSOTCART1.Item("CART_TOTAL_UNITS") = rowSOTCART1.Item("CART_TOTAL_UNITS_CALC")
                Next
                For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select("SELECTED = '1'")
                    'rowSOTPICK1.Item("PICK_FREIGHT") = rowSOTPICK1.Item("PICK_FREIGHT_CALC")
                    If ASCMAIN1.CLIENT <> "NYA" Then
                        rowSOTPICK1.Item("PICK_TOTAL_WGT") = rowSOTPICK1.Item("PICK_TOTAL_WGT_CALC")
                    End If
                    rowSOTPICK1.Item("PICK_CNT_CARTONS") = rowSOTPICK1.Item("PICK_CNT_CARTONS_CALC")
                Next
            End If

            ASCMAIN1.Progress("Now Updating ...", "")

            Dim old_new_bols As String = ""
            Dim SHIP_BOL_NO_new As String
            SHIP_BOL_NO = String.Empty

            rowSOTSHIP0.Item("SHIP_VIA_CODE") = Absx1.txtFor("SHIP_VIA_CODE").Text
            rowSOTSHIP0.Item("FRT_TERMS") = Absx1.txtFor("FRT_TERMS").Text
            rowSOTSHIP0.Item("BILL_OF_LADING_NO") = Absx1.txtFor("BILL_OF_LADING_NO").Text
            ' 09/20/2019 - do not overwrite ORDR_DEPT on the shipment records
            'rowSOTSHIP0.Item("ORDR_DEPT") = Absx1.txtFor("ORDR_DEPT").Text

            For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'")
                SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO") & String.Empty

                rowSOTSHIP1.Item("SHIP_VIA_CODE") = Absx1.txtFor("SHIP_VIA_CODE").Text
                rowSOTSHIP1.Item("FRT_TERMS") = Absx1.txtFor("FRT_TERMS").Text
                rowSOTSHIP1.Item("BILL_OF_LADING_NO") = Absx1.txtFor("BILL_OF_LADING_NO").Text
                ' rowSOTSHIP1.Item("MASTER_BOL_NO") = MASTER_BOL_NO
                ' 09/20/2019 - do not overwrite ORDR_DEPT on the shipment records
                'rowSOTSHIP1.Item("ORDR_DEPT") = Absx1.txtFor("ORDR_DEPT").Text
                rowSOTSHIP1.Item("SHIP_REF") = Absx1.txtFor("SHIP_REF").Text
                rowSOTSHIP0.Item("SHIP_REF") = Absx1.txtFor("SHIP_REF").Text

                If dst.Tables("WHTSHPC1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").Length > 0 Then
                    ship_ref = dst.Tables("WHTSHPC1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")(0).Item("MASTER_TRACKING_NO") & String.Empty
                    rowSOTSHIP1.Item("SHIP_REF") = ship_ref
                    rowSOTSHIP0.Item("SHIP_REF") = ship_ref
                End If

                ' Update carton Ship Ref with provided ship ref
                If ASCMAIN1.CLIENT = "RGI" AndAlso rowSOTSHIP1.Item("SHIP_REF") & String.Empty <> String.Empty AndAlso Not commonCarrier Then
                    For Each rowSOTPICK1x As DataRow In dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'")
                        Dim PICK_NOx As String = rowSOTPICK1x.Item("PICK_NO") & String.Empty
                        For Each rowSOTCART1x As DataRow In dst.Tables("SOTCART1").Select("PICK_NO = '" & PICK_NOx & "'")
                            rowSOTCART1x.Item("CART_TRACKING_NO") = rowSOTSHIP1.Item("SHIP_REF") & String.Empty
                        Next
                        'CART_TRACKING_NO
                    Next
                End If

                Dim INV_DATE As Date = rowSOTSHIP1.Item("INV_DATE")
                Dim ORDR_YYYYPP_UPDATED As String = ASCDATA1.GetDataValue("Select MIN(OPS_YYYYPP) from gltparm2 where prd_end_date >= '" & INV_DATE.ToString("dd-MMM-yyyy") & "'") & String.Empty
                If ORDR_YYYYPP_UPDATED.Length = 0 Then
                    ORDR_YYYYPP_UPDATED = ASCMAIN1.CYP
                End If

                'If select_from_3PL_list Then
                '    If ASCMAIN1.Running_in_VS Then Stop
                '    Dim AT As String = "@ADSIIS"
                '    ASCMAIN1.sql = "Update ADS.SOTSHIP1_3PL" & AT & " Set LP_STATUS = '3',LP_STATUS_TS_ERP = SYSDATE where SHIP_BOL_NO = '" & SHIP_BOL_NO & "' and LP_STATUS = 'V'"
                '    Dim I As Integer = ASCDATA1.ExecuteSQL()
                '    If I <> 1 Then
                '        MsgBox("Problem Updating 3PL Database", MsgBoxStyle.OkOnly, "This Confirmation will be Reversed")
                '        Me.Cursor = Cursors.Default
                '        ASCMAIN1.Progress("")
                '        Rollback()
                '        Exit Sub
                '    End If
                'End If

                Dim sqlw As String = "SHIP_BOL_NO = '" & SHIP_BOL_NO & "'"
                Dim sqlw_selected As String = sqlw & " and SELECTED = '1'"
                Dim T As DataTable = dst.Tables("SOTPICK1").Select("SHIP_BOL_NO = '" & SHIP_BOL_NO & "'").CopyToDataTable
                Dim SHIP_CNT_CARTONS As Int64 = Val(T.Compute("SUM(PICK_CNT_CARTONS)", sqlw_selected) & "")
                Dim SHIP_TOTAL_WGT As Decimal = Val(T.Compute("SUM(PICK_TOTAL_WGT)", sqlw_selected) & "")

                If ASCMAIN1.CLIENT = "VAN" Then
                    ORDR_CUST_PO = rowSOTSHIP1.Item("ORDR_CUST_PO") & String.Empty
                    SHIP_CNT_CARTONS = Val(dst.Tables("SOTSHIP2").Compute("SUM(PKG_QTY)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                    SHIP_TOTAL_WGT = Val(dst.Tables("SOTSHIP2").Compute("SUM(WEIGHT)", "ORDR_CUST_PO = '" & ORDR_CUST_PO & "'") & "")
                End If

                Dim SHIP_TOTAL_FRT As Decimal = Val(T.Compute("SUM(PICK_FREIGHT)", sqlw_selected) & "")
                Dim PICKS_SEL As Int64 = Val(T.Compute("Count(PICK_NO)", sqlw_selected) & "")
                Dim PICKS As Int64 = Val(T.Compute("Count(PICK_NO)", sqlw) & "")

                With rowSOTSHIP1
                    If PICKS_SEL > 0 Then
                        .Item("OPS_YYYYPP") = ORDR_YYYYPP_UPDATED 'ASCMAIN1.CYP
                        .Item("SHIP_CNT_CARTONS") = SHIP_CNT_CARTONS
                        .Item("SHIP_TOTAL_WGT") = SHIP_TOTAL_WGT
                        .Item("SHIP_STATUS") = "F"

                        ' 09/20/2019 - do not overwrite ORDR_DEPT on the shipment records - "ORDR_DEPT",
                        ' 09/01/2022 - do not overwrite ORDR_DEPT on the shipment records - "TERM_CODE",
                        For Each COLUMN_NAME As String In New String() _
                            {"SHIP_VIA_CODE", "SHIP_DATE_SHIPPED", "INV_DATE", "REASON_CODE",
                             "SREP_CODE", "SREP2_CODE", "SHIP_REF", "SHIP_MANIFEST_NO", "BILL_OF_LADING_NO", "FRT_TERMS"}
                            .Item(COLUMN_NAME) = rowSOTSHIP0.Item(COLUMN_NAME)

                            If ",SHIP_DATE_SHIPPED,INV_DATE,".Contains("," & COLUMN_NAME & ",") Then
                                If IsDate(.Item(COLUMN_NAME) & String.Empty) Then
                                    .Item(COLUMN_NAME) = CDate(.Item(COLUMN_NAME).ToString).ToShortDateString
                                End If
                            End If
                        Next

                        If PICKS_SEL <> PICKS Then
                            Dim rowSOTSHIP1_P As DataRow = dst.Tables("SOTSHIP1").NewRow
                            With rowSOTSHIP1_P
                                For i As Integer = 0 To dst.Tables("SOTSHIP1").Columns.Count - 1
                                    .Item(i) = rowSOTSHIP1.Item(i)
                                Next i
                                If ASCMAIN1.CLIENT = "VAN" Then
                                    SHIP_BOL_NO_new = ASCMAIN1.Next_Control_No("SHIP_BOL_NO")
                                Else
                                    SHIP_BOL_NO_new = ASCMAIN1.Next_Control_No("SOTSHIP1.SHIP_BOL_NO")
                                End If
                                old_new_bols = old_new_bols & vbCr & SHIP_BOL_NO & " -> " & SHIP_BOL_NO_new
                                .Item("SHIP_BOL_NO") = SHIP_BOL_NO_new
                                .Item("SHIP_CNT_CARTONS") = 0
                                .Item("SHIP_TOTAL_WGT") = 0
                                .Item("SHIP_STATUS") = "P"
                                .Item("OPS_YYYYPP") = ""

                                ' 09/20/2019 - do not overwrite ORDR_DEPT on the shipment records - "ORDR_DEPT",
                                ' 09/01/2022 - do not overwrite TERM_CODE on the shipment records - "TERM_CODE",
                                For Each COLUMN_NAME As String In New String() _
                                    {"SHIP_VIA_CODE", "SHIP_DATE_SHIPPED", "INV_DATE", "REASON_CODE",
                                     "SREP_CODE", "SREP2_CODE", "SHIP_REF", "SHIP_MANIFEST_NO", "BILL_OF_LADING_NO", "FRT_TERMS"}
                                    .Item(COLUMN_NAME) = rowSOTSHIP0_ORIG.Item(COLUMN_NAME)
                                Next
                            End With
                            dst.Tables("SOTSHIP1").Rows.Add(rowSOTSHIP1_P)
                            sqlw = "SHIP_BOL_NO = '" & SHIP_BOL_NO & "' and SELECTED <> '1'"
                            For Each rowSOTPICK1 In dst.Tables("SOTPICK1").Select(sqlw)
                                rowSOTPICK1.Item("SHIP_BOL_NO") = SHIP_BOL_NO_new
                            Next
                        End If
                    Else
                        .Item("SHIP_CNT_CARTONS") = 0
                        .Item("SHIP_TOTAL_WGT") = 0
                        .Item("SHIP_VIA_CODE") = ""
                        .Item("SHIP_DATE_SHIPPED") = DBNull.Value
                        .Item("FRT_TERMS") = ""
                        .Item("SHIP_REF") = ""
                        .Item("SHIP_MANIFEST_NO") = ""
                        .Item("BILL_OF_LADING_NO") = ""
                    End If
                    .Item("LAST_DATE") = DATETIME_STAMP
                    .Item("LAST_OPER") = ASCMAIN1.USER_ID
                End With
            Next

            Update_Record_TDA("SOTORDR1")
            Update_Record_TDA("SOTORDR2")
            Update_Record_TDA("SOTORDR5")

            RecordPriceChanges()
            Update_Record_TDA("TATEVNT1")

            Update_Record_TDA("SOTORDXR")
            Update_Record_TDA("SOTORDR9")
            Update_Record_TDA("SOTRNGA1")
            Update_Record_TDA("SOTORDC1")
            Update_Record_TDA("SOTORDC2")

            If RFIXMSG = True Then
                MsgBox("Range Styles Were Fixed On this Shipment. Please Alert ABS", MsgBoxStyle.OkOnly, "Ranges")
            End If

            ASCMAIN1.sql = "UPDATE SOTSHIP1 SET BILL_OF_LADING_NO = NULL WHERE BILL_OF_LADING_NO = '" & Absx1.txtFor("BILL_OF_LADING_NO").Text & "'"
            ASCDATA1.ExecuteSQL(ASCMAIN1.sql)

            INIT_LAST("SOTSHIP1", False, , True)
            INIT_LAST("SOTPICK1", False, , True)

            SHIP_BOL_NO = String.Empty
            For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'", "", DataViewRowState.CurrentRows)
                SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")
                ASCMAIN1.Progress("Updating Shipment " & SHIP_BOL_NO, "")
                Delete_Records(SHIP_BOL_NO, False)
            Next

            ' Copy Work Table Contents to Oracle
            For Each TABLE_NAME As String In tablesToReset

                If dst.Tables(TABLE_NAME).Rows.Count = 0 Then
                    Continue For
                End If

                dst.Tables(TABLE_NAME).AcceptChanges()
                For Each row As DataRow In dst.Tables(TABLE_NAME).Select("")
                    row.SetAdded()
                Next

                Create_BAs(TABLE_NAME, True)
                Update_BAs(TABLE_NAME, True)
            Next

            For Each row As DataRow In dst.Tables("SOTSHIPB").Select("")
                row.Item("BOL_STATUS") = "F"
                row.Item("LAST_OPER") = ASCMAIN1.USER_ID
                row.Item("LAST_DATE") = DATETIME_STAMP
            Next
            Update_Record_TDA("SOTSHIPB")

            If select_from_3PL_list AndAlso dst.Tables.Contains("EDT945T1") Then
                Update_Record_TDA("EDT945T1")
            End If

            For Each TABLE_NAME As String In New String() {"SOTINVH1", "SOTINVH2", "SOTINVH9", "SOTINVHM", "ARTOPEN1"}

                ' 6/17/2019 - special processing for Vandale
                If ASCMAIN1.CLIENT = "VAN" Then
                    Select Case TABLE_NAME
                        Case "SOTINVH1", "SOTINVH2"
                            For Each row As DataRow In dst.Tables(TABLE_NAME).Select("")
                                row.Item("ORDR_YYYYPP_UPDATED") = System.DBNull.Value
                            Next

                        Case "ARTOPEN1"
                            dst.Tables(TABLE_NAME).AcceptChanges()
                            Continue For
                    End Select

                End If

                If dst.Tables(TABLE_NAME).Rows.Count = 0 Then
                    Continue For
                End If

                dst.Tables(TABLE_NAME).AcceptChanges()
                For Each row As DataRow In dst.Tables(TABLE_NAME).Select("")
                    row.SetAdded()
                Next

                Create_BAs(TABLE_NAME, True)
                Update_BAs(TABLE_NAME, True)

            Next

            ' 8/17/22 rewrite WHTMOVE2 to check location_qty and add new records to avoid negative inventory
            Dim checkLocQtySQL As String = $"select NVL(location_qty,0) from WHTLOCB1 where WHSE_CODE = '{WHSE_CODE}'" & vbCrLf _
                & " and LOCATION_CODE = '{0}' and STYLE_CODE = '{1}' and COLOR_CODE = '{2}'"
            'deliberately not checking location qty in where clause due to order by (we want a line to come back)
            Dim nextLocSql = "Select WHTLOCB1.*, nvl(WHTLOCM1.LOCATION_USE,'A') LOCATION_USE from WHTLOCB1, WHTLOCM1 " & vbCrLf _
                & " where WHTLOCB1.WHSE_CODE = WHTLOCM1.WHSE_CODE " & vbCrLf _
                & " and WHTLOCB1.LOCATION_CODE = WHTLOCM1.LOCATION_CODE " & vbCrLf _
                & " and nvl(WHTLOCM1.LOCATION_USE,'A') in ('A','E') " & vbCrLf _
                & $" and WHTLOCB1.WHSE_CODE = '{WHSE_CODE}'" & vbCrLf _
                & " and WHTLOCB1.STYLE_CODE = '{0}' and WHTLOCB1.COLOR_CODE = '{1}'"


            ' 6/18/2019 - Vandale uses SORUPDT1 for the code that does Invoice Update at Vandale
            If ASCMAIN1.CLIENT <> "VAN" Then
                For Each rowSOTINVH1 As DataRow In dst.Tables("SOTINVH1").Rows

                    ASCMAIN1.sql = "BEGIN SOPSTAT1('" & rowSOTINVH1.Item("INV_TYPE") & "','" & rowSOTINVH1.Item("INV_NO") & "'); END;"
                    ASCDATA1.ExecuteSQL()

                    ASCMAIN1.sql = "BEGIN SOPSTAT2('" & rowSOTINVH1.Item("INV_TYPE") & "','" & rowSOTINVH1.Item("INV_NO") & "'); END;"
                    ASCDATA1.ExecuteSQL()

                    ' When should this be called - Only whses that use Locations
                    If WHSE_LOCATOR Then
                        TAC.ICCMAIN1.Update_WHTLOCBX("S", rowSOTINVH1.Item("INV_NO"))

                        If ASCMAIN1.CLIENT = "RGI" AndAlso dst.Tables("WHTMOVE2").Rows.Count > 0 Then
                            For Each rowWHTMOVE2 As DataRow In dst.Tables("WHTMOVE2").Select("")
                                Dim STYLE_CODE As String = rowWHTMOVE2.Item("STYLE_CODE")
                                Dim COLOR_CODE As String = rowWHTMOVE2.Item("COLOR_CODE")
                                Dim WHSE_TRAN_QTY As Int32 = Val(dst.Tables("SOTPICK2").Compute("SUM(PICK_QTY_CONF)", "STYLE_CODE = '" & STYLE_CODE & "' AND COLOR_CODE = '" & COLOR_CODE & "'") & String.Empty)
                                Dim LOCATION_CODE As String = rowWHTMOVE2.Item("LOCATION_CODE_FROM")
                                Dim LOCATION_QTY As Int32 = Val(ASCDATA1.GetDataValue(String.Format(checkLocQtySQL, LOCATION_CODE, STYLE_CODE, COLOR_CODE)))
                                If LOCATION_QTY < WHSE_TRAN_QTY Then
                                    If LOCATION_QTY > 0 Then
                                        rowWHTMOVE2.Item("WHSE_TRAN_QTY") = LOCATION_QTY
                                        WHSE_TRAN_QTY -= LOCATION_QTY
                                    Else
                                        'find next location with qty
                                        Dim nextRow As DataRow = ASCDATA1.GetDataRow(String.Format("Select * from (" & nextLocSql & " order by WHTLOCM1.LOCATION_USE DESC, WHTLOCB1.LOCATION_QTY DESC) and rownum = 1", STYLE_CODE, COLOR_CODE))
                                        If nextRow IsNot Nothing Then
                                            LOCATION_QTY = Val(nextRow("LOCATION_QTY") & "")
                                            If LOCATION_QTY = 0 And nextRow.Item("LOCATION_USE") <> "E" Then
                                                LOCATION_QTY = WHSE_TRAN_QTY
                                            End If
                                            rowWHTMOVE2.Item("LOCATION_CODE_FROM") = nextRow("LOCATION_CODE") & ""
                                            If LOCATION_QTY < WHSE_TRAN_QTY Then
                                                WHSE_TRAN_QTY -= LOCATION_QTY
                                            Else
                                                LOCATION_QTY = WHSE_TRAN_QTY
                                                WHSE_TRAN_QTY = 0
                                            End If
                                            rowWHTMOVE2.Item("WHSE_TRAN_QTY") = LOCATION_QTY
                                        End If
                                    End If
                                Else
                                    rowWHTMOVE2.Item("WHSE_TRAN_QTY") = WHSE_TRAN_QTY
                                    WHSE_TRAN_QTY = 0
                                End If
                                If WHSE_TRAN_QTY > 0 Then
                                    For Each newRow As DataRow In ASCDATA1.GetDataTable(String.Format(nextLocSql, STYLE_CODE, COLOR_CODE)).Select("", "LOCATION_USE DESC, LOCATION_QTY DESC")
                                        If newRow("LOCATION_CODE") & "" <> LOCATION_CODE Then
                                            Dim rowWHTMOVE2_NEW As DataRow = dst.Tables("WHTMOVE2").NewRow()
                                            rowWHTMOVE2_NEW.ItemArray = rowWHTMOVE2.ItemArray.Clone
                                            Dim lno As Int32 = dst.Tables("WHTMOVE2").Rows.Count + 1
                                            rowWHTMOVE2_NEW.Item("WHSE_TRAN_LNO") = lno
                                            LOCATION_QTY = Val(newRow("LOCATION_QTY") & "")
                                            If LOCATION_QTY = 0 And newRow.Item("LOCATION_USE") <> "E" Then
                                                LOCATION_QTY = WHSE_TRAN_QTY
                                            End If
                                            If LOCATION_QTY >= WHSE_TRAN_QTY Then
                                                LOCATION_QTY = WHSE_TRAN_QTY
                                            End If
                                            rowWHTMOVE2_NEW.Item("LOCATION_CODE_FROM") = newRow("LOCATION_CODE") & ""
                                            rowWHTMOVE2_NEW.Item("WHSE_TRAN_QTY") = LOCATION_QTY
                                            WHSE_TRAN_QTY -= LOCATION_QTY
                                            dst.Tables("WHTMOVE2").Rows.Add(rowWHTMOVE2_NEW)
                                            If WHSE_TRAN_QTY = 0 Then Exit For
                                        End If
                                    Next
                                End If
                                'rowWHTMOVE2.Item("WHSE_TRAN_QTY") = WHSE_TRAN_QTY
                            Next

                            Update_Record_TDA("WHTMOVE1")
                            Update_Record_TDA("WHTMOVE2")

                            ' 5/29/2018 - Moved to end of procedure
                            'PROCEDURE "WHPMOVE1" (WHSE_TRAN_NO_IN VARCHAR2, WHSE_TRAN_LNO_IN NUMBER, S NUMBER) IS
                            For Each rowWHTMOVE2 As DataRow In dst.Tables("WHTMOVE2").Select("WHSE_TRAN_QTY > 0 ")
                                Try
                                    ASCMAIN1.sql = "BEGIN WHPMOVE1('" & rowWHTMOVE2.Item("WHSE_TRAN_NO") & "','" & rowWHTMOVE2.Item("WHSE_TRAN_LNO") & "'," & "1" & "); END;"
                                    ASCDATA1.ExecuteSQL()

                                Catch ex As Exception
                                    MessageBox.Show("Move error: " & ex.Message, "Move Inventory", MessageBoxButtons.OK, MessageBoxIcon.Error)
                                End Try
                            Next
                        End If
                    End If

                    ASCDATA1.ExecuteSP("ARPCUST6_IC", "VV",
                       New Object() {rowSOTINVH1.Item("INV_TYPE"), rowSOTINVH1.Item("INV_NO")},
                       New String() {"INV_TYPE_IN", "INV_NO_IN"})
                Next
            End If

            Dim order_header_updates_required As Boolean = False
            Dim SQLX As String = ""
            For Each COL As String In New String() {"SREP_CODE", "SREP2_CODE", "TERM_CODE", "ORDR_DEPT"}
                If rowSOTSHIP0_ORIG.Item(COL) & "" <> rowSOTSHIP0.Item(COL) & "" Then
                    order_header_updates_required = True
                    Exit For
                End If
            Next

            ' Process each BOL, now that it is in Oracle
            SHIP_BOL_NO = String.Empty
            For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'", "", DataViewRowState.CurrentRows)
                SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")

                'Dependent_Updates(1, SHIP_BOL_NO)
                ASCMAIN1.sql = "BEGIN SOPORDR0_G('" & rowSOTSHIP1.Item("ORDR_GROUP_NO") & "'); END;"
                ASCDATA1.ExecuteSQL()

                If order_header_updates_required Then
                    ASCMAIN1.sql = "Update SOTORDR1 " _
                         & "Set TERM_CODE = :PARM1, ORDR_DEPT = :PARM2" & vbCrLf _
                         & " where ORDR_NO in " & vbCrLf _
                         & " (Select ORDR_NO from SOTPICK1 " & vbCrLf _
                         & " where SHIP_BOL_NO = :PARM3)" & vbCrLf
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql, "VVV",
                                        New Object() {rowSOTSHIP1.Item("TERM_CODE"),
                                                      rowSOTSHIP1.Item("ORDR_DEPT"),
                                                      rowSOTSHIP1.Item("SHIP_BOL_NO")})
                End If

                'Kill any possible Store Order Configuration Records from the Shipment.
                'They can and should be re-built by running the report if need be.
                ASCMAIN1.sql = "Delete from SOTCONF2" & vbCrLf _
                    & " where ORDR_NO in " & vbCrLf _
                    & " (Select ORDR_NO from SOTPICK1 " & vbCrLf _
                    & " where SHIP_BOL_NO = '" & SHIP_BOL_NO & "')"
                ASCDATA1.ExecuteSQL()
            Next

            'Update Invoices to remove consolodated records when there is only one invoice.
            'Recv'd from Dave and implimented on 2/16 - W.R.
            ' Only for VAN 9/3/2013 - edz
            If ASCMAIN1.CLIENT = "VAN" Then
                ASCMAIN1.sql = "Update SOTINVH1 SET INV_NO_CONS = NULL where INV_NO_CONS IN" _
                    & " (SELECT INV_NO_CONS FROM" _
                    & " (SELECT INV_NO_CONS, COUNT(*) FROM SOTINVH1 WHERE INV_NO_CONS IS NOT NULL" _
                    & " group by INV_NO_CONS" _
                    & " having COUNT(*) = 1))"
                ASCDATA1.ExecuteSQL()
            End If

            ' Group Record
            ASCMAIN1.sql = "BEGIN SOPORDR0_G('" & ORDR_GROUP_NO & "'); END;"
            ASCDATA1.ExecuteSQL()

            'Update New Control File To Force SJ&U between Confirm and Deconfirm - WR - 20051024
            ASCMAIN1.sql = "Update SOTCTLU1 SET CTL_UPDATE_REQ = 'C' WHERE UPPER(CTL_KEY) = 'Z'"
            ASCDATA1.ExecuteSQL()

            If old_new_bols <> "" Then
                MsgBox(old_new_bols, vbOKOnly, "Unshipped P/T's on the following BOL's have been assigned a New BOL No")
            End If

            For Each rowSOTINVH1 As DataRow In dst.Tables("SOTINVH1").Select("ORDR_TYPE_CODE = 'XFR'")
                Update_Transfer(rowSOTINVH1.Item("INV_NO"))
                SOCMAIN1.Create_943_for_Transfer_Order_Receipt(Me, rowSOTINVH1)
            Next

            Dim lstInvNos As New List(Of String)

            If isRegencyTransferShipment Then
                For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("BILL_OF_LADING_NO = '" & BOL_NO & "'", "", DataViewRowState.CurrentRows)
                    Dim EDI_SHIPMENT_ID As String = rowSOTSHIP1.Item("SHIP_BOL_NO")
                    ASCDATA1.ExecuteSQL("UPDATE EDT945T1 SET EDI_PROCESS_IND = '1' WHERE EDI_SHIPMENT_ID = :PARM1", "V", {EDI_SHIPMENT_ID})
                Next
            End If

            ' Do not show message for Ecommerce Shipments.
            If ASCMAIN1.CLIENT <> "RGI" OrElse isEcommProcessing OrElse isRegencyTransferShipment Then
                CommitTrans()
            Else
                For Each row As DataRow In dst.Tables("SOTINVH1").Select("", "INV_NO")
                    lstInvNos.Add(row.Item("INV_NO"))
                Next
                CommitTrans("Shipment Updated - Invoice Number(s): " & String.Join(", ", lstInvNos.ToArray))
            End If

            ASCMAIN1.Progress("Print Shipping Labels")
            For Each shippingLabel As String In shipLabels
                If shippingLabel.Trim.Length > 0 Then PrintLabel(shippingLabel)
            Next

            PrintUCCLabels()


            If ASCMAIN1.CLIENT = "RGI" Then
                Try
                    BeginTrans()

                    For Each TABLE_NAME As String In New String() {"EDTSYSIH",
                                                                   "EDT856O1", "EDT856O2", "EDT856O3", "EDT856O4", "EDT856O5", "EDT856O6",
                                                                   "EDT810O1", "EDT810O2", "EDT810O3", "EDT810O4", "EDT810O5"}
                        If dst.Tables.Contains(TABLE_NAME) Then
                            dst.Tables(TABLE_NAME).Rows.Clear()
                        End If
                    Next

                    For Each row As DataRow In dst.Tables("EDT945T1").Select("")
                        row.Item("EDI_PROCESS_IND") = "1"
                        row.Item("CUST_CODE") = txtCUST_CODE.Text
                    Next

                    ' Kirklands is requiring that the 856 be sent before the 810
                    ' Therefore, we will not create the EDI 810.
                    ' The user can use the EDI export screen to send the 810s
                    ' We will create a service to send the 810s at a later time.

                    Dim process810 As Boolean = True
                    Dim process856 As Boolean = True

                    If isEcommProcessing AndAlso dst.Tables("ECTECOM1").Rows.Count > 0 Then
                        process810 = dst.Tables("ECTECOM1").Rows(0).Item("DELAY_EDI_810") & String.Empty <> "1"
                        process856 = dst.Tables("ECTECOM1").Rows(0).Item("DELAY_EDI_856") & String.Empty <> "1"
                    End If

                    For Each rowSOTSHIP1 As DataRow In dst.Tables("SOTSHIP1").Select("SHIP_STATUS = 'F'")

                        If rowSOTSHIP1.Item("SHIP_810_IND") & String.Empty = "1" _
                                AndAlso rowSOTSHIP1.Item("SHIP_810_BATCH_NO") & String.Empty = String.Empty _
                                AndAlso process810 Then
                            ASCMAIN1.Progress("Create EDI 810 records")
                            Dim clsEDC810O1 As New TAC.EDC810O1(dst)

                            SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")
                            Dim SHIP_810_BATCH_NO As String = String.Empty
                            Dim EDI_BATCH_NO As String = ASCMAIN1.Next_Control_No("EDT810O1.EDI_BATCH_NO")
                            clsEDC810O1.Create810(SHIP_BOL_NO, SHIP_810_BATCH_NO, EDI_BATCH_NO, False)

                            ' if the invoices are $0.00 then SHIP_810_BATCH_NO will be empty - need to set to something
                            If SHIP_810_BATCH_NO = String.Empty Then
                                Throw New Exception("Unable to process EDI 810 for Ship Bol No: " & SHIP_BOL_NO)
                            End If

                            ASCMAIN1.sql = "UPDATE SOTSHIP1 " _
                                     & " SET EDI_810_CREATED = SYSDATE" _
                                     & ", SHIP_810_BATCH_NO = '" & SHIP_810_BATCH_NO & "'" _
                                     & ", LAST_OPER = '" & ASCMAIN1.USER_ID & "'" _
                                     & ", LAST_DATE = SYSDATE WHERE SHIP_BOL_NO = '" & SHIP_BOL_NO & "'"
                            ASCDATA1.ExecuteSQL(ASCMAIN1.sql)

                            For Each TABLE_NAME As String In New String() {"EDTSYSIH", "EDT810O1", "EDT810O2", "EDT810O3", "EDT810O4", "EDT810O5"}
                                If dst.Tables.Contains(TABLE_NAME) Then
                                    Update_Record_TDA(TABLE_NAME)
                                    dst.Tables(TABLE_NAME).Rows.Clear()
                                End If
                            Next
                        End If

                        If rowSOTSHIP1.Item("SHIP_856_IND") & String.Empty = "1" _
                                AndAlso rowSOTSHIP1.Item("SHIP_856_BATCH_NO") & String.Empty = String.Empty _
                                AndAlso process856 Then

                            ASCMAIN1.Progress("Create EDI 856 records")

                            Dim clsEDC856O1 As New TAC.EDC856O1(dst)

                            SHIP_BOL_NO = rowSOTSHIP1.Item("SHIP_BOL_NO")
                            Dim errorMessge As String = String.Empty

                            Dim SHIP_856_BATCH_NO As String = clsEDC856O1.CreateEDI856(SHIP_BOL_NO, errorMessge)

                            If SHIP_856_BATCH_NO = String.Empty Then
                                Throw New Exception("Unable to process EDI 856 for Ship Bol No: " & SHIP_BOL_NO & IIf(errorMessge.Length > 0, ", " & errorMessge, ""))
                            End If

                            For Each rowSOTSHIP1x As DataRow In dst.Tables("SOTSHIP1").Select("SHIP_STATUS = 'F'")
                                Dim SHIP_BOL_NOx As String = rowSOTSHIP1x.Item("SHIP_BOL_NO")
                                ASCMAIN1.sql = "UPDATE SOTSHIP1 " _
                                    & " SET EDI_856_CREATED = SYSDATE" _
                                    & ", SHIP_856_BATCH_NO = '" & SHIP_856_BATCH_NO & "'" _
                                    & ", LAST_OPER = '" & ASCMAIN1.USER_ID & "'" _
                                    & ", LAST_DATE = SYSDATE WHERE SHIP_BOL_NO = '" & SHIP_BOL_NOx & "'"
                                ASCDATA1.ExecuteSQL(ASCMAIN1.sql)

                                rowSOTSHIP1x.Item("SHIP_856_BATCH_NO") = SHIP_856_BATCH_NO
                            Next

                            For Each TABLE_NAME As String In New String() {"EDTSYSIH", "EDT856O1", "EDT856O2", "EDT856O3", "EDT856O4", "EDT856O5", "EDT856O6"}
                                Update_Record_TDA(TABLE_NAME)
                                dst.Tables(TABLE_NAME).Rows.Clear()
                            Next
                        End If
                    Next

                    Update_Record_TDA("EDT945T1")

                    ASCMAIN1.Progress("Updating EDI 810/856 data")
                    CommitTrans()

                Catch ex As Exception
                    Rollback("Error generating EDI 856/810: " & ex.Message)
                End Try
            End If

            If ASCMAIN1.CLIENT = "RGI" Then
                Select Case Absx1.txtFor("CUST_CODE").Text

                    Case RegencyAmazonComCustCode
                        Try
                            PrintAmazonPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error generating Amazon Pack Slip: " & ex.Message, "Print Amazon", MessageBoxButtons.OK)
                        End Try

                    Case RegencyHouzzLLCCustCode
                        Try
                            PrintHouzzPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error generating Houzz Pack Slip: " & ex.Message, "Print Houzz", MessageBoxButtons.OK)
                        End Try

                    Case RegencyOverstockComCustCode
                        Try
                            PrintOverStockDeliveryReceipt()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Overstock.com Delivery Receipt: " & ex.Message, "Print Overstock", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyKirklandsCustCode, RegencyKirklandsCustCodeAlt
                        Try
                            PrintKirklandsPackingList()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Kirkland's Packing List: " & ex.Message, "Print Kirkland's", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                        Try
                            RequestFedExReturnLabel("FXG")
                        Catch ex As Exception

                        End Try

                    Case RegencyKohlsCustCode
                        Try
                            PrintKohlsPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Kohls Pack Slip: " & ex.Message, "Print Overstock", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyWayfairCustCode
                        Try
                            PrintWayFairPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Wayfair Packing List: " & ex.Message, "Print Wayfair", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyQVCCustCode
                        Try
                            PrintQVCPackingList()
                        Catch ex As Exception
                            MessageBox.Show("Error printing QVC Packing List: " & ex.Message, "Print QVC", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyWalmartCustCode
                        Try
                            PrintWalmartPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Walmart Packing List: " & ex.Message, "Print Walmart", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyHomeDepotCustCode
                        Try
                            PrintHomeDepotPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Home Depot Packing List: " & ex.Message, "Print Home Depot", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyNeimanMarcusCustCode
                        Try
                            PrintNeimanMarcusPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Neiman Marcus Packing List: " & ex.Message, "Print Neiman Marcus", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case RegencyChristmasCentral
                        Try
                            PrintChristmasCentralPackSlip()
                        Catch ex As Exception
                            MessageBox.Show("Error printing Christmas Central Packing List: " & ex.Message, "Print Christmas Central", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End Try

                    Case Else
                        If dst.Tables("SOTORDR1").Rows(0).Item("ECOM_CODE") & String.Empty = RegencyApiCustomerEcomCode Then
                            Try
                                PrintApiCustPackSlip()
                            Catch ex As Exception
                                MessageBox.Show("Error printing API Customer Packing List: " & ex.Message, "Print API Customer", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            End Try
                        End If

                End Select
            End If

            If isEcommProcessing Then
                EcomShortShip()
                PrintEcommUCCLabels()
            End If

            ' Create Web Invoices
            Try
                If Not (isEcommProcessing OrElse isRegencyTransferShipment) Then ' OrElse (ASCMAIN1.CLIENT = "RGI" AndAlso dst.Tables("SOTINVH1").Select("SREP_CODE = 'DM'").Length > 0) 5/1/2019 - Danny does not want the emails
                    ASCMAIN1.Progress("Creating Web Invoice", "")
                    For Each row As DataRow In dst.Tables("SOTINVH1").Select("")
                        TAC.SOCMAIN1.CreateWebInvoice(Me, row.Item("INV_TYPE"), row.Item("INV_NO"))
                        ' Email Invoice to Sales Rep and Customer.
                        EmailInvoice(row.Item("INV_TYPE"), row.Item("INV_NO"))
                    Next
                End If

                If ASCMAIN1.CLIENT = "RGI" Then
                    If rowARTCUST1 IsNot Nothing Then
                        If rowARTCUST1.Item("CUST_XMIT_INV_VIA") & String.Empty = "E" OrElse edi_order OrElse isEcommProcessing OrElse isRegencyTransferShipment Then
                            For Each rowSOTINVH1 As DataRow In dst.Tables("SOTINVH1").Rows
                                Dim INV_NO As String = rowSOTINVH1.Item("INV_NO")
                                ASCDATA1.ExecuteSQL("Update SOTINVH1 Set INV_PRINTED = SYSDATE where INV_NO = '" & INV_NO & "'")
                            Next
                        End If
                    End If
                End If

            Catch ex As Exception
                ' No Error message at this time.
            End Try

        Catch ex As Exception
            If inTransaction Then Rollback()
            MessageBox.Show("Update Error: " & ex.Message, "Update", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            Me.Cursor = Cursors.Default
            ASCMAIN1.Progress("")
        End Try

    End Sub

