    Private Sub PrintHomeDepotPackSlip()

        Try

            If ASCMAIN1.CLIENT <> "RGI" Then
                Exit Sub
            End If

            If CUST_CODE <> RegencyHomeDepotCustCode Then
                Exit Sub
            End If

            If dst.Tables("SOTORDR1").Rows(0).Item("EDI_DOC_SEQ_NO") & String.Empty = String.Empty Then
                Exit Sub
            End If

            If dst.Tables("SOTORDR1").Rows(0).Item("ECOM_CODE") & String.Empty = String.Empty Then
                Exit Sub
            End If

            ' Must be and EDI sales order
            If dst.Tables("EDT850T2").Rows.Count = 0 Then
                Exit Sub
            End If

            Dim ORDR_NO As String = dst.Tables("SOTORDR1").Rows(0).Item("ORDR_NO")
            Dim rowSOTORDR1 As DataRow = dst.Tables("SOTORDR1").Rows.Find(New Object() {ORDR_NO})
            Dim EDI_DOC_SEQ_NO As String = rowSOTORDR1.Item("EDI_DOC_SEQ_NO") & String.Empty
            Dim rowEDT850T1 As DataRow = dst.Tables("EDT850T1").Rows.Find(New Object() {EDI_DOC_SEQ_NO})
            Dim rowSOTORDR5 As DataRow = dst.Tables("SOTORDR5").Rows.Find(New Object() {ORDR_NO, "ST"})

            ' Need to get Customer Telehone Number from EDI data.
            If dst.Tables("EDT850T9_PH").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'").Length > 0 Then
                If rowSOTORDR5 IsNot Nothing Then
                    Dim CONTACT_COMM_NO_1 As String = dst.Tables("EDT850T9_PH").Select("EDI_DOC_SEQ_NO = '" & EDI_DOC_SEQ_NO & "'")(0).Item("CONTACT_COMM_NO_1") & String.Empty
                    CONTACT_COMM_NO_1 = CONTACT_COMM_NO_1.Trim
                    If CONTACT_COMM_NO_1.Length > 0 Then
                        rowSOTORDR5.Item("CUST_PHONE") = CONTACT_COMM_NO_1
                    End If
                End If
            End If

            If Not dst.Tables.Contains("HD") Then
                dst.Tables.Add("HD")
                With dst.Tables("HD")
                    .Columns.Add("PAGE", GetType(System.Int16))
                    .Columns.Add("ORDR_NO", GetType(System.String))
                    .Columns.Add("EDI_PO_RELEASE_NO", GetType(System.String))
                    .Columns.Add("EDI_PO_NO", GetType(System.String))
                    .Columns.Add("ORDR_DATE", GetType(System.String))
                    .Columns.Add("EDI_SHIPPER", GetType(System.String))
                    .Columns.Add("HEADER_MESSAGE", GetType(System.String))

                    .Columns.Add("CUST_NAME", GetType(System.String))
                    .Columns.Add("CUST_ADDR1", GetType(System.String))
                    .Columns.Add("CUST_ADDR2", GetType(System.String))
                    .Columns.Add("CUST_ADDR3", GetType(System.String))
                    .Columns.Add("CUST_CITY", GetType(System.String))
                    .Columns.Add("CUST_STATE", GetType(System.String))
                    .Columns.Add("CUST_ZIP_CODE", GetType(System.String))
                    .Columns.Add("CUST_COUNTRY", GetType(System.String))
                    .Columns.Add("CUST_PHONE", GetType(System.String))
                    .Columns.Add("DISPLAY_RETURNS_SECTION", GetType(System.String))
                    .Columns("DISPLAY_RETURNS_SECTION").DefaultValue = "0"
                End With

                dst.Tables.Add("MERCH")
                With dst.Tables("MERCH")
                    .Columns.Add("PAGE", GetType(System.Int16))
                    .Columns.Add("ORDR_NO", GetType(System.String))
                    .Columns.Add("ORDR_LNO", GetType(System.String))
                    .Columns.Add("STYLE_CODE", GetType(System.String))
                    .Columns.Add("COLOR_CODE", GetType(System.String))
                    .Columns.Add("CUST_SKU", GetType(System.String))
                    .Columns.Add("CUST_UPC", GetType(System.String))
                    .Columns.Add("ORDR_QTY_SHIP", GetType(System.Int16))
                    .Columns.Add("EDI_ITEM_DESC", GetType(System.String))
                End With

                dst.Tables.Add("RETURNS")
                With dst.Tables("RETURNS")
                    .Columns.Add("PAGE", GetType(System.Int16))
                    .Columns.Add("ORDR_NO", GetType(System.String))
                    .Columns.Add("ORDR_LNO", GetType(System.String))
                    .Columns.Add("STYLE_CODE", GetType(System.String))
                    .Columns.Add("COLOR_CODE", GetType(System.String))
                    .Columns.Add("CUST_SKU", GetType(System.String))
                    .Columns.Add("CUST_UPC", GetType(System.String))
                    .Columns.Add("ORDR_QTY_SHIP", GetType(System.Int16))
                    .Columns.Add("EDI_ITEM_DESC", GetType(System.String))
                End With
            End If

            dst.Tables("HD").Clear()
            dst.Tables("MERCH").Clear()
            dst.Tables("RETURNS").Clear()

            Dim merchCounter As Integer = 10
            Dim merchPage As Integer = 0
            Dim rowMERCH As DataRow = Nothing
            Dim merchNumlines As Integer = 0

            Dim returnsCounter As Integer = 10
            Dim returnsPage As Integer = 0
            Dim rowRETURNS As DataRow = Nothing

            For Each rowSOTORDR2 As DataRow In dst.Tables("SOTORDR2").Select("ORDR_QTY_SHIP > 0", "ORDR_LNO")

                merchCounter += 1
                If merchCounter + merchNumlines > 9 Then
                    merchCounter = 1
                    merchPage += 1
                    merchNumlines = 0
                End If

                rowMERCH = dst.Tables("MERCH").NewRow
                rowMERCH.Item("PAGE") = merchPage
                rowMERCH.Item("ORDR_NO") = ORDR_NO
                rowMERCH.Item("ORDR_LNO") = rowSOTORDR2.Item("ORDR_LNO")
                rowMERCH.Item("STYLE_CODE") = rowSOTORDR2.Item("STYLE_CODE")
                rowMERCH.Item("COLOR_CODE") = rowSOTORDR2.Item("COLOR_CODE")
                rowMERCH.Item("CUST_SKU") = rowSOTORDR2.Item("CUST_SKU")
                rowMERCH.Item("CUST_UPC") = rowSOTORDR2.Item("CUST_UPC")
                rowMERCH.Item("ORDR_QTY_SHIP") = rowSOTORDR2.Item("ORDR_QTY_SHIP")

                Dim EDI_DTL_SEQ As Int16 = Val(rowSOTORDR2.Item("EDI_DTL_SEQ") & String.Empty)
                Dim rowEDT850T2 As DataRow = dst.Tables("EDT850T2").Rows.Find(New Object() {EDI_DOC_SEQ_NO, EDI_DTL_SEQ})
                If rowEDT850T2 IsNot Nothing Then
                    rowMERCH.Item("EDI_ITEM_DESC") = rowEDT850T2.Item("EDI_ITEM_DESC")
                Else
                    rowMERCH.Item("EDI_ITEM_DESC") = rowSOTORDR2.Item("ITEM_DESC")
                End If

                dst.Tables("MERCH").Rows.Add(rowMERCH)

                ' Allow for fixed space an 2 lines for an Item description
                If (rowMERCH.Item("EDI_ITEM_DESC") & String.Empty).ToString.Length > 50 Then
                    merchNumlines += 1
                End If

                returnsCounter += 1
                If returnsCounter > 4 Then
                    returnsCounter = 1
                    returnsPage += 1
                End If

                rowRETURNS = dst.Tables("RETURNS").NewRow
                rowRETURNS.Item("PAGE") = returnsPage
                rowRETURNS.Item("ORDR_NO") = ORDR_NO
                rowRETURNS.Item("ORDR_LNO") = rowSOTORDR2.Item("ORDR_LNO")
                rowRETURNS.Item("STYLE_CODE") = rowSOTORDR2.Item("STYLE_CODE")
                rowRETURNS.Item("COLOR_CODE") = rowSOTORDR2.Item("COLOR_CODE")
                rowRETURNS.Item("CUST_SKU") = rowSOTORDR2.Item("CUST_SKU")
                rowRETURNS.Item("CUST_UPC") = rowSOTORDR2.Item("CUST_UPC")
                rowRETURNS.Item("ORDR_QTY_SHIP") = rowSOTORDR2.Item("ORDR_QTY_SHIP")

                If rowEDT850T2 IsNot Nothing Then
                    rowRETURNS.Item("EDI_ITEM_DESC") = rowEDT850T2.Item("EDI_ITEM_DESC")
                Else
                    rowRETURNS.Item("EDI_ITEM_DESC") = rowSOTORDR2.Item("ITEM_DESC")
                End If

                dst.Tables("RETURNS").Rows.Add(rowRETURNS)
            Next

            Dim pages As Int16 = Val(dst.Tables("MERCH").Compute("MAX(PAGE)", "") & String.Empty)
            For ictr As Int16 = 1 To pages
                Dim rowHD As DataRow = dst.Tables("HD").NewRow
                rowHD.Item("PAGE") = ictr
                rowHD.Item("ORDR_NO") = ORDR_NO
                rowHD.Item("EDI_PO_RELEASE_NO") = rowEDT850T1.Item("EDI_PO_RELEASE_NO")
                rowHD.Item("EDI_PO_NO") = rowEDT850T1.Item("EDI_PO_NO")
                rowHD.Item("ORDR_DATE") = rowSOTORDR1.Item("ORDR_DATE")
                rowHD.Item("EDI_SHIPPER") = rowEDT850T1.Item("EDI_SHIPPER")
                rowHD.Item("HEADER_MESSAGE") = rowEDT850T1.Item("HEADER_MESSAGE")

                rowHD.Item("CUST_NAME") = rowSOTORDR5.Item("CUST_NAME")
                rowHD.Item("CUST_ADDR1") = rowSOTORDR5.Item("CUST_ADDR1")
                rowHD.Item("CUST_ADDR2") = rowSOTORDR5.Item("CUST_ADDR2")
                rowHD.Item("CUST_ADDR3") = rowSOTORDR5.Item("CUST_ADDR3")
                rowHD.Item("CUST_CITY") = rowSOTORDR5.Item("CUST_CITY")
                rowHD.Item("CUST_STATE") = rowSOTORDR5.Item("CUST_STATE")
                rowHD.Item("CUST_ZIP_CODE") = rowSOTORDR5.Item("CUST_ZIP_CODE")
                rowHD.Item("CUST_COUNTRY") = rowSOTORDR5.Item("CUST_COUNTRY")
                rowHD.Item("CUST_PHONE") = rowSOTORDR5.Item("CUST_PHONE")
                rowHD.Item("DISPLAY_RETURNS_SECTION") = "0"
                dst.Tables("HD").Rows.Add(rowHD)
            Next

            For Each rowRETURNS In dst.Tables("RETURNS").Select("")
                rowRETURNS.Item("PAGE") = pages
            Next

            dst.Tables("HD").Select("PAGE = " & pages)(0).Item("DISPLAY_RETURNS_SECTION") = "1"

            For Each row As DataRow In dst.Tables("HD").Select("", "PAGE")
                Dim PAGE As Int16 = row.Item("PAGE")
                If dst.Tables("MERCH").Select("PAGE = " & PAGE).Length = 0 Then
                    dst.Tables("MERCH").Rows.Add(New Object() {PAGE, ORDR_NO, 1})
                End If
                If dst.Tables("RETURNS").Select("PAGE = " & PAGE).Length = 0 Then
                    dst.Tables("RETURNS").Rows.Add(New Object() {PAGE, ORDR_NO, 1})
                End If
            Next

            Print_Report_Begin()
            CR_params.Add("SUBT", "")
            Dim RPT As String = "SORPICKH"
            Generate_Report(RPT, "Home Depot Pack Slip", String.Empty, String.Empty, "RPT", String.Empty, False)

            If ASCMAIN1.Running_in_VS AndAlso MessageBox.Show("Do you want to display the Pack Slip?", "Home Depot Pack Slip", MessageBoxButtons.YesNo, MessageBoxIcon.Question, MessageBoxDefaultButton.Button2) = Windows.Forms.DialogResult.Yes Then
                Print_Report_End()
            ElseIf LaserPrinterName.Length = 0 AndAlso LaserPrinterIpAddress.Length = 0 Then
                Print_Report_End()
            Else
                Print_Report_End(True, False, LaserPrinterName, , LaserPrinterIpAddress)
            End If

            ' Set the invoice as printed
            Try
                For Each row As DataRow In dst.Tables("SOTINVH1").Rows
                    ASCMAIN1.sql = "Update SOTINVH1 Set INV_PRINTED = SYSDATE where INV_NO = '" & row.Item("INV_NO") & "' AND INV_PRINTED IS NULL"
                    ASCDATA1.ExecuteSQL(ASCMAIN1.sql)
                Next
            Catch ex As Exception

            End Try
        Catch ex As Exception
            MessageBox.Show("Error generating Home Depot Pack Slip: " & ex.Message, "", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            ASCMAIN1.Progress(String.Empty, String.Empty)
        End Try
    End Sub

