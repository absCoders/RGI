                Sort_grdColumns(grdSOTSHIPX, IIf(BillOfLadingMode, "BILL_OF_LADING_NO", "SHIP_BOL_NO"))

                Sql = " SELECT SOTSHIP1.SHIP_BOL_NO, SOTORDR0.CUST_CODE, SUM(SOTORDR2.ORDR_UNIT_PRICE * SOTPICK2.PICK_QTY) SHIP_VALUE"
                Sql &= " FROM SOTSHIP1, SOTPICK1, SOTPICK2, SOTORDR2, SOTORDR0"
                Sql &= " WHERE SOTSHIP1.SHIP_BOL_NO = SOTPICK1.SHIP_BOL_NO"
                Sql &= " AND SOTPICK1.PICK_NO = SOTPICK2.PICK_NO"
                Sql &= " AND SOTPICK2.ORDR_NO = SOTORDR2.ORDR_NO"
                Sql &= " AND SOTPICK2.ORDR_LNO = SOTORDR2.ORDR_LNO"
                Sql &= " AND SOTSHIP1.ORDR_GROUP_NO = SOTORDR0.ORDR_GROUP_NO"
                Sql &= " AND SOTSHIP1.SHIP_BOL_NO IN (SELECT SHIP_BOL_NO FROM (" & ASCMAIN1.sql & "))"
                Sql &= " GROUP BY SOTSHIP1.SHIP_BOL_NO, SOTORDR0.CUST_CODE"

                If ASCMAIN1.CLIENT <> "VAN" Then
                    tbl = ASCDATA1.GetDataTable(Sql)
                End If

                ASCMAIN1.sql = "SELECT * FROM SOTPICK1" _
                    & " WHERE SHIP_BOL_NO IN (SELECT SHIP_BOL_NO FROM (" & ASCMAIN1.sql & "))"
                Fill_Records("SOTPICK1_X", "", , ASCMAIN1.sql)

            End If
        End If

        ' Clear out SHIP_DATE_SHIPPED if the shipment is not finalized
        For Each row As DataRow In dst.Tables("SOTSHIPX").Select("SHIP_STATUS <> 'F'")
            row.Item("SHIP_DATE_SHIPPED") = DBNull.Value
        Next
        dst.Tables("SOTSHIPX").AcceptChanges()

