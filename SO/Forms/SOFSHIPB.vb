    Private Sub txtItemUPC_KeyPress(sender As Object, e As KeyPressEventArgs) Handles txtItemUPC.KeyPress

        If Not e.KeyChar = Microsoft.VisualBasic.ChrW(Keys.Return) Then
            Exit Sub
        End If

        Try
            e.Handled = True
            Dim sku As String = txtItemUPC.Text
            sku = sku.Trim
            If sku.Length = 0 Then
                Exit Sub
            End If

            If dst.Tables("ICTSTYC1").Select("UPC_CODE = '" & sku & "'").Length = 0 Then
                MessageBox.Show("Unable to determine the Style / Color for UPC Code " & sku, "Scan UPC", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            Dim rowICTSTYC1 As DataRow = dst.Tables("ICTSTYC1").Select("UPC_CODE = '" & sku & "'")(0)
            Dim STYLE_CODE As String = rowICTSTYC1.Item("STYLE_CODE") & String.Empty
            Dim COLOR_CODE As String = rowICTSTYC1.Item("COLOR_CODE") & String.Empty

            If dst.Tables("SOTPICK2").Select("STYLE_CODE = '" & STYLE_CODE & "' AND COLOR_CODE = '" & COLOR_CODE & "'").Length = 0 Then
                MessageBox.Show("The scanned item does not appear on this order.", "Scan UPC", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            LoadStyleImage(STYLE_CODE, COLOR_CODE)

            If dst.Tables("SOTPICK2").Select("STYLE_CODE = '" & STYLE_CODE & "' AND COLOR_CODE = '" & COLOR_CODE & "' AND ISNULL(PICK_QTY_CONF, 0) < PICK_QTY").Length = 0 Then
                MessageBox.Show("The scanned item has been fully scanned.", "Scan UPC", MessageBoxButtons.OK, MessageBoxIcon.Error)
                Exit Sub
            End If

            Dim PICK_NO As String = String.Empty
            Dim PICK_LNO As Int16 = 0

            ' Getting rowSOTPICK2 this way was not updating the row. 
            Dim rowSOTPICK2 As DataRow = dst.Tables("SOTPICK2").Select("STYLE_CODE = '" & STYLE_CODE & "' AND COLOR_CODE = '" & COLOR_CODE & "' AND ISNULL(PICK_QTY_CONF, 0) < PICK_QTY")(0)
            PICK_NO = rowSOTPICK2.Item("PICK_NO")
            rowSOTPICK2.Item("PICK_QTY_CONF") = Val(rowSOTPICK2.Item("PICK_QTY_CONF") & String.Empty) + 1
            rowSOTPICK2.Item("PICK_QTY_CANC") = rowSOTPICK2.Item("PICK_QTY") - rowSOTPICK2.Item("PICK_QTY_CONF")

            'Create the carton
            Dim rowICTSTYLD As DataRow = dst.Tables("ICTSTYLD").Rows.Find(New Object() {STYLE_CODE, "CTN"})

            ' For Ecommerce assume an inner
            If isEcommProcessing Then
                rowICTSTYLD = dst.Tables("ICTSTYLD").Rows.Find(New Object() {STYLE_CODE, "INR"})
                If rowICTSTYLD Is Nothing Then
                    rowICTSTYLD = dst.Tables("ICTSTYLD").Rows.Find(New Object() {STYLE_CODE, "CTN"})
                End If
            End If

            Dim LENGTH As Decimal = 0
            Dim WIDTH As Decimal = 0
            Dim HEIGHT As Decimal = 0
            Dim WEIGHT As Decimal = 0

            If rowICTSTYLD IsNot Nothing Then
                LENGTH = Val(rowICTSTYLD.Item("LENGTH") & String.Empty)
                WIDTH = Val(rowICTSTYLD.Item("WIDTH") & String.Empty)
                HEIGHT = Val(rowICTSTYLD.Item("HEIGHT") & String.Empty)
                WEIGHT = Val(rowICTSTYLD.Item("WEIGHT") & String.Empty)
            End If

            Dim PKG_CODE As String = defaultPKG_CODE
            Dim rowECTSTYL1 As DataRow = dst.Tables("ECTSTYL1").Rows.Find(New Object() {STYLE_CODE})
            If rowECTSTYL1 IsNot Nothing Then
                PKG_CODE = rowECTSTYL1.Item("PKG_CODE") & String.Empty

                If PKG_CODE.Length = 0 Then
                    PKG_CODE = defaultPKG_CODE
                End If

                If PKG_CODE.Length > 0 Then
                    Dim rowWHTPKGM1 As DataRow = dst.Tables("WHTPKGM1").Rows.Find(New Object() {PKG_CODE})
                    If rowWHTPKGM1 Is Nothing Then
                        PKG_CODE = String.Empty
                    Else
                        LENGTH = Val(rowWHTPKGM1.Item("PKG_L") & String.Empty)
                        WIDTH = Val(rowWHTPKGM1.Item("PKG_W") & String.Empty)
                        HEIGHT = Val(rowWHTPKGM1.Item("PKG_H") & String.Empty)
                        'WEIGHT = Val(rowWHTPKGM1.Item("WEIGHT") & String.Empty)
                    End If
                End If
            End If

            ' This creates SOTCART1
            Dim CART_NO As String = AddCarton(PICK_NO, HEIGHT, WIDTH, LENGTH, WEIGHT, PKG_CODE)

            ' Need to create SOTCART2
            Dim rowSOTCART2 As DataRow = dst.Tables("SOTCART2").NewRow
            rowSOTCART2.Item("CART_NO") = CART_NO
            rowSOTCART2.Item("CART_LNO") = 1

            ' need to get attributes from pick ticket

            rowSOTCART2.Item("ORDR_NO") = rowSOTPICK2.Item("ORDR_NO")
            rowSOTCART2.Item("ORDR_LNO") = rowSOTPICK2.Item("ORDR_LNO")
            rowSOTCART2.Item("QTY_PACKED") = 1
            'rowSOTCART2.Item("UPC_CODE") = rowEDT945T2.Item("UPC_CODE")
            'rowSOTCART2.Item("SKU_NO") = rowEDT945T2.Item("EDI_SKU")
            rowSOTCART2.Item("STYLE_CODE") = STYLE_CODE
            rowSOTCART2.Item("COLOR_CODE") = COLOR_CODE
            'rowSOTCART2.Item("SIZE_DESC") = ""
            'rowSOTCART2.Item("STYLE_PREPACK") = ""

            ' Fields added to the table
            rowSOTCART2.Item("QTY_PACKED_ORIG") = rowSOTCART2.Item("QTY_PACKED")
            rowSOTCART2.Item("PICK_NO") = PICK_NO
            dst.Tables("SOTCART2").Rows.Add(rowSOTCART2)

            SetupCartonProduct()

        Catch ex As Exception
            MessageBox.Show("Error Creating Item's carton: " & ex.Message, "Create Carton", MessageBoxButtons.OK, MessageBoxIcon.Error)
        Finally
            txtItemUPC.Clear()
            txtItemUPC.Focus()
        End Try

    End Sub

