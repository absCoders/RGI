    Private Function RequestFedExReturnLabel(ByVal ReturnLabelShipViaCode As String) As Boolean

        If 1 = 1 Then
            Return True
        End If

        RequestFedExReturnLabel = True
        Dim ShippingLabelFileDirectory As String = ASCMAIN1.Folders("Temp")
        If Not ShippingLabelFileDirectory.EndsWith("\") Then
            ShippingLabelFileDirectory &= "\"
        End If

        Dim shippinglabels As New List(Of String)
        Try

            ' Validate the shipment is shipping Fedex.
            Dim rowSOTSVIA1 As DataRow = dst.Tables("SOTSVIA1").Rows.Find(ReturnLabelShipViaCode)

            If rowSOTSVIA1 Is Nothing Then
                Return False
            End If

            Dim CARRIER_CODE As String = rowSOTSVIA1.Item("CARRIER_CODE") & String.Empty
            If CARRIER_CODE.Length = 0 Then
                Return False
            End If

            Dim rowSOTCARR1 As DataRow = dst.Tables("SOTCARR1").Rows.Find(CARRIER_CODE)
            If rowSOTCARR1 Is Nothing Then
                Return False
            End If

            If rowSOTSVIA1.Item("CARRIER_PROD_CODE") & String.Empty = String.Empty Then
                Return False
            End If

            Dim CARRIER_PROD_CODE As String = rowSOTSVIA1.Item("CARRIER_PROD_CODE") & String.Empty

            If rowSOTCARR1.Item("PROVIDER_TYPE") & String.Empty <> "F" Then
                Return False
            End If

            Dim rowSOTCARR3 As DataRow = Nothing
            If dst.Tables("SOTCARR3").Select("CARRIER_CODE = '" & CARRIER_CODE & "'").Length > 0 Then
                rowSOTCARR3 = dst.Tables("SOTCARR3").Select("CARRIER_CODE = '" & CARRIER_CODE & "'")(0)
            End If

            If rowSOTCARR3 Is Nothing Then
                Return False
            End If

            For Each rowSOTCART1 As DataRow In dst.Tables("SOTCART1").Select("", "CART_SEQ")

                shippinglabels.Clear()
                Dim ReturnLabelRequestDetail As New TAC.SHCFDXCR.ReturnLabelRequestDetail
                With ReturnLabelRequestDetail

                    .ShippingPackages = New List(Of SHCFDXCR.Package)
                    .ServiceType = Val(CARRIER_PROD_CODE)


                    Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(rowSOTCART1.Item("PICK_NO") & String.Empty)

                    Dim ShippingPackage As New SHCFDXCR.Package

                    With ShippingPackage
                        .AdditionalHandling = False
                        .Description = "Home Goods"
                        .Height = Val(rowSOTCART1.Item("PKG_H") & String.Empty)
                        .InsuredValue = 0
                        .LargePackage = False
                        .Length = Val(rowSOTCART1.Item("PKG_L") & String.Empty)

                        .ShippingLabelFile = ShippingLabelFileDirectory & Guid.NewGuid.ToString.Replace("-", "") & ".txt"
                        shippinglabels.Add(.ShippingLabelFile)

                        .Weight = Val(rowSOTCART1.Item("CART_TOTAL_WGT_ACTUAL") & String.Empty)
                        If .Weight < 1 Then
                            .Weight = 1
                        End If
                        .Width = Val(rowSOTCART1.Item("PKG_W") & String.Empty)

                        .Reference = "CR:" & rowSOTCART1.Item("PICK_NO") & ";"
                        .Reference &= "DN:" & rowSOTCART1.Item("CART_NO") & ";"
                        .Reference &= "RMA:" & rowSOTPICK1.Item("SHIP_BOL_NO") & ";"
                    End With

                    .ShippingPackages.Add(ShippingPackage)

                    Dim rowSOTSHIPB As DataRow = dst.Tables("SOTSHIPB").Rows(0)
                    With .Recipient
                        .Address1 = rowSOTSHIPB.Item("SHIP_TO_ADDR1") & String.Empty
                        .Address2 = rowSOTSHIPB.Item("SHIP_TO_ADDR2") & String.Empty
                        .Address3 = rowSOTSHIPB.Item("SHIP_TO_ADDR3") & String.Empty
                        .City = rowSOTSHIPB.Item("SHIP_TO_CITY") & String.Empty
                        .Company = String.Empty
                        .Country = rowSOTSHIPB.Item("SHIP_TO_COUNTRY") & String.Empty
                        If .Country.Length = 0 Then
                            .Country = "US"
                        End If
                        .isResidental = True
                        .Name = rowSOTSHIPB.Item("SHIP_TO_NAME") & String.Empty
                        .Phone = rowSOTSHIPB.Item("SHIP_TO_PHONE") & String.Empty
                        .State = rowSOTSHIPB.Item("SHIP_TO_STATE") & String.Empty
                        .ZipCode = rowSOTSHIPB.Item("SHIP_TO_ZIP_CODE") & String.Empty
                        .Company = .Name
                    End With

                    Dim rowICTWHSE1 As DataRow = LookUp("ICTWHSE1", dst.Tables("SOTSHIP1").Rows(0).Item("WHSE_CODE") & String.Empty)
                    If rowICTWHSE1 Is Nothing Then
                        Return False
                    End If

                    With .Shipper
                        .Address1 = rowICTWHSE1.Item("WHSE_ADDR1") & String.Empty
                        .Address2 = rowICTWHSE1.Item("WHSE_ADDR2") & String.Empty
                        .Address3 = rowICTWHSE1.Item("WHSE_ADDR3") & String.Empty
                        .City = rowICTWHSE1.Item("WHSE_CITY") & String.Empty
                        .Company = StrConv(rowICTWHSE1.Item("WHSE_DESC") & String.Empty, VbStrConv.ProperCase)
                        .isResidental = False
                        .Name = "Returns Dept"
                        .Phone = rowICTWHSE1.Item("WHSE_PHONE") & String.Empty
                        .State = rowICTWHSE1.Item("WHSE_STATE") & String.Empty
                        .ZipCode = (rowICTWHSE1.Item("WHSE_ZIP_CODE") & String.Empty).ToString.Trim
                        If .ZipCode.Length > 5 Then
                            .ZipCode = .ZipCode.Substring(0, 5)
                        End If
                        If .Country.Length = 0 Then
                            .Country = "US"
                        End If
                    End With

                    If .Recipient.Phone & String.Empty = String.Empty Then
                        .Recipient.Phone = .Shipper.Phone
                    End If

                    Dim ACCOUNT_NO_3PL As String = txt3PAccountNo.Text
                    Dim ZIP_CODE_3PL As String = txt3PZipCode.Text
                    Dim COUNTRY_3PL As String = txt3pCountry.Text

                    If chkIgnoreCredentials.Checked AndAlso (optPayor.Value = "P" OrElse optPayor.Value = "O") Then
                        ACCOUNT_NO_3PL = String.Empty
                        ZIP_CODE_3PL = String.Empty
                        COUNTRY_3PL = String.Empty
                    End If

                    If ACCOUNT_NO_3PL.Length > 0 AndAlso ZIP_CODE_3PL.Length > 0 AndAlso COUNTRY_3PL.Length > 0 Then
                        With .Payor
                            .AccountNumber = ACCOUNT_NO_3PL
                            .AccountZipCode = ZIP_CODE_3PL
                            .CountryCode = COUNTRY_3PL
                            .PayorType = TPayorTypes.ptThirdParty
                        End With
                    End If

                    Dim Credentials As New TAC.SHCFDXCR.Credentials

                    If rowSOTCARR3 IsNot Nothing AndAlso rowSOTCARR1 IsNot Nothing Then
                        With Credentials
                            .AccessKey = rowSOTCARR3.Item("ACCESSLICENSENUMBER") & String.Empty
                            .AccountNumber = rowSOTCARR3.Item("CARRIER_ACCOUNT_NO") & String.Empty
                            .AddressVaildationAccessLicenseNumber = rowSOTCARR3.Item("ADDR_VALID_LICENSE") & String.Empty
                            .FedexDeveloperKey = rowSOTCARR3.Item("ACCESSLICENSENUMBER") & String.Empty
                            .FedexMeterNumber = rowSOTCARR3.Item("METER_NUMBER") & String.Empty
                            .LabelImageType = UpsshipLabelImageTypes.uitEPL
                            .Password = rowSOTCARR3.Item("SHIPPER_PASSWORD") & String.Empty
                            .Server = rowSOTCARR1.Item("CARRIER_REMOTE_HOST_IP") & String.Empty
                            .UserId = rowSOTCARR3.Item("SHIPPER_ID") & String.Empty
                        End With
                    Else
                        MessageBox.Show("Cannot determine the FedEx Credentials for the Return Label.", "Return Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Exit Function
                    End If

                    Dim clsSHCFDXCR As New TAC.SHCFDXCR(Credentials)
                    Dim response As TAC.SHCFDXCR.Response = clsSHCFDXCR.RequestReturnLabel(ReturnLabelRequestDetail)
                    If response Is Nothing Then
                        If clsSHCFDXCR.LastError.Length > 0 Then
                            MessageBox.Show(clsSHCFDXCR.LastError, "FedEx Return Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        Else
                            MessageBox.Show("Error Requesting Return Label", "FedEx Return Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                        End If
                        Exit Function
                    End If

                    ' Need to Print Label 
                    For Each returnShippingLabel As String In shippinglabels
                        If My.Computer.FileSystem.FileExists(returnShippingLabel) Then

                            ' DFCT0010522
                            Dim vLabelPrinter As ASCPRINT = New ASCPRINT(ASCMAIN1.LabelPrinterSerialPort)
                            Dim label As String = String.Empty

                            Using sr As New System.IO.StreamReader(returnShippingLabel)
                                label = sr.ReadToEnd
                                sr.Close()
                            End Using

                            PrintLabel(label)
                            'vLabelPrinter.SendStringToPrinter(ASCMAIN1.LabelPrinterName, label)

                            My.Computer.FileSystem.DeleteFile(returnShippingLabel)

                        Else
                            RequestFedExReturnLabel = False
                            MessageBox.Show("Cannot locate the FedEx Return Label File Location : " & returnShippingLabel, "Return Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
                            Exit Function
                        End If
                    Next

                End With
            Next

        Catch ex As Exception
            RequestFedExReturnLabel = False
            MessageBox.Show(ex.Message, "FedEx Return Label", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try
    End Function

    Private Sub EcomShortShip()
        Try

            If Not isEcommProcessing Then
                Exit Sub
            End If

            If dst.Tables("SOTPICK2").Select("ISNULL(PICK_QTY_CANC, 0) > 0 OR ISNULL(PICK_QTY_BACK, 0) > 0 ").Length = 0 Then
                Exit Sub
            End If

            Dim noteMessage As String = String.Empty
            Dim lstPickNo As New List(Of String)

            noteMessage = "The following Ecommerce Sales Order(s) were short shipped." & Environment.NewLine & Environment.NewLine

            For Each rowSOTPICK2 As DataRow In dst.Tables("SOTPICK2").Select("ISNULL(PICK_QTY_CANC, 0) > 0 OR ISNULL(PICK_QTY_BACK, 0) > 0 ")
                Dim PICK_NO As String = rowSOTPICK2.Item("PICK_NO") & String.Empty
                If lstPickNo.Contains(PICK_NO) Then
                    Continue For
                End If

                lstPickNo.Add(PICK_NO)
                Dim rowSOTPICK1 As DataRow = dst.Tables("SOTPICK1").Rows.Find(PICK_NO)
                Dim ORDR_NO As String = rowSOTPICK1.Item("ORDR_NO") & String.Empty
                Dim rowSOTORDR1 As DataRow = dst.Tables("SOTORDR1").Rows.Find(ORDR_NO)

                noteMessage &= "Customer: " & rowSOTORDR1.Item("CUST_CODE") & " " & rowSOTORDR1.Item("CUST_NAME") & Environment.NewLine
                noteMessage &= "PO: " & rowSOTORDR1.Item("ORDR_CUST_PO") & String.Empty & Environment.NewLine
                noteMessage &= "Order No: " & rowSOTORDR1.Item("ORDR_NO") & String.Empty & Environment.NewLine
                noteMessage &= "Items: " & Environment.NewLine

                For Each rowSOTPICK2X As DataRow In dst.Tables("SOTPICK2").Select("PICK_NO = '" & PICK_NO & "' AND (ISNULL(PICK_QTY_CANC, 0) > 0 OR ISNULL(PICK_QTY_BACK, 0) > 0)")
                    Dim ORDR_LNO As Int16 = Val(rowSOTPICK2X.Item("ORDR_LNO") & String.Empty)
                    Dim rowSOTORDR2 As DataRow = dst.Tables("SOTORDR2").Rows.Find(New Object() {ORDR_NO, ORDR_LNO})
                    noteMessage &= vbTab & "Line No: " & ORDR_LNO & Environment.NewLine
                    noteMessage &= vbTab & "Style: " & rowSOTORDR2.Item("STYLE_CODE") & String.Empty & Environment.NewLine
                    noteMessage &= vbTab & "Color: " & rowSOTORDR2.Item("COLOR_CODE") & String.Empty & Environment.NewLine
                    noteMessage &= vbTab & "Item Description: " & rowSOTORDR2.Item("STYLE_DESC") & String.Empty & Environment.NewLine
                    noteMessage &= vbTab & "Quantity Ordered: " & rowSOTORDR2.Item("ORDR_QTY") & String.Empty & Environment.NewLine
                    noteMessage &= vbTab & "Quantity Shipoed: " & rowSOTORDR2.Item("ORDR_QTY_SHIP") & String.Empty & Environment.NewLine
                    noteMessage &= Environment.NewLine & Environment.NewLine
                Next
            Next

            ASCMAIN1.Progress("Sending Ecommerce Short Ship Email")
            ' Use ASCNOTE1 to send email to office.
            Dim clsASCNOTE1 As New TAC.ASCNOTE1("ECOM_SHORT", Nothing)

            clsASCNOTE1.Note = noteMessage
            clsASCNOTE1.ReplaceEmailSubject = "Ecommerce Short Ship"
            clsASCNOTE1.CreateComponents()
            clsASCNOTE1.EmailDocument()
            ASCMAIN1.Progress(String.Empty, String.Empty)

        Catch ex As Exception
            MessageBox.Show("Error Sending Ecommerce Short Ship Email: " & ex.Message, "Ecommerce Short Ship", MessageBoxButtons.OK, MessageBoxIcon.Error)
        End Try

    End Sub

